{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Web GUI (HTTP)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-web",
      "program": "${workspaceFolder}/src/M3Undle.Web/bin/Debug/net10.0/M3Undle.Web.dll",
      "cwd": "${workspaceFolder}/src/M3Undle.Web",
      "console": "internalConsole",
      "stopAtEntry": false,
      "justMyCode": true,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://0.0.0.0:5283",
        "M3UNDLE_CONFIG_DIR": "${workspaceFolder}/.config",
        "M3UNDLE_DATA_DIR": "${workspaceFolder}/data"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+https?://\\S+:([0-9]+)",
        "uriFormat": "http://localhost:%s/"
      }
    },
    {
      "name": "Containers: Debug Web GUI (Docker, existing image)",
      "type": "docker",
      "request": "launch",
      "preLaunchTask": "docker-run: existing-image",
      "postDebugTask": "docker-stop: m3undle-debug",
      "platform": "netCore",
      "netCore": {
        "appProject": "${workspaceFolder}/src/M3Undle.Web/M3Undle.Web.csproj",
        "justMyCode": true
      },
      "dockerServerReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+https?://\\S+:8080\\b",
        "uriFormat": "http://localhost:8080/"
      }
    },
    {
      "name": "Containers: Debug Web GUI (Docker, force rebuild)",
      "type": "docker",
      "request": "launch",
      "preLaunchTask": "docker-run: force-debug",
      "postDebugTask": "docker-stop: m3undle-debug",
      "platform": "netCore",
      "netCore": {
        "appProject": "${workspaceFolder}/src/M3Undle.Web/M3Undle.Web.csproj",
        "justMyCode": true
      },
      "dockerServerReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+https?://\\S+:8080\\b",
        "uriFormat": "http://localhost:8080/"
      }
    }
  ]
}
