@using M3Undle.Web.Application
@using M3Undle.Web.Data.Entities
@inject IEventService EventService

<MudDrawer Open="@Open" OpenChanged="HandleOpenChangedAsync" Anchor="Anchor.End" Variant="DrawerVariant.Persistent" Width="380px"
           Style="height: calc(100vh - 28px); overflow: hidden;">
    <MudDrawerHeader Style="padding: 12px 8px 12px 16px;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Style="width:100%;">
            <MudText Typo="Typo.h6">System Events</MudText>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                @if (_events.Count > 0)
                {
                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                               OnClick="ClearAllAsync">Clear all</MudButton>
                }
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                               Color="Color.Default" OnClick="CloseAsync" />
            </MudStack>
        </MudStack>
    </MudDrawerHeader>

    <MudDivider />

    <div style="overflow-y: auto; flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column;">
        @if (_loading)
        {
            <div class="pa-4">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            </div>
        }
        else if (_events.Count == 0)
        {
            <div style="display:flex; flex-direction:column; align-items:center; justify-content:flex-start; flex: 1 1 auto; min-height: 0; padding:32px; opacity:0.45;">
                <MudIcon Icon="@Icons.Material.Outlined.NotificationsNone" Style="font-size:64px;" />
                <MudText Typo="Typo.body1" Style="margin-top:12px;">No system events</MudText>
            </div>
        }
        else
        {
            @foreach (var item in _eventItems)
            {
                var evt = item.Event;
                <div style="border-bottom: 1px solid var(--mud-palette-divider); padding: 12px 16px;">
                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                        <MudIcon Icon="@SeverityIcon(evt.Severity)" Color="@SeverityColor(evt.Severity)"
                                 Size="Size.Small" Style="margin-top:2px; flex-shrink:0;" />
                        <div style="flex:1; min-width:0;">
                            <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Style="min-width:0;">
                                    <MudText Typo="Typo.body2" Style="font-weight:600;">@evt.Title</MudText>
                                    @if (item.TotalOccurrences > 1)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@SeverityColor(evt.Severity)"
                                                 Style="height:22px; flex-shrink:0;">
                                            @($"{item.TotalOccurrences} times")
                                        </MudChip>
                                    }
                                </MudStack>
                                <MudTooltip Text="Dismiss" Placement="Placement.Left">
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                   Color="Color.Default" Style="margin:-4px -4px 0 4px; flex-shrink:0;"
                                                   OnClick="() => DismissAsync(item.EventIds)" />
                                </MudTooltip>
                            </MudStack>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @item.RelativeTime
                            </MudText>
                            @if (!string.IsNullOrWhiteSpace(evt.Detail))
                            {
                                <MudText Typo="Typo.caption" Style="margin-top:4px; display:block; word-break:break-word;">
                                    @evt.Detail
                                </MudText>
                            }
                        </div>
                    </MudStack>
                </div>
            }
        }
    </div>
</MudDrawer>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public EventCallback OnCountChanged { get; set; }

    private List<SystemEvent> _events = [];
    private IReadOnlyList<SystemEventPanelItem> _eventItems = [];
    private bool _loading;

    protected override async Task OnParametersSetAsync()
    {
        if (Open)
            await LoadAsync();
    }

    private async Task HandleOpenChangedAsync(bool value)
    {
        await OpenChanged.InvokeAsync(value);
    }

    private Task CloseAsync() => OpenChanged.InvokeAsync(false);

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        _events = [.. await EventService.GetAllAsync()];
        RebuildEventItems();
        _loading = false;
        StateHasChanged();
    }

    private async Task DismissAsync(IReadOnlyList<string> ids)
    {
        foreach (var id in ids)
        {
            await EventService.DismissAsync(id);
        }

        _events.RemoveAll(e => ids.Contains(e.SystemEventId));
        RebuildEventItems();
        await OnCountChanged.InvokeAsync();
        StateHasChanged();
    }

    private async Task ClearAllAsync()
    {
        await EventService.DismissAllAsync();
        _events.Clear();
        _eventItems = [];
        await OnCountChanged.InvokeAsync();
        await CloseAsync();
        StateHasChanged();
    }

    private void RebuildEventItems()
        => _eventItems = SystemEventPanelGrouping.Group(
            _events,
            DateTime.UtcNow,
            SystemEventPanelGrouping.RelativeTime);

    private static string SeverityIcon(string severity) => severity switch
    {
        "Error" => Icons.Material.Filled.Error,
        "Warning" => Icons.Material.Filled.Warning,
        _ => Icons.Material.Filled.Info,
    };

    private static Color SeverityColor(string severity) => severity switch
    {
        "Error" => Color.Error,
        "Warning" => Color.Warning,
        _ => Color.Info,
    };
}
