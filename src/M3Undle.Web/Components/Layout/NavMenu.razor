@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using M3Undle.Web.Application
@using M3Undle.Web.Contracts
@inject ChannelStatsService StatsService
@inject IRefreshTrigger RefreshTrigger
@inject ISnackbar Snackbar
@inject ISiteSettingsService SiteSettings
@inject AppEventBus EventBus
@implements IDisposable

<MudNavMenu>
    <MudTooltip Text="Overview" Placement="Placement.Right">
        <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home" OnClick="HandleNavClick">Overview</MudNavLink>
    </MudTooltip>
    <MudTooltip Text="Providers" Placement="Placement.Right">
        <MudNavLink Href="providers" Icon="@Icons.Material.Filled.Dns" OnClick="HandleNavClick">Providers</MudNavLink>
    </MudTooltip>
    <MudTooltip Text="Channels" Placement="Placement.Right">
        <MudNavLink Href="channels" Icon="@Icons.Material.Filled.LiveTv" OnClick="HandleNavClick">Channels</MudNavLink>
    </MudTooltip>
    <MudTooltip Text="Profiles" Placement="Placement.Right">
        <MudNavLink Href="profiles" Icon="@Icons.Material.Filled.AccountTree" OnClick="HandleNavClick">Profiles</MudNavLink>
    </MudTooltip>
    <MudTooltip Text="Channel Mapping" Placement="Placement.Right">
        <MudNavLink Href="channels/mapping" Icon="@Icons.Material.Filled.FilterList" OnClick="HandleNavClick">Mapping</MudNavLink>
    </MudTooltip>
    <MudTooltip Text="@ReviewQueueTooltip" Placement="Placement.Right">
        <MudNavLink Href="channels/review" Icon="@Icons.Material.Filled.PlaylistAddCheck" OnClick="HandleNavClick">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <span>Review Queue</span>
                @if (_pendingReviewCount > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ms-1">@_pendingReviewCount</MudChip>
                }
            </MudStack>
        </MudNavLink>
    </MudTooltip>
    <MudTooltip Text="What's On" Placement="Placement.Right">
        <MudNavLink Href="channels/whats-on" Icon="@Icons.Material.Filled.Event" OnClick="HandleNavClick">What's On</MudNavLink>
    </MudTooltip>
    <MudTooltip Text="Guide / EPG" Placement="Placement.Right">
        <MudNavLink Href="epg" Icon="@Icons.Material.Filled.Tv" OnClick="HandleNavClick">EPG</MudNavLink>
    </MudTooltip>
    <MudTooltip Text="Streams" Placement="Placement.Right">
        <MudNavLink Href="streams" Icon="@Icons.Material.Filled.Sensors" OnClick="HandleNavClick">Streams</MudNavLink>
    </MudTooltip>
    <MudTooltip Text="Logs" Placement="Placement.Right">
        <MudNavLink Href="logs" Icon="@Icons.Material.Filled.Article" OnClick="HandleNavClick">Logs</MudNavLink>
    </MudTooltip>
</MudNavMenu>

<MudDivider Class="my-2" />

<MudNavMenu>
    <MudTooltip Text="@(_isRefreshing ? "Refreshing…" : "Refresh Lineup")" Placement="Placement.Right">
        <MudNavLink Icon="@Icons.Material.Filled.Refresh" OnClick="TriggerRefreshAsync" Disabled="_isRefreshing">
            @(_isRefreshing ? "Refreshing…" : "Refresh Lineup")
        </MudNavLink>
    </MudTooltip>
</MudNavMenu>

@code {
    [Parameter]
    public EventCallback OnNavigate { get; set; }

    private bool _isRefreshing;
    private bool _authEnabled;
    private int _pendingReviewCount;
    private IDisposable? _eventSubscription;
    private readonly CancellationTokenSource _cts = new();

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private string ReviewQueueTooltip => _pendingReviewCount > 0
        ? $"Review Queue ({_pendingReviewCount} pending)"
        : "Review Queue";

    protected override Task OnInitializedAsync()
    {
        var reader = EventBus.Subscribe(out _eventSubscription);
        _ = ListenForEventsAsync(reader, _cts.Token);

        _ = InitializeAsync();
        return Task.CompletedTask;
    }

    private async Task InitializeAsync()
    {
        try
        {
            _authEnabled = await SiteSettings.GetAuthenticationEnabledAsync();

            if (await CanAccessApiAsync())
                await LoadStatsAsync();

            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
    }

    private async Task<bool> CanAccessApiAsync()
    {
        if (!_authEnabled)
            return true;
        if (AuthStateTask is null)
            return false;
        var state = await AuthStateTask;
        return state.User.Identity?.IsAuthenticated == true;
    }

    private async Task ListenForEventsAsync(System.Threading.Channels.ChannelReader<AppEvent> reader, CancellationToken ct)
    {
        try
        {
            await foreach (var evt in reader.ReadAllAsync(ct))
            {
                if (evt.Kind == AppEventKind.RefreshCompleted || evt.Kind == AppEventKind.GroupFiltersChanged)
                    await InvokeAsync(LoadStatsAsync);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadStatsAsync()
    {
        try
        {
            var stats = await StatsService.GetStatsAsync(_cts.Token);
            _pendingReviewCount = (stats?.GroupsNew ?? 0) + (stats?.PendingChannelsNotified ?? 0);
            StateHasChanged();
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        _eventSubscription?.Dispose();
    }

    private Task HandleNavClick(MouseEventArgs _)
    {
        if (OnNavigate.HasDelegate)
        {
            return OnNavigate.InvokeAsync();
        }

        return Task.CompletedTask;
    }

    private async Task TriggerRefreshAsync()
    {
        if (_isRefreshing) return;

        _isRefreshing = true;
        StateHasChanged();

        try
        {
            if (RefreshTrigger.TriggerRefresh())
            {
                Snackbar.Add("Refresh triggered — status will update when complete.", Severity.Success);
            }
            else
            {
                Snackbar.Add("A refresh is already in progress.", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to trigger refresh: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isRefreshing = false;
            StateHasChanged();
        }
    }

}
