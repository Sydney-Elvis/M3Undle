@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using M3Undle.Web.Application
@using M3Undle.Web.Contracts
@inject ChannelStatsService StatsService
@inject IRefreshTrigger RefreshTrigger
@inject ISnackbar Snackbar
@inject ISiteSettingsService SiteSettings
@inject AppEventBus EventBus
@inject ILogger<NavMenu> Logger
@implements IDisposable

<MudNavMenu Color="Color.Primary">
    <MudTooltip Inline="false" Text="Overview" Placement="Placement.Right">
        <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Overview</MudNavLink>
    </MudTooltip>
    <MudTooltip Inline="false" Text="Providers" Placement="Placement.Right">
        <MudNavLink Href="providers" Icon="@Icons.Material.Filled.Dns">Providers</MudNavLink>
    </MudTooltip>
    <MudTooltip Inline="false" Text="Channels" Placement="Placement.Right">
        <MudNavLink Href="channels" Icon="@Icons.Material.Filled.LiveTv">Channels</MudNavLink>
    </MudTooltip>
    <MudTooltip Inline="false" Text="Profiles" Placement="Placement.Right">
        <MudNavLink Href="profiles" Icon="@Icons.Material.Filled.AccountTree">Profiles</MudNavLink>
    </MudTooltip>
    <MudTooltip Inline="false" Text="Channel Mapping" Placement="Placement.Right">
        <MudNavLink Href="channels/mapping" Icon="@Icons.Material.Filled.FilterList">Mapping</MudNavLink>
    </MudTooltip>
    <MudTooltip Inline="false" Text="@ReviewQueueTooltip" Placement="Placement.Right">
        <MudNavLink Href="channels/review" Icon="@Icons.Material.Filled.PlaylistAddCheck">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <span>Review Queue</span>
                @if (_pendingReviewCount > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ms-1">@_pendingReviewCount</MudChip>
                }
            </MudStack>
        </MudNavLink>
    </MudTooltip>
    <MudTooltip Inline="false" Text="What's On" Placement="Placement.Right">
        <MudNavLink Href="channels/whats-on" Icon="@Icons.Material.Filled.Event">What's On</MudNavLink>
    </MudTooltip>
    <MudTooltip Inline="false" Text="Guide / EPG" Placement="Placement.Right">
        <MudNavLink Href="epg" Icon="@Icons.Material.Filled.Tv">EPG</MudNavLink>
    </MudTooltip>
    <MudTooltip Inline="false" Text="HDHomeRun" Placement="Placement.Right">
        <MudNavLink Href="hdhr" Icon="@Icons.Material.Filled.Router">HDHomeRun</MudNavLink>
    </MudTooltip>
    <MudTooltip Inline="false" Text="Streams" Placement="Placement.Right">
        <MudNavLink Href="streams" Icon="@Icons.Material.Filled.Sensors">Streams</MudNavLink>
    </MudTooltip>
    <MudTooltip Inline="false" Text="Logs" Placement="Placement.Right">
        <MudNavLink Href="logs" Icon="@Icons.Material.Filled.Article">Logs</MudNavLink>
    </MudTooltip>
</MudNavMenu>

<MudDivider Class="my-2" />

<MudNavMenu>
    <MudTooltip Inline="false" Text="@(_isRefreshing ? "Refreshing…" : "Refresh Lineup")" Placement="Placement.Right">
        <MudNavLink Icon="@Icons.Material.Filled.Refresh" OnClick="TriggerRefreshAsync" Disabled="_isRefreshing">
            @(_isRefreshing ? "Refreshing…" : "Refresh Lineup")
        </MudNavLink>
    </MudTooltip>
    @if (_statsDelayed)
    {
        <MudTooltip Inline="false" Text="Review queue counts are temporarily delayed." Placement="Placement.Right">
            <MudNavLink Icon="@Icons.Material.Filled.Schedule" Disabled="true">
                Review count delayed
            </MudNavLink>
        </MudTooltip>
    }
</MudNavMenu>

@code {
    private static readonly TimeSpan UiQueryTimeout = TimeSpan.FromSeconds(3);

    [Parameter]
    public EventCallback OnNavigate { get; set; }

    private bool _isRefreshing;
    private bool _authEnabled;
    private int _pendingReviewCount;
    private bool _statsDelayed;
    private IDisposable? _eventSubscription;
    private readonly CancellationTokenSource _cts = new();

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private string ReviewQueueTooltip => _pendingReviewCount > 0
        ? $"Review Queue ({_pendingReviewCount} pending)"
        : "Review Queue";

    protected override Task OnInitializedAsync()
    {
        var reader = EventBus.Subscribe(out _eventSubscription);
        _ = ListenForEventsAsync(reader, _cts.Token);

        _ = InitializeAsync();
        return Task.CompletedTask;
    }

    private async Task InitializeAsync()
    {
        try
        {
            _authEnabled = await SiteSettings.GetAuthenticationEnabledAsync();

            if (await CanAccessApiAsync())
                await LoadStatsAsync();

            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
    }

    private async Task<bool> CanAccessApiAsync()
    {
        if (!_authEnabled)
            return true;
        if (AuthStateTask is null)
            return false;
        var state = await AuthStateTask;
        return state.User.Identity?.IsAuthenticated == true;
    }

    private async Task ListenForEventsAsync(System.Threading.Channels.ChannelReader<AppEvent> reader, CancellationToken ct)
    {
        try
        {
            await foreach (var evt in reader.ReadAllAsync(ct))
            {
                if (evt.Kind == AppEventKind.RefreshCompleted || evt.Kind == AppEventKind.GroupFiltersChanged)
                    await InvokeAsync(LoadStatsAsync);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadStatsAsync()
    {
        try
        {
            using var timeoutCts = CancellationTokenSource.CreateLinkedTokenSource(_cts.Token);
            timeoutCts.CancelAfter(UiQueryTimeout);
            var stats = await StatsService.GetStatsAsync(timeoutCts.Token);
            _pendingReviewCount = (stats?.GroupsNew ?? 0) + (stats?.PendingChannelsNotified ?? 0);
            _statsDelayed = false;
            StateHasChanged();
        }
        catch (OperationCanceledException) when (!_cts.IsCancellationRequested)
        {
            _statsDelayed = true;
            Logger.LogWarning("Timed out loading nav menu review queue stats.");
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        _eventSubscription?.Dispose();
    }

    private async Task TriggerRefreshAsync()
    {
        if (_isRefreshing) return;

        _isRefreshing = true;
        StateHasChanged();

        try
        {
            if (RefreshTrigger.TriggerRefresh())
            {
                Snackbar.Add("Refresh triggered — status will update when complete.", Severity.Success);
            }
            else
            {
                Snackbar.Add("A refresh is already in progress.", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to trigger refresh: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isRefreshing = false;
            StateHasChanged();
        }
    }

}
