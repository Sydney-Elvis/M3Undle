<MudDivider Class="my-1" />
<MudText Typo="Typo.caption" Color="Color.Secondary">Stream Format</MudText>
<MudSwitch Value="ForceMpegTs" ValueChanged="ForceMpegTsChanged"
           Color="Color.Warning" Label="Force MPEG-TS" Disabled="Disabled" />
<MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-n2 mb-2">
    @if (IsXtream)
    {
        <text>Disables HLS delivery to clients and instructs the Xtream server to serve MPEG-TS output.
        Enable only if streams stutter or your player handles TS containers better than HLS segments.</text>
    }
    else
    {
        <text>Requests MPEG-TS transport from the provider instead of HLS. Playlist URLs containing
        <code>output=m3u8</code> are automatically rewritten to <code>output=ts</code>, and HLS delivery
        to clients is disabled for this provider. Enable only if streams stutter or your player handles
        TS containers better than HLS segments.</text>
    }
</MudText>
<MudSwitch Value="CleanRelayRemux" ValueChanged="CleanRelayRemuxChanged"
           Color="Color.Warning" Label="Clean relay remux" Disabled="Disabled" />
<MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-n2">
    Passes live streams through FFmpeg to repair broken timestamps and malformed packets before
    forwarding to clients. Fixes playback stalls caused by corrupted stream data, at the cost
    of added CPU usage and ~1–2 s of startup latency per stream.
</MudText>

@code {
    [Parameter] public bool ForceMpegTs { get; set; }
    [Parameter] public EventCallback<bool> ForceMpegTsChanged { get; set; }
    [Parameter] public bool CleanRelayRemux { get; set; }
    [Parameter] public EventCallback<bool> CleanRelayRemuxChanged { get; set; }
    [Parameter] public bool IsXtream { get; set; }
    [Parameter] public bool Disabled { get; set; }
}
