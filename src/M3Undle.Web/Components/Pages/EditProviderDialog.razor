@using M3Undle.Web.Contracts.Providers
@using M3Undle.Web.Components.ProviderForms
@inject M3Undle.Web.Application.ProviderPageService ProviderPageService

<MudDialog Style="min-width:620px">
    <DialogContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-3">
            <MudChip T="string" Size="Size.Small" Color="@(Provider.IsXtreamProvider ? Color.Secondary : Color.Default)"
                     Icon="@(Provider.IsXtreamProvider ? Icons.Material.Filled.Tv : Icons.Material.Filled.Link)">
                @(Provider.IsXtreamProvider ? "Xtream Codes" : "URL / File")
            </MudChip>
        </MudStack>

        @if (!Provider.IsXtreamProvider && Provider.XtreamDetectedCapable)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.body2">
                        <strong>Xtream API detected.</strong> Upgrade to use Xtream mode for richer channel data, stable stream IDs, and subscription expiry tracking.
                    </MudText>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-1">
                        <MudSwitch @bind-Value="_upgradeIncludeXmltv" Color="Color.Primary" Label="Include XMLTV guide" Disabled="@(_isUpgrading || !_encryptionAvailable)" />
                        <MudSpacer />
                        <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small"
                                   Disabled="@(_isUpgrading || !_encryptionAvailable)"
                                   OnClick="UpgradeToXtreamAsync">
                            @(_isUpgrading ? "Upgrading..." : "Upgrade to Xtream")
                        </MudButton>
                    </MudStack>
                    @if (!_encryptionAvailable)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Warning">M3UNDLE_ENCRYPTION_KEY must be configured to upgrade to Xtream mode.</MudText>
                    }
                    @if (!string.IsNullOrWhiteSpace(_upgradeError))
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Text" Class="mt-1">@_upgradeError</MudAlert>
                    }
                </MudStack>
            </MudAlert>
        }

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3">@_error</MudAlert>
        }

        <MudForm @ref="_form">
            <MudStack Spacing="2">
                <MudTextField Label="Name" @bind-Value="_model.Name" Required="true" RequiredError="Name is required." />

                @if (Provider.IsXtreamProvider)
                {
                    <MudTextField Label="Server URL" @bind-Value="_model.XtreamBaseUrl"
                                  Required="true" RequiredError="Server URL is required."
                                  HelperText="e.g. http://yourserver.com:8080" />
                    <MudTextField Label="Username" @bind-Value="_model.XtreamUsername"
                                  Required="true" RequiredError="Username is required." />

                    @if (!string.IsNullOrWhiteSpace(_passwordError))
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">@_passwordError</MudAlert>
                    }
                    @if (!string.IsNullOrWhiteSpace(_passwordSuccess))
                    {
                        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true">@_passwordSuccess</MudAlert>
                    }
                    @if (!_editingPassword)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudTextField T="string" Value="@("••••••••")" Label="Password"
                                          ReadOnly="true" Style="flex:1" />
                            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                       Disabled="!_encryptionAvailable"
                                       OnClick="StartPasswordEdit">Change</MudButton>
                        </MudStack>
                        @if (!_encryptionAvailable)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning" Class="mt-n2">
                                M3UNDLE_ENCRYPTION_KEY must be configured to change the password.
                            </MudText>
                        }
                    }
                    else
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudTextField @bind-Value="_newPassword" Label="New Password"
                                          InputType="InputType.Password" Style="flex:1"
                                          Disabled="_isChangingPassword" />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       Disabled="@(_isChangingPassword || string.IsNullOrWhiteSpace(_newPassword))"
                                       OnClick="ChangePasswordAsync">
                                @(_isChangingPassword ? "Saving..." : "Save")
                            </MudButton>
                            <MudButton Variant="Variant.Text" Size="Size.Small"
                                       Disabled="_isChangingPassword"
                                       OnClick="CancelPasswordEdit">Cancel</MudButton>
                        </MudStack>
                    }

                    <MudSwitch @bind-Value="_model.XtreamIncludeXmltv" Color="Color.Primary"
                               Label="Include XMLTV guide from same server" />
                }
                else
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudTextField Label="Playlist URL" @bind-Value="_model.PlaylistUrl"
                                      Required="true" RequiredError="A playlist URL is required."
                                      HelperText="http/https URL, or file:///path/to/file.m3u. Use %VAR_NAME% for credentials in .env."
                                      Style="flex:1" />
                        <MudTooltip Text="@_urlHelperText" Placement="Placement.Left">
                            <MudIconButton Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Info" />
                        </MudTooltip>
                    </MudStack>
                    <MudTextField Label="XMLTV URL (optional)" @bind-Value="_model.XmltvUrl" />
                }

                <MudSelect T="string" Label="Associated Profile"
                           Value="_model.ProfileId" ValueChanged="HandleProfileChanged"
                           ToStringFunc="@(id => string.IsNullOrEmpty(id) || id == NewProfileSentinel
                               ? "(None)"
                               : _localProfiles.FirstOrDefault(p => p.ProfileId == id)?.Name ?? id)">
                    <MudSelectItem T="string" Value="@string.Empty">(None)</MudSelectItem>
                    @foreach (var profile in AvailableProfiles)
                    {
                        <MudSelectItem T="string" Value="@profile.ProfileId">@profile.Name</MudSelectItem>
                    }
                    <MudSelectItem T="string" Value="@NewProfileSentinel">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                            <MudText>New Profile...</MudText>
                        </MudStack>
                    </MudSelectItem>
                </MudSelect>

                @if (_showCreateProfile)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudTextField Label="New Profile Name" @bind-Value="_newProfileName" Style="flex:1"
                                      Disabled="_isCreatingProfile" />
                        <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success"
                                       OnClick="CreateProfileAsync" Disabled="_isCreatingProfile" />
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                       OnClick="CancelCreateProfile" Disabled="_isCreatingProfile" />
                    </MudStack>
                }

                <ProviderContentToggles @bind-IncludeVod="_model.IncludeVod"
                                        @bind-IncludeSeries="_model.IncludeSeries" />

                <ProviderConcurrentStreams @bind-LimitConcurrentStreams="_model.LimitConcurrentStreams"
                                           @bind-ConcurrentStreamLimit="_model.ConcurrentStreamLimit" />

                <MudSwitch @bind-Value="_model.Enabled" Color="Color.Success" Label="Enabled" />

                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Default" Class="mt-1"
                           StartIcon="@(_showAdvanced ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                           OnClick="@(() => _showAdvanced = !_showAdvanced)">
                    Advanced options
                </MudButton>
                <MudCollapse Expanded="_showAdvanced">
                    <MudStack Spacing="2" Class="mt-1">
                        @if (!Provider.IsXtreamProvider)
                        {
                            <MudTextField Label="User Agent (optional)" @bind-Value="_model.UserAgent"
                                          HelperText="Custom User-Agent sent when fetching the playlist and streams. Leave blank to use the M3Undle default." />
                            <MudTextField Label="Headers JSON (optional)" @bind-Value="_model.HeadersJson" Lines="2"
                                          HelperText='Extra HTTP headers included with every request to this provider, e.g. {"X-Custom-Header":"value"}' />
                        }
                        <MudNumericField T="int" Label="Timeout (seconds)" @bind-Value="_model.TimeoutSeconds" Min="1" Max="1800"
                                         HelperText="How long to wait for the provider to respond before giving up. 120 s is suitable for most providers." />
                        <ProviderStreamFormat @bind-ForceMpegTs="_model.ForceMpegTs"
                                              @bind-CleanRelayRemux="_model.CleanRelayRemux"
                                              IsXtream="Provider.IsXtreamProvider" />
                    </MudStack>
                </MudCollapse>
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="_isSaving">Cancel</MudButton>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_isSaving" OnClick="SaveAsync">
            @(_isSaving ? "Saving..." : "Save Changes")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ProviderDto Provider { get; set; } = default!;
    [Parameter] public List<ProfileListItemDto> Profiles { get; set; } = [];
    [Parameter] public List<ProviderDto> Providers { get; set; } = [];
    [Parameter] public EventCallback OnSaved { get; set; }

    private const string NewProfileSentinel = "__new_profile__";

    private MudForm? _form;
    private bool _isSaving;
    private bool _isChangingPassword;
    private bool _editingPassword;
    private bool _isUpgrading;
    private bool _showAdvanced;
    private string? _error;
    private string? _passwordError;
    private string? _passwordSuccess;
    private string? _upgradeError;
    private bool _upgradeIncludeXmltv;
    private bool _encryptionAvailable;

    private List<ProfileListItemDto> _localProfiles = [];
    private bool _showCreateProfile;
    private string _newProfileName = string.Empty;
    private bool _isCreatingProfile;
    private string _newPassword = string.Empty;

    private EditModel _model = new();

    private const string _urlHelperText =
        "Enter an http/https URL, or file:///path/to/file.m3u for a server-side file.\n\n" +
        "To keep credentials out of the database, place them in .env in M3UNDLE_CONFIG_DIR " +
        "and reference with %VAR_NAME% syntax.\n\nExample: http://server:8080/get.php?password=%MY_PASS%";

    protected override async Task OnInitializedAsync()
    {
        _localProfiles = [.. Profiles];

        _model = Provider.IsXtreamProvider
            ? new EditModel
            {
                Name = Provider.Name,
                XtreamBaseUrl = Provider.XtreamBaseUrl ?? string.Empty,
                XtreamUsername = Provider.XtreamUsername ?? string.Empty,
                XtreamIncludeXmltv = Provider.XtreamIncludeXmltv,
                Enabled = Provider.Enabled,
                TimeoutSeconds = Provider.TimeoutSeconds,
                LimitConcurrentStreams = Provider.MaxConcurrentStreams.HasValue,
                ConcurrentStreamLimit = Provider.MaxConcurrentStreams ?? 1,
                IncludeVod = Provider.IncludeVod,
                IncludeSeries = Provider.IncludeSeries,
                ForceMpegTs = Provider.ForceMpegTs,
                CleanRelayRemux = string.Equals(Provider.CleanRelayMode, "remux", StringComparison.OrdinalIgnoreCase),
                ProfileId = Provider.AssociatedProfileIds.FirstOrDefault() ?? string.Empty,
            }
            : new EditModel
            {
                Name = Provider.Name,
                PlaylistUrl = Provider.PlaylistUrl,
                XmltvUrl = Provider.XmltvUrl,
                UserAgent = Provider.UserAgent,
                HeadersJson = Provider.HeadersJson,
                Enabled = Provider.Enabled,
                TimeoutSeconds = Provider.TimeoutSeconds,
                LimitConcurrentStreams = Provider.MaxConcurrentStreams.HasValue,
                ConcurrentStreamLimit = Provider.MaxConcurrentStreams ?? 1,
                IncludeVod = Provider.IncludeVod,
                IncludeSeries = Provider.IncludeSeries,
                ForceMpegTs = Provider.ForceMpegTs,
                CleanRelayRemux = string.Equals(Provider.CleanRelayMode, "remux", StringComparison.OrdinalIgnoreCase),
                ProfileId = Provider.AssociatedProfileIds.FirstOrDefault() ?? string.Empty,
            };

        if (Provider.IsXtreamProvider || Provider.XtreamDetectedCapable)
        {
            try { _encryptionAvailable = await ProviderPageService.GetEncryptionAvailableAsync(); }
            catch { _encryptionAvailable = false; }
        }
    }

    private IEnumerable<ProfileListItemDto> AvailableProfiles => _localProfiles.Where(p =>
        p.ProfileId == _model.ProfileId ||
        !Providers.Any(prov =>
            prov.ProviderId != Provider.ProviderId &&
            prov.AssociatedProfileIds.Contains(p.ProfileId)));

    private async Task UpgradeToXtreamAsync()
    {
        _upgradeError = null;
        _isUpgrading = true;
        try
        {
            var (_, error) = await ProviderPageService.UpgradeProviderToXtreamAsync(
                Provider.ProviderId,
                new UpgradeToXtreamRequest { XtreamIncludeXmltv = _upgradeIncludeXmltv },
                CancellationToken.None);
            if (!string.IsNullOrWhiteSpace(error)) { _upgradeError = error; return; }
            await OnSaved.InvokeAsync();
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { _upgradeError = $"Upgrade failed: {ex.Message}"; }
        finally { _isUpgrading = false; }
    }

    private void Cancel() => MudDialog.Cancel();

    private void HandleProfileChanged(string value)
    {
        if (value == NewProfileSentinel)
        {
            _newProfileName = string.Empty;
            _showCreateProfile = true;
        }
        else
        {
            _model.ProfileId = value;
            _showCreateProfile = false;
        }
    }

    private void CancelCreateProfile()
    {
        _showCreateProfile = false;
        _newProfileName = string.Empty;
    }

    private async Task CreateProfileAsync()
    {
        if (string.IsNullOrWhiteSpace(_newProfileName)) return;
        _isCreatingProfile = true;
        _error = null;
        try
        {
            var result = await ProviderPageService.CreateProfileAsync(_newProfileName.Trim(), CancellationToken.None);
            if (!string.IsNullOrWhiteSpace(result.Error)) { _error = result.Error; return; }
            var created = result.Profile;
            if (created is not null) { _localProfiles.Add(created); _model.ProfileId = created.ProfileId; }
            _showCreateProfile = false;
            _newProfileName = string.Empty;
        }
        catch (Exception ex) { _error = $"Failed to create profile: {ex.Message}"; }
        finally { _isCreatingProfile = false; }
    }

    private void StartPasswordEdit()
    {
        _newPassword = string.Empty;
        _passwordError = null;
        _passwordSuccess = null;
        _editingPassword = true;
    }

    private void CancelPasswordEdit()
    {
        _newPassword = string.Empty;
        _passwordError = null;
        _editingPassword = false;
    }

    private async Task ChangePasswordAsync()
    {
        _passwordError = null;
        _passwordSuccess = null;
        _isChangingPassword = true;
        try
        {
            var error = await ProviderPageService.UpdateXtreamPasswordAsync(Provider.ProviderId, _newPassword, CancellationToken.None);
            if (!string.IsNullOrWhiteSpace(error)) { _passwordError = error; return; }
            _passwordSuccess = "Password updated.";
            _newPassword = string.Empty;
            _editingPassword = false;
        }
        catch (Exception ex) { _passwordError = $"Failed to update password: {ex.Message}"; }
        finally { _isChangingPassword = false; }
    }

    private async Task SaveAsync()
    {
        _error = null;
        _isSaving = true;
        try
        {
            if (_form is not null) { await _form.ValidateAsync(); if (!_form.IsValid) return; }

            var profileIds = string.IsNullOrWhiteSpace(_model.ProfileId) ? null : new List<string> { _model.ProfileId };

            UpdateProviderRequest request;
            if (Provider.IsXtreamProvider)
            {
                request = new UpdateProviderRequest
                {
                    Name = _model.Name.Trim(),
                    XtreamBaseUrl = _model.XtreamBaseUrl,
                    XtreamUsername = _model.XtreamUsername,
                    XtreamIncludeXmltv = _model.XtreamIncludeXmltv,
                    Enabled = _model.Enabled,
                    TimeoutSeconds = _model.TimeoutSeconds,
                    MaxConcurrentStreams = _model.LimitConcurrentStreams ? _model.ConcurrentStreamLimit : null,
                    IncludeVod = _model.IncludeVod,
                    IncludeSeries = _model.IncludeSeries,
                    ForceMpegTs = _model.ForceMpegTs,
                    CleanRelayMode = _model.CleanRelayRemux ? "remux" : "off",
                    AssociateToProfileIds = profileIds,
                };
            }
            else
            {
                request = new UpdateProviderRequest
                {
                    Name = _model.Name.Trim(),
                    PlaylistUrl = _model.PlaylistUrl,
                    XmltvUrl = NullIfEmpty(_model.XmltvUrl),
                    UserAgent = NullIfEmpty(_model.UserAgent),
                    HeadersJson = NullIfEmpty(_model.HeadersJson),
                    Enabled = _model.Enabled,
                    TimeoutSeconds = _model.TimeoutSeconds,
                    MaxConcurrentStreams = _model.LimitConcurrentStreams ? _model.ConcurrentStreamLimit : null,
                    IncludeVod = _model.IncludeVod,
                    IncludeSeries = _model.IncludeSeries,
                    ForceMpegTs = _model.ForceMpegTs,
                    CleanRelayMode = _model.CleanRelayRemux ? "remux" : "off",
                    AssociateToProfileIds = profileIds,
                };
            }

            var error = await ProviderPageService.UpdateProviderAsync(Provider.ProviderId, request, CancellationToken.None);
            if (!string.IsNullOrWhiteSpace(error)) { _error = error; return; }

            await OnSaved.InvokeAsync();
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { _error = $"Failed to save provider: {ex.Message}"; }
        finally { _isSaving = false; }
    }

    private static string? NullIfEmpty(string? v) => string.IsNullOrWhiteSpace(v) ? null : v.Trim();

    private sealed class EditModel
    {
        public string Name { get; set; } = string.Empty;
        public string? PlaylistUrl { get; set; }
        public string? XmltvUrl { get; set; }
        public string? UserAgent { get; set; }
        public string? HeadersJson { get; set; }
        public string XtreamBaseUrl { get; set; } = string.Empty;
        public string XtreamUsername { get; set; } = string.Empty;
        public bool XtreamIncludeXmltv { get; set; }
        public bool Enabled { get; set; } = true;
        public int TimeoutSeconds { get; set; } = 120;
        public bool LimitConcurrentStreams { get; set; }
        public int ConcurrentStreamLimit { get; set; } = 1;
        public bool IncludeVod { get; set; }
        public bool IncludeSeries { get; set; }
        public bool ForceMpegTs { get; set; }
        public bool CleanRelayRemux { get; set; }
        public string ProfileId { get; set; } = string.Empty;
    }
}
