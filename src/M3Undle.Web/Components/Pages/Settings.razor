    private async Task DeleteIntegrationAsync(DownstreamIntegrationDto integration)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Integration",
            $"Remove '{integration.Name}'? This cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true) return;

        var error = await DownstreamIntegrations.DeleteAsync(integration.DownstreamIntegrationId, CancellationToken.None);
        if (error is not null)
            await DialogService.ShowMessageBoxAsync("Error", error);
        else
            await LoadIntegrationsAsync();
    }

    private async Task LoadProfilesAsync()
    {
        try
        {
            var data = await ProviderPageService.GetPageDataAsync(CancellationToken.None);
            _profiles = data.Profiles;
            ResolveActiveProfileName();
        }
        catch { }
    }

    private void ResolveActiveProfileName()
    {
        if (string.IsNullOrWhiteSpace(_activeProfileId))
        {
            _activeProfileName = null;
            return;
        }
        _activeProfileName = _profiles.FirstOrDefault(p => p.ProfileId == _activeProfileId)?.Name;
    }

    private async Task LoadRefreshScheduleAsync()
    {
        _loadingRefreshSettings = true;
        _refreshError = null;
        try
        {
            var settings = await RefreshSchedule.GetSettingsAsync(CancellationToken.None);
            _refreshScheduleKind = settings.ScheduleKind;
            _refreshStartupCatchup = settings.StartupCatchup;
            var activeSettings = await RefreshSchedule.GetActiveProfileSettingsAsync(CancellationToken.None);
            _nextRefreshUtc = activeSettings is not null
                ? await RefreshSchedule.GetNextScheduledRefreshUtcAsync(activeSettings.ProfileId!, CancellationToken.None)
                : null;
        }
        catch (Exception ex)
        {
            _refreshError = $"Failed to load refresh settings: {ex.Message}";
        }
        finally
        {
            _loadingRefreshSettings = false;
        }
    }

    private async Task SaveRefreshScheduleAsync()
    {
        _savingRefreshSettings = true;
        _refreshError = null;
        _refreshSuccess = null;
        try
        {
            var (succeeded, error) = await RefreshSchedule.UpdateAsync(
                new RefreshScheduleSettings(_refreshScheduleKind, _refreshStartupCatchup), CancellationToken.None);

            if (!succeeded)
            {
                _refreshError = error ?? "Failed to save refresh settings.";
                return;
            }

            var savedActiveSettings = await RefreshSchedule.GetActiveProfileSettingsAsync(CancellationToken.None);
            _nextRefreshUtc = savedActiveSettings is not null
                ? await RefreshSchedule.GetNextScheduledRefreshUtcAsync(savedActiveSettings.ProfileId!, CancellationToken.None)
                : null;
            _refreshSuccess = "Refresh settings saved.";
        }
        catch (Exception ex)
        {
            _refreshError = $"Failed to save refresh settings: {ex.Message}";
        }
        finally
        {
            _savingRefreshSettings = false;
        }
    }

