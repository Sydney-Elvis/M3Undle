@page "/epg"
@using M3Undle.Web.Application
@using M3Undle.Web.Contracts.Epg
@using M3Undle.Web.Contracts.Providers
@inject EpgPageService EpgPageService
@inject IRefreshScheduleService RefreshScheduleService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AppEventBus EventBus
@inject ILogger<EpgSources> Logger
@implements IDisposable

<PageTitle>M3Undle — EPG Sources</PageTitle>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudStack Spacing="0">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudText Typo="Typo.h5">EPG Sources</MudText>
                @if (_sources.Count > 0)
                {
                    <StatusChip Label="@($"{_sources.Count} {(_sources.Count == 1 ? "source" : "sources")}")"
                                Size="Size.Small"
                                Color="Color.Primary"
                                Variant="Variant.Outlined" />
                }
                @if (_sources.Any(s => s.LastSuccessUtc.HasValue && (s.LastFailureUtc is null || s.LastSuccessUtc > s.LastFailureUtc)))
                {
                    <StatusChip Label="@($"{_sources.Count(s => s.LastSuccessUtc.HasValue && (s.LastFailureUtc is null || s.LastSuccessUtc > s.LastFailureUtc))} OK")"
                                Size="Size.Small"
                                Color="Color.Success"
                                Variant="Variant.Outlined" />
                }
                @if (_sources.Any(s => s.LastFailureUtc.HasValue && (s.LastSuccessUtc is null || s.LastFailureUtc > s.LastSuccessUtc)))
                {
                    <StatusChip Label="@($"{_sources.Count(s => s.LastFailureUtc.HasValue && (s.LastSuccessUtc is null || s.LastFailureUtc > s.LastSuccessUtc))} failed")"
                                Size="Size.Small"
                                Color="Color.Error"
                                Variant="Variant.Outlined" />
                }
            </MudStack>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Manage guide data sources and channel mappings per provider.
            </MudText>
            @if (_nextRefreshUtc.HasValue)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                    Next scheduled refresh: <strong>@_nextRefreshUtc.Value.ToLocalTime().ToString("ddd d MMM, h:mm tt")</strong>
                </MudText>
            }
            else if (_refreshScheduleKind == "manual")
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">Refresh schedule: manual only</MudText>
            }
        </MudStack>
        <MudSelect T="ProviderListItemDto?" Label="Provider"
                   Value="_selectedProvider"
                   ValueChanged="OnProviderChanged"
                   ToStringFunc="@(p => p?.Name ?? "— select a provider —")"
                   Style="min-width:240px" Dense="true" Margin="Margin.Dense"
                   Variant="Variant.Outlined"
                   AnchorOrigin="Origin.BottomLeft">
            @foreach (var p in _providers)
            {
                <MudSelectItem T="ProviderListItemDto?" Value="@p">
                    @p.Name
                </MudSelectItem>
            }
        </MudSelect>
    </MudStack>
</MudPaper>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_error</MudAlert>
}

@if (_selectedProvider is null && !_isLoading)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        Select a provider above to manage its EPG sources.
    </MudAlert>
}
else
{
    <MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="1" Rounded="true" ApplyEffectsToContainer="true" Class="mb-4">

        @* ------------------------------------------------------------------ *@
        @* Tab 0 — Sources *@
        @* ------------------------------------------------------------------ *@
        <MudTabPanel Text="Sources" Icon="@Icons.Material.Filled.Subscriptions">
            <div class="pa-4">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudText Typo="Typo.h6">Guide Sources</MudText>
                    <MudStack Row="true" Spacing="1">
                        <MudTooltip Text="Reload the list of EPG sources" Arrow="true" Placement="Placement.Top">
                            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"
                                           OnClick="LoadSourcesAsync" Disabled="_isLoading" />
                        </MudTooltip>
                        <MudTooltip Text="Add a new guide data source for this provider" Arrow="true" Placement="Placement.Top">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       Disabled="@(_selectedProvider is null)"
                                       OnClick="OpenAddSourceDialogAsync">
                                Add Source
                            </MudButton>
                        </MudTooltip>
                    </MudStack>
                </MudStack>

                @if (_isLoading)
                {
                    <MudProgressCircular Indeterminate="true" />
                }
                else if (_sources.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        No EPG sources configured for this provider.
                        Click <strong>Add Source</strong> to add one.
                    </MudAlert>
                }
                else
                {
                    <MudTable Items="_sources" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh>Name</MudTh>
                            <MudTh><MudTooltip Text="How the guide data is fetched — URL (remote XMLTV), File (local XMLTV), or Provider (built-in feed)" Arrow="true" Placement="Placement.Top"><span>Kind</span></MudTooltip></MudTh>
                            <MudTh>URL / Path</MudTh>
                            <MudTh><MudTooltip Text="Lower number = higher priority. When a channel matches multiple sources, the lowest-priority-number source wins." Arrow="true" Placement="Placement.Top"><span>Priority</span></MudTooltip></MudTh>
                            <MudTh><MudTooltip Text="Result of the last fetch attempt for this source" Arrow="true" Placement="Placement.Top"><span>Status</span></MudTooltip></MudTh>
                            <MudTh><MudTooltip Text="Edit settings, run a test fetch, auto-map channels, or delete this source" Arrow="true" Placement="Placement.Top"><span>Actions</span></MudTooltip></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudStack Spacing="0">
                                    <span>@context.Name</span>
                                    @if (!context.Enabled)
                                    {
                                        <MudTooltip Text="This source is disabled — it will not be fetched or used for guide data" Arrow="true" Placement="Placement.Right">
                                            <StatusChip Label="Disabled" Size="Size.Small" Color="Color.Default" />
                                        </MudTooltip>
                                    }
                                </MudStack>
                            </MudTd>
                            <MudTd>
                                <StatusChip Label="@KindLabel(context.Kind)"
                                            Size="Size.Small"
                                            Color="@KindColor(context.Kind)"
                                            Variant="Variant.Outlined" />
                            </MudTd>
                            <MudTd>
                                <MudText Typo="Typo.caption" Style="max-width:260px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; display:block">
                                    @(context.UrlOrPath ?? "—")
                                </MudText>
                            </MudTd>
                            <MudTd>@context.Priority</MudTd>
                            <MudTd>
                                @{
                                    var isFailed = context.LastFailureUtc.HasValue &&
                                                   (context.LastSuccessUtc is null || context.LastFailureUtc > context.LastSuccessUtc);
                                }
                                @if (context.LastSuccessUtc.HasValue && !isFailed)
                                {
                                    <TooltipChip Label="OK"
                                                 TooltipText="@($"Last success: {context.LastSuccessUtc:u}")"
                                                 Color="Color.Success"
                                                 Variant="Variant.Outlined" />
                                }
                                else if (isFailed)
                                {
                                    <TooltipChip Label="Failed"
                                                 TooltipText="@FailedTooltip(context)"
                                                 Color="Color.Error"
                                                 Variant="Variant.Outlined"
                                                 Placement="Placement.Left" />
                                }
                                else
                                {
                                    <MudTooltip Text="This source has never been successfully fetched — run a test or wait for the next scheduled refresh" Arrow="true" Placement="Placement.Left">
                                        <StatusChip Label="Never fetched"
                                                    Size="Size.Small"
                                                    Color="Color.Default"
                                                    Variant="Variant.Outlined" />
                                    </MudTooltip>
                                }
                            </MudTd>
                            <MudTd>
                                <MudStack Row="true" Spacing="1">
                                    <MudTooltip Text="Edit this source's settings" Arrow="true" Placement="Placement.Top">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary"
                                                       Size="Size.Small" OnClick="() => OpenEditSourceDialogAsync(context)" />
                                    </MudTooltip>
                                    <MudTooltip Text="Test: fetch and parse this source now" Arrow="true" Placement="Placement.Top">
                                        <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Color="Color.Secondary"
                                                       Size="Size.Small" Disabled="@IsTestRunning(context.EpgSourceId)"
                                                       OnClick="() => TestSourceAsync(context)" />
                                    </MudTooltip>
                                    <MudTooltip Text="Auto-map unmatched channels using this source" Arrow="true" Placement="Placement.Top">
                                        <MudIconButton Icon="@Icons.Material.Filled.AutoFixHigh" Color="Color.Info"
                                                       Size="Size.Small"
                                                       OnClick="() => AutoMapSourceAsync(context)" />
                                    </MudTooltip>
                                    <MudTooltip Text="Delete this source and all its fetch history and channel mappings" Arrow="true" Placement="Placement.Top">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                                       Size="Size.Small" OnClick="() => DeleteSourceAsync(context)" />
                                    </MudTooltip>
                                </MudStack>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }

                @if (_testResult is not null)
                {
                    <MudPaper Class="pa-3 mt-3" Elevation="0" Outlined="true">
                        <MudStack Spacing="1">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@(_testResult.Success ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Error)"
                                         Color="@(_testResult.Success ? Color.Success : Color.Error)" Size="Size.Small" />
                                <MudText Typo="Typo.subtitle2">Test Result — @_testingSourceName</MudText>
                                <MudSpacer />
                                <MudTooltip Text="Dismiss test result" Arrow="true">
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="() => _testResult = null" />
                                </MudTooltip>
                            </MudStack>
                            @if (_testResult.Success)
                            {
                                <MudText Typo="Typo.body2">
                                    @_testResult.ChannelCount channels · @_testResult.ProgrammeCount programmes ·
                                    @FormatBytes(_testResult.Bytes) · @_testResult.ElapsedMs ms
                                </MudText>
                                @if (_testResult.EarliestProgramme.HasValue)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        Coverage: @_testResult.EarliestProgramme.Value.ToString("MMM d") – @_testResult.LatestProgramme!.Value.ToString("MMM d")
                                    </MudText>
                                }
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Color="Color.Error">@_testResult.Error</MudText>
                            }
                        </MudStack>
                    </MudPaper>
                }
            </div>
        </MudTabPanel>

        @* ------------------------------------------------------------------ *@
        @* Tab 1 — Mappings *@
        @* ------------------------------------------------------------------ *@
        <MudTabPanel Text="Channel Mappings" Icon="@Icons.Material.Filled.CompareArrows">
            <div class="pa-4">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6">Channel Mappings</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Shows how each channel is matched to a guide source. Click Edit to override.
                        </MudText>
                    </MudStack>
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudSelect T="ProfileListItemDto?" Label="Profile"
                                   Value="_selectedProfile"
                                   ValueChanged="OnProfileChanged"
                                   ToStringFunc="@(p => p?.Name ?? "— select —")"
                                   Style="min-width:180px" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomLeft">
                            @foreach (var p in _mappingProfiles)
                            {
                                <MudSelectItem T="ProfileListItemDto?" Value="@p">@p.Name</MudSelectItem>
                            }
                        </MudSelect>
                        <MudTooltip Text="Reload channel mappings for this profile" Arrow="true" Placement="Placement.Top">
                            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"
                                           OnClick="LoadMappingsAsync" Disabled="@(_selectedProfile is null || _isMappingsLoading)" />
                        </MudTooltip>
                    </MudStack>
                </MudStack>

                @if (_selectedProfile is null)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        Select a profile above to view channel mappings.
                    </MudAlert>
                }
                else if (_isMappingsLoading)
                {
                    <MudProgressCircular Indeterminate="true" />
                }
                else
                {
                    <MudStack Row="true" Spacing="2" Class="mb-2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                        <MudTextField T="string" @bind-Value="_mappingSearch" Placeholder="Filter channels…"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(!string.IsNullOrEmpty(_mappingSearch) ? Icons.Material.Filled.Clear : Icons.Material.Filled.Search)"
                                      OnAdornmentClick="() => _mappingSearch = string.Empty"
                                      Immediate="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                                      Style="max-width:280px" />
                        @{
                            var allCount = _mappings.Count;
                            var mappedCount = _mappings.Count(m => !string.IsNullOrEmpty(m.EpgChannelMappingId));
                            var unmappedCount = _mappings.Count(m => string.IsNullOrEmpty(m.EpgChannelMappingId));
                            var manualCount = _mappings.Count(m => m.MappingMode == "manual");
                        }
                        <ChipFilterToggle Label="@($"{allCount} total")"
                                          Color="Color.Primary"
                                          IsActive="@(_mappingFilter == "all")"
                                          TooltipText="Show all channels."
                                          OnClick="@((_) => SetMappingFilter("all"))" />
                        <ChipFilterToggle Label="@($"{mappedCount} mapped")"
                                          Color="Color.Success"
                                          IsActive="@(_mappingFilter == "mapped")"
                                          TooltipText="Show channels with an EPG mapping."
                                          OnClick="@((_) => SetMappingFilter("mapped"))" />
                        <ChipFilterToggle Label="@($"{unmappedCount} unmapped")"
                                          Color="Color.Warning"
                                          IsActive="@(_mappingFilter == "unmapped")"
                                          TooltipText="Show channels missing an EPG mapping."
                                          OnClick="@((_) => SetMappingFilter("unmapped"))" />
                        @if (manualCount > 0)
                        {
                            <ChipFilterToggle Label="@($"{manualCount} manual")"
                                              Color="Color.Info"
                                              IsActive="@(_mappingFilter == "manual")"
                                              TooltipText="Show channels manually overridden."
                                              OnClick="@((_) => SetMappingFilter("manual"))" />
                        }
                    </MudStack>

                    var filteredMappings = FilterMappings(_mappings);

                    @if (filteredMappings.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No channels match the current filter.</MudAlert>
                    }
                    else
                    {
                        <MudTable Items="filteredMappings" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm">
                            <HeaderContent>
                                <MudTh>Channel</MudTh>
                                <MudTh><MudTooltip Text="The tvg-id attribute from the provider M3U — used for automatic ID-based EPG matching" Arrow="true" Placement="Placement.Top"><span>tvg-id</span></MudTooltip></MudTh>
                                <MudTh>EPG Source</MudTh>
                                <MudTh>EPG Channel</MudTh>
                                <MudTh><MudTooltip Text="How the EPG match was established: Manual (you chose it), Auto by ID/Name/Fuzzy (automatic), or Unmapped (no match found)" Arrow="true" Placement="Placement.Top"><span>Mode</span></MudTooltip></MudTh>
                                <MudTh><MudTooltip Text="Override the mapping manually, or remove the current mapping" Arrow="true" Placement="Placement.Top"><span>Actions</span></MudTooltip></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.ProviderChannelDisplayName</MudTd>
                                <MudTd>
                                    <MudText Typo="Typo.caption">@(context.ProviderChannelTvgId ?? "—")</MudText>
                                </MudTd>
                                <MudTd>@(string.IsNullOrEmpty(context.EpgSourceName) ? "—" : context.EpgSourceName)</MudTd>
                                <MudTd>
                                    <MudText Typo="Typo.caption">@(string.IsNullOrEmpty(context.XmltvChannelId) ? "—" : context.XmltvChannelId)</MudText>
                                </MudTd>
                                <MudTd>
                                    <MudTooltip Text="@MappingModeTooltip(context.MappingMode)" Arrow="true" Placement="Placement.Left">
                                        <StatusChip Label="@MappingModeLabel(context.MappingMode)"
                                                    Size="Size.Small"
                                                    Color="@MappingModeColor(context.MappingMode)"
                                                    Variant="Variant.Outlined" />
                                    </MudTooltip>
                                </MudTd>
                                <MudTd>
                                    <MudStack Row="true" Spacing="1">
                                        <MudTooltip Text="Override mapping manually" Arrow="true" Placement="Placement.Left">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary"
                                                           Size="Size.Small"
                                                           OnClick="() => OpenManualMappingDialogAsync(context)" />
                                        </MudTooltip>
                                        @if (!string.IsNullOrEmpty(context.EpgChannelMappingId))
                                        {
                                            <MudTooltip Text="Remove this EPG mapping — the channel will show as Unmapped" Arrow="true" Placement="Placement.Left">
                                                <MudIconButton Icon="@Icons.Material.Filled.LinkOff" Color="Color.Error"
                                                               Size="Size.Small"
                                                               OnClick="() => DeleteMappingAsync(context)" />
                                            </MudTooltip>
                                        }
                                    </MudStack>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>

                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                            @(_mappings.Count(m => !string.IsNullOrEmpty(m.EpgChannelMappingId))) of @_mappings.Count channels mapped
                        </MudText>
                    }
                }
            </div>
        </MudTabPanel>

    </MudTabs>
}

@code {
    private readonly List<ProviderListItemDto> _providers = [];
    private readonly List<EpgSourceDto> _sources = [];
    private readonly List<EpgChannelMappingDto> _mappings = [];
    private readonly List<ProfileListItemDto> _mappingProfiles = [];

    private ProviderListItemDto? _selectedProvider;
    private ProfileListItemDto? _selectedProfile;
    private int _activeTab;
    private bool _isLoading = true;
    private bool _isMappingsLoading;
    private string? _error;
    private EpgSourceTestResult? _testResult;
    private string? _testingSourceName;
    private readonly HashSet<string> _runningTests = [];
    private string _mappingSearch = string.Empty;
    private string _mappingFilter = "all";

    private DateTime? _nextRefreshUtc;
    private string _refreshScheduleKind = "6h";

    private readonly CancellationTokenSource _cts = new();
    private IDisposable? _eventSubscription;

    protected override Task OnInitializedAsync()
    {
        _ = InitializeAsync();
        return Task.CompletedTask;
    }

    private async Task InitializeAsync()
    {
        var reader = EventBus.Subscribe(out _eventSubscription);
        _ = ListenForEventsAsync(reader, _cts.Token);
        await Task.WhenAll(LoadProvidersAsync(), LoadRefreshScheduleAsync());
    }

    private async Task LoadRefreshScheduleAsync()
    {
        try
        {
            var settings = await RefreshScheduleService.GetActiveProfileSettingsAsync(_cts.Token);
            _refreshScheduleKind = settings?.Settings.ScheduleKind ?? "manual";
            _nextRefreshUtc = settings?.ProfileId is null
                ? null
                : await RefreshScheduleService.GetNextScheduledRefreshUtcAsync(settings.ProfileId, _cts.Token);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load refresh schedule");
        }
    }

    private async Task ListenForEventsAsync(System.Threading.Channels.ChannelReader<AppEvent> reader, CancellationToken ct)
    {
        try
        {
            await foreach (var evt in reader.ReadAllAsync(ct))
            {
                if (evt.Kind == AppEventKind.RefreshCompleted && _selectedProvider is not null)
                    await InvokeAsync(LoadSourcesAsync);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadProvidersAsync()
    {
        _isLoading = true;
        try
        {
            var providers = await EpgPageService.GetProvidersAsync(_cts.Token);
            _providers.Clear();
            _providers.AddRange(providers);

            // Auto-select active provider on first load
            if (_selectedProvider is null)
            {
                var active = providers.FirstOrDefault();
                if (active is not null)
                    await OnProviderChanged(active);
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to load providers: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnProviderChanged(ProviderListItemDto? value)
    {
        if (_selectedProvider?.ProviderId == value?.ProviderId) return;
        _selectedProvider = value;
        _sources.Clear();
        _mappings.Clear();
        _mappingProfiles.Clear();
        _selectedProfile = null;
        _testResult = null;
        if (value is not null)
            await Task.WhenAll(LoadSourcesAsync(), LoadMappingsPageDataAsync());
    }

    private async Task OnProfileChanged(ProfileListItemDto? value)
    {
        if (_selectedProfile?.ProfileId == value?.ProfileId) return;
        _selectedProfile = value;
        _mappings.Clear();
        if (value is not null)
            await LoadMappingsAsync();
    }

    private async Task LoadSourcesAsync()
    {
        if (_selectedProvider is null) return;
        _isLoading = true;
        _error = null;
        try
        {
            var sources = await EpgPageService.GetSourcesAsync(_selectedProvider.ProviderId, _cts.Token);
            _sources.Clear();
            _sources.AddRange(sources);
        }
        catch (Exception ex)
        {
            _error = $"Failed to load sources: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadMappingsPageDataAsync()
    {
        if (_selectedProvider is null) return;
        try
        {
            var data = await EpgPageService.GetMappingsPageDataAsync(_selectedProvider.ProviderId, _cts.Token);
            _mappingProfiles.Clear();
            _mappingProfiles.AddRange(data.Profiles);
            if (_selectedProfile is null && data.Profiles.Count > 0)
                _selectedProfile = data.Profiles[0];
            StateHasChanged();
            if (_selectedProfile is not null)
                await LoadMappingsAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to load mapping data: {ex.Message}";
        }
    }

    private async Task LoadMappingsAsync()
    {
        if (_selectedProvider is null || _selectedProfile is null) return;
        _isMappingsLoading = true;
        StateHasChanged();
        try
        {
            var mappings = await EpgPageService.GetMappingsAsync(
                _selectedProfile.ProfileId, _selectedProvider.ProviderId, _cts.Token);
            _mappings.Clear();
            _mappings.AddRange(mappings);
        }
        catch (Exception ex)
        {
            _error = $"Failed to load mappings: {ex.Message}";
        }
        finally
        {
            _isMappingsLoading = false;
            StateHasChanged();
        }
    }

    // -------------------------------------------------------------------------
    // Source actions
    // -------------------------------------------------------------------------

    private Task OpenAddSourceDialogAsync()
    {
        var parameters = new DialogParameters<AddEditEpgSourceDialog>
        {
            { x => x.ProviderId, _selectedProvider?.ProviderId },
            { x => x.OnSaved, EventCallback.Factory.Create(this, LoadSourcesAsync) },
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true };
        return DialogService.ShowAsync<AddEditEpgSourceDialog>("Add EPG Source", parameters, options);
    }

    private Task OpenEditSourceDialogAsync(EpgSourceDto source)
    {
        var parameters = new DialogParameters<AddEditEpgSourceDialog>
        {
            { x => x.Source, source },
            { x => x.ProviderId, source.ProviderId },
            { x => x.OnSaved, EventCallback.Factory.Create(this, LoadSourcesAsync) },
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true };
        return DialogService.ShowAsync<AddEditEpgSourceDialog>($"Edit — {source.Name}", parameters, options);
    }

    private async Task TestSourceAsync(EpgSourceDto source)
    {
        _runningTests.Add(source.EpgSourceId);
        _testResult = null;
        _testingSourceName = source.Name;
        _error = null;
        StateHasChanged();

        try
        {
            _testResult = await EpgPageService.TestSourceAsync(source.EpgSourceId, _cts.Token);
            await LoadSourcesAsync();
        }
        catch (Exception ex)
        {
            _error = $"Test failed: {ex.Message}";
        }
        finally
        {
            _runningTests.Remove(source.EpgSourceId);
            StateHasChanged();
        }
    }

    private async Task AutoMapSourceAsync(EpgSourceDto source)
    {
        _error = null;
        try
        {
            var error = await EpgPageService.AutoMapAsync(source.EpgSourceId, _cts.Token);
            if (error is not null)
                Snackbar.Add(error, Severity.Warning);
            else
            {
                Snackbar.Add($"Auto-mapped channels from {source.Name}.", Severity.Success);
                if (_activeTab == 1 && _selectedProfile is not null)
                    await LoadMappingsAsync();
            }
        }
        catch (Exception ex)
        {
            _error = $"Auto-map failed: {ex.Message}";
        }
    }

    private async Task DeleteSourceAsync(EpgSourceDto source)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete EPG Source",
            $"Delete \"{source.Name}\"? All fetch history and channel mappings for this source will also be removed.",
            yesText: "Delete", cancelText: "Cancel");

        if (confirmed != true) return;

        var error = await EpgPageService.DeleteSourceAsync(source.EpgSourceId, _cts.Token);
        if (error is not null)
            _error = error;
        else
            await LoadSourcesAsync();
    }

    // -------------------------------------------------------------------------
    // Mapping actions
    // -------------------------------------------------------------------------

    private Task OpenManualMappingDialogAsync(EpgChannelMappingDto mapping)
    {
        var parameters = new DialogParameters<ManualMappingDialog>
        {
            { x => x.Mapping, mapping },
            { x => x.Sources, _sources },
            { x => x.OnSaved, EventCallback.Factory.Create(this, LoadMappingsAsync) },
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true };
        return DialogService.ShowAsync<ManualMappingDialog>($"Map — {mapping.ProviderChannelDisplayName}", parameters, options);
    }

    private async Task DeleteMappingAsync(EpgChannelMappingDto mapping)
    {
        if (string.IsNullOrEmpty(mapping.EpgChannelMappingId)) return;

        var error = await EpgPageService.DeleteMappingAsync(mapping.EpgChannelMappingId, _cts.Token);
        if (error is not null)
            _error = error;
        else
            await LoadMappingsAsync();
    }

    // -------------------------------------------------------------------------
    // Filtering / display helpers
    // -------------------------------------------------------------------------

    private void SetMappingFilter(string filter)
    {
        _mappingFilter = filter;
        StateHasChanged();
    }

    private List<EpgChannelMappingDto> FilterMappings(List<EpgChannelMappingDto> all)
    {
        var result = all.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_mappingSearch))
        {
            var s = _mappingSearch.ToLowerInvariant();
            result = result.Where(m =>
                m.ProviderChannelDisplayName.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                (m.ProviderChannelTvgId?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                m.XmltvChannelId.Contains(s, StringComparison.OrdinalIgnoreCase));
        }

        result = _mappingFilter switch
        {
            "mapped"   => result.Where(m => !string.IsNullOrEmpty(m.EpgChannelMappingId)),
            "unmapped" => result.Where(m => string.IsNullOrEmpty(m.EpgChannelMappingId)),
            "manual"   => result.Where(m => m.MappingMode == "manual"),
            _ => result,
        };

        return result.ToList();
    }

    private bool IsTestRunning(string sourceId) => _runningTests.Contains(sourceId);

