@page "/"
@using M3Undle.Web.Application
@using M3Undle.Web.Contracts
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IJsApiService JsApiService
@inject ISnackbar Snackbar
@inject AppEventBus EventBus
@inject IRefreshTrigger RefreshTrigger
@inject M3Undle.Web.Streaming.Observability.StreamingRegistry StreamingRegistry
@inject DashboardStatsService DashboardStats
@inject IRefreshScheduleService RefreshScheduleService
@implements IDisposable

<PageTitle>M3Undle</PageTitle>

@if (_loadError is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_loadError</MudAlert>
}

<MudGrid Spacing="3">
    <!-- System Status -->
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="1" Style="height: 100%;">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.h6">System Status</MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    @if (_streamSessions > 0)
                    {
                        <MudChip T="string" Color="Color.Success" Icon="@Icons.Material.Filled.FiberManualRecord"
                                 Size="Size.Small" OnClick="@(() => Nav.NavigateTo("streams"))">
                            @_streamSessions session@(_streamSessions == 1 ? "" : "s"), @_streamClients client@(_streamClients == 1 ? "" : "s")
                        </MudChip>
                    }
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="LoadAllAsync" Disabled="_isLoading" />
                </MudStack>
            </MudStack>

            @if (_isLoading)
            {
                <MudProgressCircular Indeterminate="true" />
            }
            else if (_status is null)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Status unavailable.</MudAlert>
            }
            else
            {
                <MudStack Spacing="3">
                    <div>
                        <MudChip T="string"
                                 Color="@(_status.Status == "ok" ? Color.Success : _status.Status == "degraded" ? Color.Warning : Color.Error)"
                                 Icon="@(_status.Status == "ok" ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Warning)">
                            @(_status.Status == "ok" ? "Output Active" : _status.Status == "degraded" ? "Degraded — refresh failing" : "No Published Lineup")
                        </MudChip>
                    </div>

                    <MudDivider />

                    @{ var lineup = _status.Lineup; }

                    @if (lineup?.ActiveProvider is not null)
                    {
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Serving Provider</MudText>
                            <MudText Typo="Typo.body1">@lineup.ActiveProvider.Name</MudText>
                        </MudStack>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                            No active profile — <MudLink Href="providers">add a provider</MudLink> or go to <MudLink Href="profiles">Profiles</MudLink> to set one active.
                        </MudAlert>
                    }

                    <MudStack Spacing="1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Last Refresh</MudText>
                        @if (_isRefreshing)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                                <MudText Typo="Typo.body2">Refreshing… @(!string.IsNullOrEmpty(ElapsedText) ? $"({ElapsedText} elapsed)" : "")</MudText>
                                <MudButton Size="Size.Small"
                                           Variant="Variant.Outlined"
                                           Color="Color.Error"
                                           StartIcon="@Icons.Material.Filled.Cancel"
                                           OnClick="CancelRefreshAsync"
                                           Disabled="_isCancelling">
                                    @(_isCancelling ? "Cancelling…" : "Cancel")
                                </MudButton>
                            </MudStack>
                            @if (LastRunDurationText is not null && _status?.Lineup?.LastRefresh is { } lastRun)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Last run: ~@LastRunDurationText
                                    @(lastRun.ChannelCountSeen.HasValue ? $", {lastRun.ChannelCountSeen.Value:N0} channels" : "")
                                    — please wait.
                                </MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Large providers may take several minutes.</MudText>
                            }
                        }
                        else if (lineup?.LastRefresh is not null)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(lineup.LastRefresh.Status == "ok" ? Color.Success : lineup.LastRefresh.Status == "running" ? Color.Info : Color.Error)">
                                    @lineup.LastRefresh.Status
                                </MudChip>
                                @if (lineup.LastRefresh.FinishedUtc.HasValue)
                                {
                                    <MudText Typo="Typo.body2">@lineup.LastRefresh.FinishedUtc.Value.ToString("u")</MudText>
                                }
                            </MudStack>
                            @if (lineup.LastRefresh.ChannelCountSeen.HasValue)
                            {
                                <MudText Typo="Typo.caption">@lineup.LastRefresh.ChannelCountSeen.Value.ToString("N0") channels seen</MudText>
                            }
                            @if (!string.IsNullOrWhiteSpace(lineup.LastRefresh.ErrorSummary))
                            {
                                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mt-1">
                                    @lineup.LastRefresh.ErrorSummary
                                    @if (lineup.ActiveSnapshot is not null)
                                    {
                                        <text> Serving last known-good version.</text>
                                    }
                                </MudAlert>
                            }
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No refresh yet</MudText>
                        }
                    </MudStack>

                    @if (_nextRefreshUtc.HasValue || _refreshScheduleKind == "manual")
                    {
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Next Refresh</MudText>
                            @if (_nextRefreshUtc.HasValue && !_isRefreshing)
                            {
                                <MudText Typo="Typo.body2">@_nextRefreshUtc.Value.ToLocalTime().ToString("ddd d MMM, h:mm tt")</MudText>
                            }
                            else if (_refreshScheduleKind == "manual")
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Manual only</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Calculating…</MudText>
                            }
                        </MudStack>
                    }

                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Published Version</MudText>
                        @if (_dashboardStats is not null && _dashboardStats.PublishedLiveCount > 0)
                        {
                            <MudText Typo="Typo.body2">
                                @_dashboardStats.PublishedLiveCount.ToString("N0") live channels published
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @_dashboardStats.PublishedMovieCount.ToString("N0") movies, @_dashboardStats.PublishedSeriesCount.ToString("N0") series
                            </MudText>
                            @if (_dashboardStats.LastPublishedUtc.HasValue)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-1">
                                    <MudText Typo="Typo.caption">@_dashboardStats.LastPublishedUtc.Value.ToString("u")</MudText>
                                    @if (_dashboardStats.LastChangeClass is not null)
                                    {
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@ChangeClassChipColor(_dashboardStats.LastChangeClass)"
                                                 Variant="Variant.Outlined">
                                            @ChangeClasses.ToUserLabel(_dashboardStats.LastChangeClass)
                                        </MudChip>
                                    }
                                </MudStack>
                            }
                        }
                        else if (lineup?.ActiveSnapshot is not null)
                        {
                            <MudText Typo="Typo.body2">
                                @lineup.ActiveSnapshot.ChannelCountPublished.ToString("N0") entries published
                            </MudText>
                            <MudText Typo="Typo.caption">@lineup.ActiveSnapshot.CreatedUtc.ToString("u")</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">None</MudText>
                        }
                        @if (_isRefreshing)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Info">Updating lineup…</MudText>
                        }
                    </MudStack>
                </MudStack>
            }
        </MudPaper>
    </MudItem>

    <!-- Output URLs -->
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="1" Style="height: 100%;">
            <MudText Typo="Typo.h6" Class="mb-3">Output URLs</MudText>

            <!-- Published Output counts -->
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" Spacing="2">
                <MudChip T="string" Color="@(_dashboardStats?.PublishedLiveCount > 0 ? Color.Success : Color.Warning)"
                         Icon="@Icons.Material.Filled.LiveTv"
                         OnClick="@(() => Nav.NavigateTo("channels"))">
                    Live: @(_dashboardStats?.PublishedLiveCount ?? 0)
                </MudChip>
                <MudChip T="string" Color="@(_dashboardStats?.PublishedMovieCount > 0 ? Color.Info : Color.Default)"
                         Icon="@Icons.Material.Filled.Movie">
                    Movies: @(_dashboardStats?.PublishedMovieCount ?? 0)
                </MudChip>
                <MudChip T="string" Color="@(_dashboardStats?.PublishedSeriesCount > 0 ? Color.Info : Color.Default)"
                         Icon="@Icons.Material.Filled.Tv">
                    Series: @(_dashboardStats?.PublishedSeriesCount ?? 0)
                </MudChip>
            </MudStack>

            @if (_dashboardStats is null || _dashboardStats.PublishedLiveCount == 0)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                    No channels published yet — configure <MudLink Href="channels/mapping">Channel Mapping</MudLink> to start serving content.
                </MudAlert>
            }

            <MudStack Spacing="4">
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">M3U Playlist</MudText>
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <MudTextField Value="@_m3uUrl" ReadOnly="true" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" FullWidth="true" />
                        <MudTooltip Text="Copy">
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                           Size="Size.Small" OnClick="() => CopyAsync(_m3uUrl)" />
                        </MudTooltip>
                    </MudStack>
                </div>

                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">XMLTV Guide</MudText>
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <MudTextField Value="@_xmltvUrl" ReadOnly="true" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" FullWidth="true" />
                        <MudTooltip Text="Copy">
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                           Size="Size.Small" OnClick="() => CopyAsync(_xmltvUrl)" />
                        </MudTooltip>
                    </MudStack>
                </div>
            </MudStack>
        </MudPaper>
    </MudItem>

    <!-- Published Profiles -->
    @if (_dashboardStats?.ProfileSummaries.Count > 0)
    {
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="1">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudText Typo="Typo.h6">Profiles</MudText>
                    <MudButton Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ArrowForward" Href="profiles">
                        All Profiles
                    </MudButton>
                </MudStack>

                @if (_dashboardStats.ProfileSummaries.Count <= ProfileTileDisplayBudget)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap">
                        @foreach (var profile in _dashboardStats.ProfileSummaries)
                        {
                            var chipColor = profile.IsActive
                                ? (profile.HealthStatus == ProfileHealthStatus.Degraded ? Color.Warning : Color.Success)
                                : (profile.HealthStatus == ProfileHealthStatus.NoOutput ? Color.Default : Color.Info);
                            var chipVariant = profile.IsActive ? Variant.Filled : Variant.Outlined;
                            var chipIcon = profile.IsActive
                                ? (profile.HealthStatus == ProfileHealthStatus.Degraded ? Icons.Material.Filled.Warning : Icons.Material.Filled.CheckCircle)
                                : (profile.HealthStatus == ProfileHealthStatus.NoOutput ? Icons.Material.Filled.RadioButtonUnchecked : Icons.Material.Filled.Inventory2);
                            <MudTooltip Text="@(profile.IsActive ? "Serving at output URLs" : profile.HealthStatus == ProfileHealthStatus.NoOutput ? "No published output" : "Published — standby")" Arrow="true" Placement="Placement.Top">
                                <MudChip T="string"
                                         Color="@chipColor"
                                         Variant="@chipVariant"
                                         Icon="@chipIcon"
                                         OnClick="@(() => Nav.NavigateTo($"profiles/{profile.ProfileId}"))">
                                    @profile.DisplayName — @if (profile.IsActive) { <text>@profile.LiveCount live</text> } else if (profile.HealthStatus != ProfileHealthStatus.NoOutput) { <text>@profile.LiveCount ch</text> } else { <text>no output</text> }
                                </MudChip>
                            </MudTooltip>
                        }
                    </MudStack>
                }
                else
                {
                    <MudButton Variant="Variant.Text" Href="profiles">
                        @_dashboardStats.ProfileSummaries.Count profiles published
                    </MudButton>
                }
            </MudPaper>
        </MudItem>
    }

    <!-- Action Items -->
    @if (HasActionItems)
    {
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-3">Action Items</MudText>
                <MudStack Spacing="2">
                    @if (_dashboardStats!.GroupsPendingReview > 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                            @_dashboardStats.GroupsPendingReview new group@(_dashboardStats.GroupsPendingReview == 1 ? "" : "s") to review —
                            <MudLink Href="channels/mapping">review now</MudLink>
                        </MudAlert>
                    }
                    @if (_dashboardStats!.ChannelsPendingReview > 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                            @_dashboardStats.ChannelsPendingReview new channel@(_dashboardStats.ChannelsPendingReview == 1 ? "" : "s") to review —
                            <MudLink Href="channels/review">review now</MudLink>
                        </MudAlert>
                    }
                    @if (_dashboardStats!.RefreshFailed)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                            Last refresh failed — serving last known-good version.
                        </MudAlert>
                    }
                </MudStack>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

@code {
    private const int ProfileTileDisplayBudget = 4;

    private StatusResponse? _status;
    private DashboardStatsDto? _dashboardStats;
    private bool _isLoading;
    private bool _isRefreshing;
    private string? _loadError;

    private string _m3uUrl = string.Empty;
    private string _xmltvUrl = string.Empty;

    private readonly CancellationTokenSource _cts = new();
    private IDisposable? _eventSubscription;
    private DateTime? _refreshStartedAt;
    private PeriodicTimer? _elapsedTimer;
    private PeriodicTimer? _streamTimer;
    private bool _isCancelling;
    private int _streamSessions;
    private int _streamClients;

    private DateTime? _nextRefreshUtc;
    private string _refreshScheduleKind = "6h";

    private bool HasActionItems => _dashboardStats is not null &&
        (_dashboardStats.GroupsPendingReview > 0 ||
         _dashboardStats.ChannelsPendingReview > 0 ||
         _dashboardStats.RefreshFailed);

    protected override async Task OnInitializedAsync()
    {
        var baseUri = Nav.BaseUri.TrimEnd('/');
        _m3uUrl = $"{baseUri}/m3u/m3undle.m3u";
        _xmltvUrl = $"{baseUri}/xmltv/m3undle.xml";

        if (!RendererInfo.IsInteractive) return;

        _isRefreshing = RefreshTrigger.IsRefreshing;
        if (_isRefreshing)
        {
            _refreshStartedAt = DateTime.UtcNow;
            StartElapsedTimer();
        }

        var reader = EventBus.Subscribe(out _eventSubscription);
        _ = ListenForEventsAsync(reader, _cts.Token);

        RefreshStreamCounts();
        _streamTimer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        _ = RunStreamTimerAsync(_streamTimer);

        await LoadAllAsync();
    }

    private async Task ListenForEventsAsync(System.Threading.Channels.ChannelReader<AppEvent> reader, CancellationToken ct)
    {
        try
        {
            await foreach (var evt in reader.ReadAllAsync(ct))
            {
                if (evt.Kind == AppEventKind.RefreshStarted)
                {
                    _isRefreshing = true;
                    _refreshStartedAt = DateTime.UtcNow;
                    StartElapsedTimer();
                    await InvokeAsync(StateHasChanged);
                }
                else if (evt.Kind == AppEventKind.RefreshCompleted)
                {
                    _isRefreshing = false;
                    _isCancelling = false;
                    _refreshStartedAt = null;
                    StopElapsedTimer();
                    if (!_isLoading)
                        await InvokeAsync(LoadAllAsync);
                }
                else if (evt.Kind == AppEventKind.GroupFiltersChanged)
                {
                    await InvokeAsync(LoadDashboardStatsAsync);
                }
                else if (!_isLoading)
                {
                    await InvokeAsync(LoadStatusAsync);
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadAllAsync()
    {
        await Task.WhenAll(LoadStatusAsync(), LoadDashboardStatsAsync(), LoadRefreshScheduleAsync());
    }

    private async Task LoadRefreshScheduleAsync()
    {
        try
        {
            var settings = await RefreshScheduleService.GetSettingsAsync(_cts.Token);
            _refreshScheduleKind = settings.ScheduleKind;
            _nextRefreshUtc = await RefreshScheduleService.GetNextScheduledRefreshUtcAsync(_cts.Token);
        }
        catch (OperationCanceledException) { }
        catch { }
    }

    private async Task LoadStatusAsync()
    {
        _isLoading = true;
        _loadError = null;

        try
        {
            _status = await Http.GetFromJsonAsync<StatusResponse>("/status", _cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load status: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadDashboardStatsAsync()
    {
        try
        {
            _dashboardStats = await DashboardStats.GetStatsAsync(_cts.Token);
        }
        catch (OperationCanceledException) { return; }

        StateHasChanged();
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        _eventSubscription?.Dispose();
        _elapsedTimer?.Dispose();
        _streamTimer?.Dispose();
    }

    private void RefreshStreamCounts()
    {
        _streamSessions = StreamingRegistry.GetActiveSessions().Count;
        _streamClients = StreamingRegistry.GetActiveClients().Count;
    }

    private async Task RunStreamTimerAsync(PeriodicTimer timer)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
                await InvokeAsync(() => { RefreshStreamCounts(); StateHasChanged(); });
        }
        catch (OperationCanceledException) { }
    }

    private void StartElapsedTimer()
    {
        _elapsedTimer?.Dispose();
        _elapsedTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _ = RunElapsedTimerAsync(_elapsedTimer);
    }

    private void StopElapsedTimer()
    {
        _elapsedTimer?.Dispose();
        _elapsedTimer = null;
    }

    private async Task RunElapsedTimerAsync(PeriodicTimer timer)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
                await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
    }

    private string ElapsedText => _refreshStartedAt.HasValue
        ? FormatElapsed(DateTime.UtcNow - _refreshStartedAt.Value)
        : string.Empty;

    private string? LastRunDurationText
    {
        get
        {
            var last = _status?.Lineup?.LastRefresh;
            if (last?.Status == "ok" && last.FinishedUtc.HasValue)
                return FormatElapsed(last.FinishedUtc.Value - last.StartedUtc);
            return null;
        }
    }

    private static string FormatElapsed(TimeSpan ts)
    {
        if (ts.TotalSeconds < 60) return $"{(int)ts.TotalSeconds}s";
        if (ts.TotalMinutes < 60) return $"{(int)ts.TotalMinutes}m {ts.Seconds}s";
        return $"{(int)ts.TotalHours}h {ts.Minutes}m";
    }

    private static Color ChangeClassChipColor(string? changeClass) => changeClass switch
    {
        ChangeClasses.None      => Color.Default,
        ChangeClasses.GuideOnly => Color.Info,
        ChangeClasses.Lineup    => Color.Primary,
        ChangeClasses.Breaking  => Color.Warning,
        _                       => Color.Default,
    };

    private async Task CancelRefreshAsync()
    {
        if (_isCancelling) return;
        _isCancelling = true;
        StateHasChanged();
        try { RefreshTrigger.CancelRefresh(); }
        catch { }
        await Task.CompletedTask;
    }

    private async Task CopyAsync(string text)
    {
        await JsApiService.CopyToClipboardAsync(text);
        Snackbar.Add("Copied to clipboard", Severity.Success);
    }

    private sealed record StatusResponse(string Status, IReadOnlyList<LineupStatusInfo>? Lineups)
    {
        public LineupStatusInfo? Lineup => Lineups?.FirstOrDefault(l => l.Name == "m3undle") ?? Lineups?.FirstOrDefault();
    }

    private sealed record LineupStatusInfo(
        string Name,
        string Status,
        ActiveProviderInfo? ActiveProvider,
        ActiveSnapshotInfo? ActiveSnapshot,
        FetchRunInfo? LastRefresh);

    private sealed record ActiveProviderInfo(string ProviderId, string Name);

    private sealed record ActiveSnapshotInfo(
        string SnapshotId,
        string ProfileId,
        DateTime CreatedUtc,
        int ChannelCountPublished);

    private sealed record FetchRunInfo(
        string Status,
        DateTime StartedUtc,
        DateTime? FinishedUtc,
        int? ChannelCountSeen,
        string? ErrorSummary);
}
