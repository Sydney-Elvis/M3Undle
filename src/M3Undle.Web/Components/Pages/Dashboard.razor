@attribute [StreamRendering]
@using Microsoft.AspNetCore.Components
@page "/"
@using M3Undle.Web.Application
@using M3Undle.Web.Contracts
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject AppEventBus EventBus
@inject IRefreshTrigger RefreshTrigger
@inject DashboardStatsService DashboardStats
@inject LineupStatusService StatusService
@inject IRefreshScheduleService RefreshScheduleService
@inject PersistentComponentState ApplicationState
@implements IDisposable

<PageTitle>M3Undle</PageTitle>

@if (_loadError is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_loadError</MudAlert>
}

@if (HasTodoItems)
{
    <MudAlert Severity="@TodoAlertSeverity" Variant="Variant.Outlined" Class="mb-4" Icon="@Icons.Material.Filled.Warning">
        <MudStack Spacing="2">
            <div>
                <MudText Typo="Typo.h6">@TodoAlertTitle</MudText>
                <MudText Typo="Typo.body2">
                    M3Undle needs the items below resolved before the output URLs can serve the expected lineup.
                </MudText>
            </div>

            <MudStack Spacing="1">
                @if (NeedsActiveProfile)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Size="Size.Small" Color="Color.Warning" Class="mt-1" />
                        <MudText Typo="Typo.body2">
                            <strong>No active profile.</strong>
                            <MudLink Href="providers">Add a provider</MudLink>, or open <MudLink Href="profiles">Profiles</MudLink> and set an existing profile active.
                        </MudText>
                    </MudStack>
                }

                @if (NeedsActiveProvider)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.CloudQueue" Size="Size.Small" Color="Color.Warning" Class="mt-1" />
                        <MudText Typo="Typo.body2">
                            <strong>The active profile has no enabled provider.</strong>
                            Open <MudLink Href="providers">Providers</MudLink> and add or enable a source for this profile.
                        </MudText>
                    </MudStack>
                }

                @if (NeedsPublishedOutput)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.LiveTv" Size="Size.Small" Color="Color.Warning" Class="mt-1" />
                        <MudText Typo="Typo.body2">
                            <strong>No channels are published.</strong>
                            Open <MudLink Href="channels/mapping">Channel Mapping</MudLink>, include the groups or channels you want, then run a refresh.
                        </MudText>
                    </MudStack>
                }

                @foreach (var ep in _dashboardStats?.ExpiringProviders ?? [])
                {
                    var daysLeft = (ep.ExpiresUtc - DateTime.UtcNow).TotalDays;
                    var expirationText = daysLeft < 0
                        ? $"expired on {ep.ExpiresUtc:yyyy-MM-dd}"
                        : daysLeft < 1
                            ? $"expires today ({ep.ExpiresUtc:yyyy-MM-dd})"
                            : $"expires in {(int)daysLeft + 1}d on {ep.ExpiresUtc:yyyy-MM-dd}";
                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.EventBusy" Size="Size.Small" Color="@(daysLeft <= 0 ? Color.Error : Color.Warning)" Class="mt-1" />
                        <MudText Typo="Typo.body2">
                            <strong>Provider subscription @expirationText.</strong>
                            Renew provider "@ep.ProviderName" to avoid stream outages, then update it on <MudLink Href="providers">Providers</MudLink>.
                        </MudText>
                    </MudStack>
                }

                @if (_dashboardStats?.GroupsPendingReview > 0)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Rule" Size="Size.Small" Color="Color.Info" Class="mt-1" />
                        <MudText Typo="Typo.body2">
                            <strong>@_dashboardStats.GroupsPendingReview new group@(_dashboardStats.GroupsPendingReview == 1 ? "" : "s") need review.</strong>
                            Open <MudLink Href="channels/mapping">Channel Mapping</MudLink> to include or exclude them.
                        </MudText>
                    </MudStack>
                }

                @if (_dashboardStats?.ChannelsPendingReview > 0)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.PlaylistAddCheck" Size="Size.Small" Color="Color.Info" Class="mt-1" />
                        <MudText Typo="Typo.body2">
                            <strong>@_dashboardStats.ChannelsPendingReview new channel@(_dashboardStats.ChannelsPendingReview == 1 ? "" : "s") need review.</strong>
                            Open <MudLink Href="channels/review">Channel Review</MudLink> to approve or dismiss them.
                        </MudText>
                    </MudStack>
                }

                @if (_dashboardStats?.RefreshFailed == true)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.SyncProblem" Size="Size.Small" Color="Color.Warning" Class="mt-1" />
                        <MudText Typo="Typo.body2">
                            <strong>Last refresh failed.</strong>
                            M3Undle is serving the last known-good version. Fix the provider or source issue, then run another refresh.
                        </MudText>
                    </MudStack>
                }
            </MudStack>
        </MudStack>
    </MudAlert>
}

<MudGrid Spacing="3">
    <!-- System Status -->
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="1" Style="height: 100%;">
            <MudText Typo="Typo.h6" Class="mb-3">System Status</MudText>

            @if (_isLoading)
            {
                <MudProgressCircular Indeterminate="true" />
            }
            else if (_status is null)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Status unavailable.</MudAlert>
            }
            else
            {
                <MudStack Spacing="3">
                @{
                    var lineup = _status.Lineup;
                    var selectedProfile = SelectedProfileSummary;
                    var isActiveSelected = selectedProfile?.IsActive == true || (selectedProfile == null && lineup?.ActiveProfile is not null);
                }
                    @if (_dashboardStats?.ProfileSummaries.Any(p => p.IsActive) == true)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
                            @foreach (var profile in _dashboardStats.ProfileSummaries.Where(p => p.IsActive))
                            {
                                var isSelected = selectedProfile?.ProfileId == profile.ProfileId;
                                var chipColor = profile.HealthStatus == ProfileHealthStatus.Degraded ? Color.Warning : Color.Success;
                                var chipIcon = profile.HealthStatus == ProfileHealthStatus.Degraded
                                    ? Icons.Material.Filled.Warning
                                    : Icons.Material.Filled.CheckCircle;
                                <MudChip T="string"
                                         Color="@chipColor"
                                         Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                                         Icon="@chipIcon"
                                         OnClick="@(() => SelectProfile(profile.ProfileId))">
                                    @profile.DisplayName
                                </MudChip>
                            }
                        </MudStack>
                    }

                    <MudDivider />

                    @if (isActiveSelected)
                    {
                        @if (_dashboardStats?.ActiveProfileProviderExpiresUtc is { } expiresUtc)
                        {
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Provider Expiration</MudText>
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="@ProviderExpirationChipColor(expiresUtc)"
                                         Variant="Variant.Outlined"
                                         Style="align-self: flex-start;">
                                    @ProviderExpirationLabel(expiresUtc)
                                </MudChip>
                            </MudStack>
                        }

                        <MudStack Spacing="1">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Last Refresh</MudText>
                            @if (ShowRefreshing)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                                    <MudText Typo="Typo.body2">Refreshing… @(!string.IsNullOrEmpty(ElapsedText) ? $"({ElapsedText} elapsed)" : "")</MudText>
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Outlined"
                                               Color="Color.Error"
                                               StartIcon="@Icons.Material.Filled.Cancel"
                                               OnClick="CancelRefreshAsync"
                                               Disabled="_isCancelling">
                                        @(_isCancelling ? "Cancelling…" : "Cancel")
                                    </MudButton>
                                </MudStack>
                                @if (LastRunDurationText is not null && _status?.Lineup?.LastRefresh is { } lastRun)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        Last run: ~@LastRunDurationText
                                        @(lastRun.ChannelCountSeen.HasValue ? $", {lastRun.ChannelCountSeen.Value:N0} channels" : "")
                                        — please wait.
                                    </MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Large providers may take several minutes.</MudText>
                                }
                            }
                            else if (lineup?.LastRefresh is not null)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@(lineup.LastRefresh.Status == "ok" ? Color.Success : lineup.LastRefresh.Status == "running" ? Color.Info : Color.Error)">
                                        @lineup.LastRefresh.Status
                                    </MudChip>
                                    @if (lineup.LastRefresh.FinishedUtc.HasValue)
                                    {
                                        <MudText Typo="Typo.body2">@lineup.LastRefresh.FinishedUtc.Value.ToString("u")</MudText>
                                    }
                                </MudStack>
                                @if (lineup.LastRefresh.ChannelCountSeen.HasValue)
                                {
                                    <MudText Typo="Typo.caption">@lineup.LastRefresh.ChannelCountSeen.Value.ToString("N0") channels seen</MudText>
                                }
                                @if (!string.IsNullOrWhiteSpace(lineup.LastRefresh.ErrorSummary))
                                {
                                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mt-1">
                                        @lineup.LastRefresh.ErrorSummary
                                        @if (lineup.ActiveSnapshot is not null)
                                        {
                                            <text> Serving last known-good version.</text>
                                        }
                                    </MudAlert>
                                }
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">No refresh yet</MudText>
                            }
                        </MudStack>

                        @if (_nextRefreshUtc.HasValue || _refreshScheduleKind == "manual")
                        {
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Next Refresh</MudText>
                                @if (_nextRefreshUtc.HasValue && !ShowRefreshing)
                                {
                                    <MudText Typo="Typo.body2">@_nextRefreshUtc.Value.ToLocalTime().ToString("ddd d MMM, h:mm tt")</MudText>
                                }
                                else if (_refreshScheduleKind == "manual")
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">Manual only</MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">Calculating…</MudText>
                                }
                            </MudStack>
                        }

                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Published Version</MudText>
                            @if (_dashboardStats is not null && _dashboardStats.PublishedLiveCount > 0)
                            {
                                <MudText Typo="Typo.body2">
                                    @_dashboardStats.PublishedLiveCount.ToString("N0") live channels published
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @_dashboardStats.PublishedMovieCount.ToString("N0") movies, @_dashboardStats.PublishedSeriesCount.ToString("N0") series
                                </MudText>
                                @if (_dashboardStats.LastPublishedUtc.HasValue)
                                {
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-1">
                                        <MudText Typo="Typo.caption">@_dashboardStats.LastPublishedUtc.Value.ToString("u")</MudText>
                                        @if (_dashboardStats.LastChangeClass is not null)
                                        {
                                            <MudChip T="string" Size="Size.Small"
                                                     Color="@ChangeClassChipColor(_dashboardStats.LastChangeClass)"
                                                     Variant="Variant.Outlined">
                                                @ChangeClasses.ToUserLabel(_dashboardStats.LastChangeClass)
                                            </MudChip>
                                        }
                                    </MudStack>
                                }
                            }
                            else if (lineup?.ActiveSnapshot is not null)
                            {
                                <MudText Typo="Typo.body2">
                                    @lineup.ActiveSnapshot.ChannelCountPublished.ToString("N0") entries published
                                </MudText>
                                <MudText Typo="Typo.caption">@lineup.ActiveSnapshot.CreatedUtc.ToString("u")</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">None</MudText>
                            }
                            @if (ShowRefreshing)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Info">Updating lineup…</MudText>
                            }
                        </MudStack>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">None selected</MudText>
                    }
                </MudStack>
            }
        </MudPaper>
    </MudItem>

    <!-- Output URLs -->
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="1" Style="height: 100%;">
            <MudText Typo="Typo.h6" Class="mb-3">Output URLs</MudText>

            <!-- Published Output counts -->
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" Spacing="2">
                <MudChip T="string" Color="@(_dashboardStats?.PublishedLiveCount > 0 ? Color.Success : Color.Warning)"
                         Icon="@Icons.Material.Filled.LiveTv"
                         OnClick="@(() => Nav.NavigateTo("channels"))">
                    Live: @(_dashboardStats?.PublishedLiveCount ?? 0)
                </MudChip>
                <MudChip T="string" Color="@(_dashboardStats?.PublishedMovieCount > 0 ? Color.Info : Color.Default)"
                         Icon="@Icons.Material.Filled.Movie">
                    Movies: @(_dashboardStats?.PublishedMovieCount ?? 0)
                </MudChip>
                <MudChip T="string" Color="@(_dashboardStats?.PublishedSeriesCount > 0 ? Color.Info : Color.Default)"
                         Icon="@Icons.Material.Filled.Tv">
                    Series: @(_dashboardStats?.PublishedSeriesCount ?? 0)
                </MudChip>
            </MudStack>

            <MudStack Spacing="4">
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">M3U Playlist</MudText>
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <MudTextField Value="@_m3uUrl" ReadOnly="true" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" FullWidth="true" />
                        <MudTooltip Text="Copy">
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                           Size="Size.Small" OnClick="() => CopyAsync(_m3uUrl)" />
                        </MudTooltip>
                    </MudStack>
                </div>

                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">XMLTV Guide</MudText>
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <MudTextField Value="@_xmltvUrl" ReadOnly="true" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" FullWidth="true" />
                        <MudTooltip Text="Copy">
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                           Size="Size.Small" OnClick="() => CopyAsync(_xmltvUrl)" />
                        </MudTooltip>
                    </MudStack>
                </div>
            </MudStack>
        </MudPaper>
    </MudItem>

</MudGrid>

@code {
    private string? _selectedProfileId;

    private DashboardProfileSummary? SelectedProfileSummary =>
        _dashboardStats?.ProfileSummaries.FirstOrDefault(p => p.ProfileId == _selectedProfileId && p.IsActive)
        ?? _dashboardStats?.ProfileSummaries.FirstOrDefault(p => p.IsActive);

    private void SelectProfile(string profileId) => _selectedProfileId = profileId;

    private LineupStatusResponse? _status;
    private DashboardStatsDto? _dashboardStats;
    private bool _isLoading;
    private bool _isRefreshing;
    private string? _loadError;

    private string _m3uUrl = string.Empty;
    private string _xmltvUrl = string.Empty;

    private readonly CancellationTokenSource _cts = new();
    private IDisposable? _eventSubscription;
    private DateTime? _refreshStartedAt;
    private PeriodicTimer? _elapsedTimer;
    private PersistingComponentStateSubscription? _persistSubscription;
    private bool _isCancelling;

    private DateTime? _nextRefreshUtc;
    private string _refreshScheduleKind = "6h";
    private bool ShowRefreshing => _isRefreshing || _status?.IsRefreshing == true;

    private bool NeedsActiveProfile => _status?.Status == LineupStatusCodes.NoActiveProfile;

    private bool NeedsActiveProvider => !NeedsActiveProfile &&
        _status?.Lineup?.ActiveProfile is not null &&
        _status.Lineup.ActiveProvider is null;

    private bool NeedsPublishedOutput => !NeedsActiveProfile &&
        !NeedsActiveProvider &&
        (_status?.Status == LineupStatusCodes.NoActiveSnapshot ||
         (_dashboardStats is not null && _dashboardStats.PublishedLiveCount == 0));

    private bool HasDashboardActionItems => _dashboardStats is not null &&
        (_dashboardStats.ExpiringProviders.Count > 0 ||
         _dashboardStats.GroupsPendingReview > 0 ||
         _dashboardStats.ChannelsPendingReview > 0 ||
         _dashboardStats.RefreshFailed);

    private bool HasTodoItems => NeedsActiveProfile || NeedsActiveProvider || NeedsPublishedOutput || HasDashboardActionItems;

    private string TodoAlertTitle => NeedsActiveProfile || NeedsActiveProvider || NeedsPublishedOutput ? "Setup Required" : "Attention Needed";

    private Severity TodoAlertSeverity => _dashboardStats?.ExpiringProviders.Any(x => x.ExpiresUtc <= DateTime.UtcNow) == true
        ? Severity.Error
        : Severity.Warning;

    protected override async Task OnInitializedAsync()
    {
        var baseUri = Nav.BaseUri.TrimEnd('/');
        _m3uUrl = $"{baseUri}/m3u/m3undle.m3u";
        _xmltvUrl = $"{baseUri}/xmltv/m3undle.xml";

        _isRefreshing = RefreshTrigger.IsRefreshing;
        if (_isRefreshing)
            _refreshStartedAt = DateTime.UtcNow;

        var restoredFromPrerender = TryRestorePersistedState();
        _persistSubscription = ApplicationState.RegisterOnPersisting(PersistStateAsync);

        if (!RendererInfo.IsInteractive)
        {
            // SSR pass: block to populate state for the pre-rendered HTML.
            if (!restoredFromPrerender)
                await LoadAllAsync();
            return;
        }

        // Interactive pass: never block the circuit — fire-and-forget all data loads
        // so user interactions (nav, events bell) remain responsive while data arrives.
        if (_isRefreshing)
            StartElapsedTimer();

        var reader = EventBus.Subscribe(out _eventSubscription);
        _ = ListenForEventsAsync(reader, _cts.Token);

        if (!restoredFromPrerender)
            _ = LoadAllAsync();
        else
            _ = LoadRefreshScheduleAsync();
    }

    private async Task ListenForEventsAsync(System.Threading.Channels.ChannelReader<AppEvent> reader, CancellationToken ct)
    {
        try
        {
            await foreach (var evt in reader.ReadAllAsync(ct))
            {
                if (evt.Kind == AppEventKind.RefreshStarted)
                {
                    _isRefreshing = true;
                    _refreshStartedAt = DateTime.UtcNow;
                    StartElapsedTimer();
                    await InvokeAsync(StateHasChanged);
                }
                else if (evt.Kind == AppEventKind.RefreshCompleted)
                {
                    _isRefreshing = false;
                    _isCancelling = false;
                    _refreshStartedAt = null;
                    StopElapsedTimer();
                    if (!_isLoading)
                        await InvokeAsync(LoadAllAsync);
                }
                else if (evt.Kind == AppEventKind.GroupFiltersChanged)
                {
                    await InvokeAsync(LoadDashboardStatsAsync);
                }
                else if (evt.Kind == AppEventKind.ProviderActivated)
                {
                    if (!_isLoading)
                        await InvokeAsync(LoadAllAsync);
                }
                else if (!_isLoading)
                {
                    await InvokeAsync(LoadStatusAsync);
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadAllAsync()
    {
        await Task.WhenAll(LoadStatusAsync(), LoadDashboardStatsAsync(), LoadRefreshScheduleAsync());
    }

    private async Task LoadRefreshScheduleAsync()
    {
        try
        {
            var ct = _cts.Token;
            var settings = await Task.Run(() => RefreshScheduleService.GetActiveProfileSettingsAsync(ct), ct);
            _refreshScheduleKind = settings?.Settings.ScheduleKind ?? "manual";
            _nextRefreshUtc = settings?.ProfileId is null
                ? null
                : await Task.Run(() => RefreshScheduleService.GetNextScheduledRefreshUtcAsync(settings.ProfileId, ct), ct);
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
        catch { }
    }

    private async Task LoadStatusAsync()
    {
        _isLoading = true;
        _loadError = null;

        try
        {
            var ct = _cts.Token;
            _status = await Task.Run(() => StatusService.GetStatusAsync(ct), ct);

            // Keep the page-level refresh spinner/timer in sync with server state
            // when the page loads mid-refresh or event delivery is delayed.
            if (_status.IsRefreshing && !_isRefreshing)
            {
                _isRefreshing = true;
                _refreshStartedAt ??= DateTime.UtcNow;
                StartElapsedTimer();
            }
            else if (!_status.IsRefreshing && _isRefreshing)
            {
                _isRefreshing = false;
                _isCancelling = false;
                _refreshStartedAt = null;
                StopElapsedTimer();
            }
        }
        catch (OperationCanceledException) { return; }
        catch (ObjectDisposedException) { return; }
        catch (Exception ex)
        {
            _loadError = $"Failed to load status: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            try { await InvokeAsync(StateHasChanged); } catch { }
        }
    }

    private async Task LoadDashboardStatsAsync()
    {
        try
        {
            var ct = _cts.Token;
            _dashboardStats = await Task.Run(() => DashboardStats.GetStatsAsync(ct), ct);
        }
        catch (OperationCanceledException) { return; }
        catch (ObjectDisposedException) { return; }

        try { await InvokeAsync(StateHasChanged); } catch { }
    }

    public void Dispose()
    {
        _persistSubscription?.Dispose();
        _cts.Cancel();
        _cts.Dispose();
        _eventSubscription?.Dispose();
        _elapsedTimer?.Dispose();
    }

    private void StartElapsedTimer()
    {
        _elapsedTimer?.Dispose();
        _elapsedTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _ = RunElapsedTimerAsync(_elapsedTimer);
    }

    private void StopElapsedTimer()
    {
        _elapsedTimer?.Dispose();
        _elapsedTimer = null;
    }

    private async Task RunElapsedTimerAsync(PeriodicTimer timer)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
                await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
    }

    private string ElapsedText => _refreshStartedAt.HasValue
        ? FormatElapsed(DateTime.UtcNow - _refreshStartedAt.Value)
        : string.Empty;

    private string? LastRunDurationText
    {
        get
        {
            var last = _status?.Lineup?.LastRefresh;
            if (last?.Status == "ok" && last.FinishedUtc.HasValue)
                return FormatElapsed(last.FinishedUtc.Value - last.StartedUtc);
            return null;
        }
    }

    private static string FormatElapsed(TimeSpan ts)
    {
        if (ts.TotalSeconds < 60) return $"{(int)ts.TotalSeconds}s";
        if (ts.TotalMinutes < 60) return $"{(int)ts.TotalMinutes}m {ts.Seconds}s";
        return $"{(int)ts.TotalHours}h {ts.Minutes}m";
    }

    private static Color ChangeClassChipColor(string? changeClass) => changeClass switch
    {
        ChangeClasses.None      => Color.Default,
        ChangeClasses.GuideOnly => Color.Info,
        ChangeClasses.Lineup    => Color.Primary,
        ChangeClasses.Breaking  => Color.Warning,
        _                       => Color.Default,
    };

    private static Color ProviderExpirationChipColor(DateTime expiresUtc)
    {
        var daysLeft = (expiresUtc - DateTime.UtcNow).TotalDays;
        return daysLeft <= 7 ? Color.Error
            : daysLeft <= 30 ? Color.Warning
            : Color.Info;
    }

    private static string ProviderExpirationLabel(DateTime expiresUtc)
    {
        var daysLeft = (expiresUtc - DateTime.UtcNow).TotalDays;
        return daysLeft < 0 ? $"Expired {expiresUtc:yyyy-MM-dd}"
            : daysLeft < 1 ? $"Expires today ({expiresUtc:yyyy-MM-dd})"
            : $"Expires {expiresUtc:yyyy-MM-dd}";
    }

    private async Task CancelRefreshAsync()
    {
        if (_isCancelling) return;
        _isCancelling = true;
        StateHasChanged();
        try { RefreshTrigger.CancelRefresh(); }
        catch { }
        await Task.CompletedTask;
    }

    private async Task CopyAsync(string text)
    {
        try
        {
            var copied = await JS.InvokeAsync<bool>("m3undleCopyText", text);
            if (copied)
            {
                Snackbar.Add("Copied to clipboard", Severity.Success);
            }
            else
            {
                Snackbar.Add("Copy failed. Please copy manually.", Severity.Warning);
            }
        }
        catch (JSException)
        {
            Snackbar.Add("Copy failed. Please copy manually.", Severity.Warning);
        }
    }

    private bool TryRestorePersistedState()
    {
        if (!ApplicationState.TryTakeFromJson<DashboardPersistentState>(nameof(DashboardPersistentState), out var state)
            || state is null)
        {
            return false;
        }

        _status = state.Status;
        _dashboardStats = state.DashboardStats;
        _nextRefreshUtc = state.NextRefreshUtc;
        _refreshScheduleKind = state.RefreshScheduleKind ?? _refreshScheduleKind;
        return state.Status is not null && state.DashboardStats is not null;
    }

    private Task PersistStateAsync()
    {
        ApplicationState.PersistAsJson(
            nameof(DashboardPersistentState),
            new DashboardPersistentState
            {
                Status = _status,
                DashboardStats = _dashboardStats,
                NextRefreshUtc = _nextRefreshUtc,
                RefreshScheduleKind = _refreshScheduleKind,
            });

        return Task.CompletedTask;
    }

    private sealed class DashboardPersistentState
    {
        public LineupStatusResponse? Status { get; init; }
        public DashboardStatsDto? DashboardStats { get; init; }
        public DateTime? NextRefreshUtc { get; init; }
        public string? RefreshScheduleKind { get; init; }
    }
}
