@using Microsoft.AspNetCore.Components.Web

<div style="display:inline-flex; align-items:center; gap:2px;">
    <MudTooltip Text="Move selected channels to a custom group" Arrow="true">
        <MudIconButton Icon="@Icons.Material.Filled.DriveFileMove" Size="Size.Small"
                       Color="@(_open ? Color.Primary : Color.Default)"
                       Disabled="@Disabled"
                       OnClick="@(() => _open = !_open)" />
    </MudTooltip>
    @if (_open)
    {
        <MudAutocomplete T="string"
            Value="@_text"
            ValueChanged="@(v => _text = v ?? string.Empty)"
            SearchFunc="SearchAsync"
            CoerceValue="true"
            Clearable="true"
            ResetValueOnEmptyText="true"
            Variant="Variant.Outlined"
            Margin="Margin.Dense"
            Dense="true"
            Immediate="true"
            Style="min-width:140px; max-width:220px;"
            Placeholder="Move to group…"
            @onkeydown="OnKeyDown" />
        <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success"
                       OnClick="CommitAsync" Disabled="@(string.IsNullOrWhiteSpace(_text))" />
        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                       OnClick="@(() => { _open = false; _text = string.Empty; })" />
    }
</div>

@code {
    [Parameter] public IReadOnlyList<string> CustomGroupNames { get; set; } = [];
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<string> OnCommit { get; set; }

    private bool _open;
    private string _text = string.Empty;

    private Task<IEnumerable<string>> SearchAsync(string value, CancellationToken _)
    {
        var names = CustomGroupNames.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(value))
            names = names.Where(n => n.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult<IEnumerable<string>>(names.OrderBy(n => n, StringComparer.OrdinalIgnoreCase));
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_text))
            await CommitAsync();
        else if (e.Key == "Escape")
        {
            _open = false;
            _text = string.Empty;
        }
    }

    private async Task CommitAsync()
    {
        if (string.IsNullOrWhiteSpace(_text)) return;
        var name = _text.Trim();
        _open = false;
        _text = string.Empty;
        await OnCommit.InvokeAsync(name);
    }
}
