@page "/channels"
@using M3Undle.Web.Application
@using M3Undle.Web.Contracts
@inject ChannelListPageService ChannelListPageService
@inject ProfilesPageService ProfilesService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>M3Undle — Channels</PageTitle>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">Channels</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Live channels in the published lineup.</MudText>
        </MudStack>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            @if (_allProfiles.Count > 0)
            {
                <MudSelect T="string"
                           Value="_profileId"
                           ValueChanged="OnProfileChangedAsync"
                           Label="Profile"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Style="min-width:160px;"
                           AnchorOrigin="Origin.BottomLeft">
                    @foreach (var p in _allProfiles)
                    {
                        <MudSelectItem Value="@p.ProfileId">@p.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            @if (_total.HasValue && !_numberManagerMode)
            {
                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined">
                    @_total.Value.ToString("N0") channels
                </MudChip>
            }
            @if (_pendingRebuild)
            {
                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Outlined"
                         Icon="@Icons.Material.Filled.Build">
                    Rebuild needed
                </MudChip>
            }
            @if (_numberManagerMode)
            {
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Close"
                           OnClick="ExitNumberManager">
                    Exit Number Manager
                </MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.FilterList"
                           Href="@($"channels/mapping{(!string.IsNullOrEmpty(_profileId) ? $"?profile={_profileId}" : "")}")">
                    Map Channels
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.FormatListNumbered"
                           OnClick="EnterNumberManagerAsync">
                    Manage Numbers
                </MudButton>
                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               Size="Size.Small"
                               OnClick="@(() => _grid!.ReloadServerData())"
                               Disabled="@(_grid is null)" />
            }
        </MudStack>
    </MudStack>
</MudPaper>

@if (_numberManagerMode)
{
    <!-- =========================================================
         Number Manager inline panel
         ========================================================= -->
    <MudPaper Elevation="2" Class="pa-0">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="pa-3 pb-2">
            <MudStack Spacing="0">
                <MudText Typo="Typo.subtitle1">Channel Number Manager</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Edit numbers directly or use ▲ ▼ to swap adjacent channels. Rebuild output after saving.
                </MudText>
            </MudStack>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                @if (_nmDirty.Count > 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning">@_nmDirty.Count unsaved change(s)</MudText>
                }
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Disabled="@(_nmSaving || _nmDirty.Count == 0)"
                           OnClick="NmApplyAllAsync">
                    @(_nmSaving ? "Saving…" : "Apply All")
                </MudButton>
            </MudStack>
        </MudStack>

        @if (_nmLoading)
        {
            <MudStack AlignItems="AlignItems.Center" Class="pa-8">
                <MudProgressCircular Indeterminate="true" />
                <MudText Color="Color.Secondary">Loading channels…</MudText>
            </MudStack>
        }
        else if (_nmChannels.Count == 0)
        {
            <MudStack AlignItems="AlignItems.Center" Class="pa-8" Spacing="2">
                <MudIcon Icon="@Icons.Material.Outlined.Tv" Size="Size.Large" Color="Color.Secondary" />
                <MudText Color="Color.Secondary">No channels found. Map some channels first.</MudText>
            </MudStack>
        }
        else
        {
            <MudSimpleTable Dense="true" Hover="true" Style="overflow-x:auto;">
                <thead>
                    <tr>
                        <th style="width:80px; text-align:center;">Reorder</th>
                        <th style="width:120px;">Ch. Number</th>
                        <th>Channel Name</th>
                        <th style="width:200px;">Group</th>
                        <th style="width:32px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < _nmChannels.Count; i++)
                    {
                        var ch = _nmChannels[i];
                        var idx = i;
                        <tr>
                            <td style="text-align:center; padding:2px 4px;">
                                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp"
                                               Size="Size.Small"
                                               Disabled="@(idx == 0)"
                                               OnClick="@(() => NmMoveUp(idx))" />
                                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown"
                                               Size="Size.Small"
                                               Disabled="@(idx == _nmChannels.Count - 1)"
                                               OnClick="@(() => NmMoveDown(idx))" />
                            </td>
                            <td style="padding:2px 8px;">
                                <MudNumericField T="int?"
                                                 Value="@ch.ChannelNumber"
                                                 ValueChanged="@(v => NmSetNumber(ch, v))"
                                                 HideSpinButtons="true"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense"
                                                 Placeholder="auto"
                                                 Style="width:100px;" />
                            </td>
                            <td>
                                <MudText Typo="Typo.body2">@ch.DisplayName</MudText>
                            </td>
                            <td>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@ch.GroupTitle</MudText>
                            </td>
                            <td style="padding:2px 4px;">
                                @if (_nmDirty.Contains(ch.ProviderChannelId))
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.FiberManualRecord"
                                             Size="Size.Small"
                                             Color="Color.Warning" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </MudPaper>
}
else if (_noSnapshot)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        No published lineup found. <MudLink Href="@($"channels/mapping{(_profileId is not null ? $"?profile={_profileId}" : "")}")">Build your output</MudLink> first.
    </MudAlert>
}
else
{
    <MudDataGrid @ref="_grid"
                 T="ChannelListItemDto"
                 ServerData="LoadChannelsAsync"
                 Dense="true"
                 Hover="true"
                 Filterable="false"
                 RowsPerPage="50"
                 Elevation="2">
        <ToolBarContent>
            <!-- Group filter dropdown -->
            <MudSelect T="string"
                       Value="_groupFilter"
                       ValueChanged="OnGroupFilterChanged"
                       Placeholder="All groups"
                       Clearable="true"
                       Margin="Margin.Dense"
                       Variant="Variant.Outlined"
                       Style="min-width:220px; max-width:300px;"
                       AnchorOrigin="Origin.BottomLeft">
                @foreach (var g in _availableGroups)
                {
                    <MudSelectItem Value="@g">@g</MudSelectItem>
                }
            </MudSelect>
            <MudSpacer />
            <MudTextField Value="_search"
                          ValueChanged="@((string v) => OnSearchChanged(v))"
                          Placeholder="Search name, group, or EPG ID…"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(!string.IsNullOrEmpty(_search) ? Icons.Material.Filled.Clear : Icons.Material.Filled.Search)"
                          OnAdornmentClick="ClearSearchAsync"
                          Margin="Margin.Dense"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          DebounceInterval="400"
                          OnDebounceIntervalElapsed="ReloadGridAsync"
                          Style="max-width:340px;" />
        </ToolBarContent>
        <Columns>
            <TemplateColumn Title="Ch. #"
                            HeaderStyle="width:75px; text-align:right;"
                            CellStyle="text-align:right; padding-right:8px;"
                            Sortable="false">
                <CellTemplate>
                    @if (context.Item.ChannelNumber is { } n)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@n</MudText>
                    }
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Logo"
                            HeaderStyle="width:60px;"
                            CellStyle="padding:4px 8px;"
                            Sortable="false">
                <CellTemplate>
                    @if (!string.IsNullOrEmpty(context.Item.LogoUrl))
                    {
                        <img src="@context.Item.LogoUrl"
                             style="height:28px; max-width:48px; object-fit:contain; vertical-align:middle; display:block;"
                             loading="lazy"
                             onerror="this.style.visibility='hidden'" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Outlined.Tv" Size="Size.Small" Color="Color.Tertiary" Style="opacity:0.35;" />
                    }
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Channel Name" Sortable="false">
                <CellTemplate>
                    <MudText Typo="Typo.body2">@context.Item.DisplayName</MudText>
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Group" Sortable="false">
                <CellTemplate>
                    @if (!string.IsNullOrEmpty(context.Item.GroupTitle))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Item.GroupTitle</MudText>
                    }
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="EPG ID"
                            HeaderStyle="width:200px;"
                            Sortable="false">
                <CellTemplate>
                    @if (!string.IsNullOrEmpty(context.Item.TvgId))
                    {
                        <MudTooltip Text="@context.Item.TvgId" Placement="Placement.Left" Arrow="true">
                            <MudText Typo="Typo.caption" Color="Color.Success" Style="cursor:default;">
                                @(context.Item.TvgId.Length > 24 ? context.Item.TvgId[..24] + "…" : context.Item.TvgId)
                            </MudText>
                        </MudTooltip>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Style="opacity:0.25;">—</MudText>
                    }
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title=""
                            HeaderStyle="width:90px;"
                            CellStyle="padding:2px 4px; text-align:right;"
                            Sortable="false">
                <CellTemplate>
                    <MudTooltip Text="Edit channel" Placement="Placement.Left">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       Color="Color.Default"
                                       OnClick="@(() => OpenEditDialogAsync(context.Item))" />
                    </MudTooltip>
                    <MudTooltip Text="Remove from output" Placement="Placement.Left">
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(() => ConfirmRemoveAsync(context.Item))" />
                    </MudTooltip>
                </CellTemplate>
            </TemplateColumn>
        </Columns>

        <PagerContent>
            <MudDataGridPager T="ChannelListItemDto" PageSizeOptions="@(new[] { 25, 50, 100 })" />
        </PagerContent>

        <NoRecordsContent>
            <MudStack AlignItems="AlignItems.Center" Class="pa-6" Spacing="2">
                <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Size="Size.Large" Color="Color.Secondary" />
                <MudText Color="Color.Secondary">No channels match your filters.</MudText>
            </MudStack>
        </NoRecordsContent>

        <LoadingContent>
            <MudStack AlignItems="AlignItems.Center" Class="pa-6">
                <MudProgressCircular Indeterminate="true" />
            </MudStack>
        </LoadingContent>
    </MudDataGrid>
}

<!-- =========================================================
     Edit Channel Dialog
     ========================================================= -->
<MudDialog @bind-Visible="_editDialogOpen" Options="_editDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Edit Channel</MudText>
    </TitleContent>
    <DialogContent>
        @if (_editChannel is not null)
        {
            <MudStack Spacing="3">
                <MudText Typo="Typo.body1"><strong>@_editChannel.DisplayName</strong></MudText>

                <MudNumericField T="int?"
                                 @bind-Value="_editChannelNumber"
                                 Label="Channel Number"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 HideSpinButtons="true"
                                 Clearable="true"
                                 HelperText="Leave empty to use auto-numbering" />

                <MudSelect T="string"
                           @bind-Value="_editGroupName"
                           Label="Group"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true"
                           HelperText="Override the output group (leave empty for default)">
                    @foreach (var g in _availableGroups)
                    {
                        <MudSelectItem Value="@g">@g</MudSelectItem>
                    }
                </MudSelect>

                <!-- EPG ID override — locked by default -->
                <MudPaper Outlined="true" Class="pa-3">
                    <MudStack Spacing="1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.subtitle2">EPG ID Override</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Provider value: @(_editChannel.TvgId ?? "none")
                                </MudText>
                            </MudStack>
                            <MudTooltip Text="@(_epgIdUnlocked ? "Lock EPG ID override" : "Unlock to set a custom EPG ID")">
                                <MudIconButton Icon="@(_epgIdUnlocked ? Icons.Material.Filled.LockOpen : Icons.Material.Filled.Lock)"
                                               Size="Size.Small"
                                               Color="@(_epgIdUnlocked ? Color.Warning : Color.Default)"
                                               OnClick="ToggleEpgIdLockAsync" />
                            </MudTooltip>
                        </MudStack>

                        @if (_epgIdUnlocked)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1">
                                A custom EPG ID replaces the provider's value in the output. Only set this if you know the exact ID your guide source expects.
                            </MudAlert>
                            <MudTextField @bind-Value="_editTvgIdOverride"
                                          Label="Custom EPG ID"
                                          Placeholder="Leave empty to revert to provider value"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Clearable="true"
                                          HelperText="Applies to the next rebuilt snapshot" />
                        }
                        else
                        {
                            @if (!string.IsNullOrEmpty(_editTvgIdOverride))
                            {
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Outlined"
                                         Icon="@Icons.Material.Filled.Edit">
                                    Override active: @_editTvgIdOverride
                                </MudChip>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">No override — using provider value.</MudText>
                            }
                        }
                    </MudStack>
                </MudPaper>
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseEditDialog" Variant="Variant.Text">Cancel</MudButton>
        <MudButton OnClick="SaveEditAsync"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="_isSaving">
            @(_isSaving ? "Saving…" : "Save")
        </MudButton>
    </DialogActions>
</MudDialog>


@code {
    private MudDataGrid<ChannelListItemDto>? _grid;
    private string _search = string.Empty;
    private string _groupFilter = string.Empty;
    private bool _noSnapshot;
    private int? _total;
    private bool _pendingRebuild;
    private List<string> _availableGroups = [];

    [SupplyParameterFromQuery(Name = "profile")]
    public string? InitialProfile { get; set; }

    private List<ProfileStubDto> _allProfiles = [];
    private string? _profileId;

    // -------------------------------------------------------------------------
    // Edit dialog state
    // -------------------------------------------------------------------------

    private bool _editDialogOpen;
    private ChannelListItemDto? _editChannel;
    private int? _editChannelNumber;
    private string? _editGroupName;
    private string? _editTvgIdOverride;
    private bool _epgIdUnlocked;
    private bool _isSaving;

    private readonly DialogOptions _editDialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        CloseOnEscapeKey = true,
    };

    // -------------------------------------------------------------------------
    // Number Manager state
    // -------------------------------------------------------------------------

    private bool _numberManagerMode;
    private bool _nmLoading;
    private bool _nmSaving;
    private List<NumberManagerChannelDto> _nmChannels = [];
    private readonly HashSet<string> _nmDirty = [];

    protected override async Task OnInitializedAsync()
    {
        _allProfiles = await ProfilesService.GetProfileStubsAsync(CancellationToken.None);
        if (!string.IsNullOrEmpty(InitialProfile) && _allProfiles.Any(p => p.ProfileId == InitialProfile))
            _profileId = InitialProfile;
        else
        {
            _profileId = await ChannelListPageService.GetDefaultProfileIdAsync(CancellationToken.None);
            if (_profileId is null && _allProfiles.Count > 0)
                _profileId = _allProfiles[0].ProfileId;
        }
        await LoadAvailableGroupsAsync();
    }

    private async Task OnProfileChangedAsync(string profileId)
    {
        _profileId = profileId;
        _groupFilter = string.Empty;
        _search = string.Empty;
        _total = null;
        _noSnapshot = false;
        await LoadAvailableGroupsAsync();
        if (_grid is not null)
            await _grid.ReloadServerData();
    }

    private async Task LoadAvailableGroupsAsync()
    {
        if (_profileId is null) return;
        try
        {
            _availableGroups = await ChannelListPageService.GetMappedGroupsAsync(_profileId, CancellationToken.None);
        }
        catch
        {
            _availableGroups = [];
        }
    }

    private void OnSearchChanged(string value)
    {
        _search = value;
    }

    private async Task OnGroupFilterChanged(string value)
    {
        _groupFilter = value ?? string.Empty;
        await ReloadGridAsync();
    }

    private async Task ReloadGridAsync()
    {
        if (_grid is not null)
            await _grid.ReloadServerData();
    }

    private async Task ClearSearchAsync()
    {
        _search = string.Empty;
        if (_grid is not null)
            await _grid.ReloadServerData();
    }

    private async Task<GridData<ChannelListItemDto>> LoadChannelsAsync(GridState<ChannelListItemDto> state, CancellationToken cancellationToken)
    {
        var page = state.Page + 1;

        try
        {
            if (_profileId is null)
                return new GridData<ChannelListItemDto> { Items = [], TotalItems = 0 };

            var result = await ChannelListPageService.GetChannelsAsync(
                _profileId,
                page,
                state.PageSize,
                _search,
                _groupFilter,
                cancellationToken);

            if (result is null)
            {
                await InvokeAsync(() => { _noSnapshot = true; StateHasChanged(); });
                return new GridData<ChannelListItemDto> { Items = [], TotalItems = 0 };
            }
            await InvokeAsync(() =>
            {
                _noSnapshot = false;
                _total = result.Total;
                StateHasChanged();
            });
            return new GridData<ChannelListItemDto> { Items = result.Items, TotalItems = result.Total };
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load channels: {ex.Message}", Severity.Error);
        }

        return new GridData<ChannelListItemDto> { Items = [], TotalItems = 0 };
    }

    // -------------------------------------------------------------------------
    // Edit dialog
    // -------------------------------------------------------------------------

    private async Task OpenEditDialogAsync(ChannelListItemDto channel)
    {
        _editChannel = channel;
        _editChannelNumber = channel.ChannelNumber;
        _editGroupName = channel.GroupTitle;
        _epgIdUnlocked = false;
        _editTvgIdOverride = null;

        try
        {
            _editTvgIdOverride = _profileId is not null
                ? await ChannelListPageService.GetTvgIdOverrideAsync(
                    _profileId, channel.ProviderChannelId, CancellationToken.None)
                : null;
        }
        catch { /* non-fatal */ }

        _editDialogOpen = true;
    }

    private void CloseEditDialog()
    {
        _editDialogOpen = false;
        _editChannel = null;
        _epgIdUnlocked = false;
    }

    private async Task ToggleEpgIdLockAsync()
    {
        if (_epgIdUnlocked)
        {
            // Locking — confirm if they had typed something
            _epgIdUnlocked = false;
        }
        else
        {
            // Unlocking — show confirmation
            var confirmed = await DialogService.ShowMessageBoxAsync(
                "Unlock EPG ID Override",
                "Setting a custom EPG ID replaces the provider's value in your output. " +
                "Only do this if you know the correct ID your guide source expects for this channel. " +
                "An incorrect ID will break guide data for this channel.\n\nProceed?",
                yesText: "Unlock",
                cancelText: "Cancel");

            if (confirmed == true)
                _epgIdUnlocked = true;
        }
    }

    private async Task SaveEditAsync()
    {
        if (_editChannel is null) return;

        _isSaving = true;
        try
        {
            if (_profileId is null) return;

            var request = new UpdateOutputChannelRequest
            {
                ChannelNumber = _editChannelNumber,
                ClearChannelNumber = _editChannelNumber is null,
                OutputGroupName = _editGroupName,
                ClearOutputGroupName = string.IsNullOrWhiteSpace(_editGroupName),
                TvgIdOverride = _epgIdUnlocked ? _editTvgIdOverride : null,
                ClearTvgIdOverride = _epgIdUnlocked && string.IsNullOrWhiteSpace(_editTvgIdOverride),
            };

            var updated = await ChannelListPageService.UpdateOutputChannelAsync(
                _profileId,
                _editChannel.ProviderChannelId,
                request,
                CancellationToken.None);

            if (updated == true)
            {
                Snackbar.Add("Channel updated. Rebuild output to apply changes.", Severity.Success);
                _pendingRebuild = true;
                CloseEditDialog();
                await ReloadGridAsync();
            }
            else if (updated == false)
            {
                Snackbar.Add("Channel not found — it may have been removed already.", Severity.Warning);
            }
            else
            {
                Snackbar.Add("Failed to update channel.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    // -------------------------------------------------------------------------
    // Remove channel
    // -------------------------------------------------------------------------

    private async Task ConfirmRemoveAsync(ChannelListItemDto channel)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Remove Channel",
            $"Remove \"{channel.DisplayName}\" from the output? This will take effect after the next Build Output.",
            yesText: "Remove",
            cancelText: "Cancel");

        if (confirmed != true) return;
        if (_profileId is null) return;

        try
        {
            var removed = await ChannelListPageService.RemoveOutputChannelAsync(_profileId, channel.ProviderChannelId, CancellationToken.None);

            if (removed == true)
            {
                Snackbar.Add($"\"{channel.DisplayName}\" removed. Rebuild output to apply.", Severity.Success);
                _pendingRebuild = true;
                await ReloadGridAsync();
            }
            else if (removed == false)
            {
                Snackbar.Add("Channel not found — it may have been removed already.", Severity.Warning);
                await ReloadGridAsync();
            }
            else
            {
                Snackbar.Add("Failed to remove channel.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    // -------------------------------------------------------------------------
    // Number Manager
    // -------------------------------------------------------------------------

    private async Task EnterNumberManagerAsync()
    {
        _numberManagerMode = true;
        _nmDirty.Clear();
        _nmLoading = true;
        _nmChannels = [];

        try
        {
            _nmChannels = _profileId is not null
                ? await ChannelListPageService.GetNumberManagerChannelsAsync(_profileId, CancellationToken.None)
                : [];
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load channels: {ex.Message}", Severity.Error);
        }
        finally
        {
            _nmLoading = false;
        }
    }

    private void ExitNumberManager()
    {
        _numberManagerMode = false;
        _nmDirty.Clear();
    }

    private void NmSetNumber(NumberManagerChannelDto channel, int? value)
    {
        channel.ChannelNumber = value;
        _nmDirty.Add(channel.ProviderChannelId);
        NmSort();
    }

    private void NmMoveUp(int idx)
    {
        if (idx <= 0 || idx >= _nmChannels.Count) return;
        var ch = _nmChannels[idx];
        var above = _nmChannels[idx - 1];
        (ch.ChannelNumber, above.ChannelNumber) = (above.ChannelNumber, ch.ChannelNumber);
        _nmDirty.Add(ch.ProviderChannelId);
        _nmDirty.Add(above.ProviderChannelId);
        NmSort();
    }

    private void NmMoveDown(int idx)
    {
        if (idx < 0 || idx >= _nmChannels.Count - 1) return;
        var ch = _nmChannels[idx];
        var below = _nmChannels[idx + 1];
        (ch.ChannelNumber, below.ChannelNumber) = (below.ChannelNumber, ch.ChannelNumber);
        _nmDirty.Add(ch.ProviderChannelId);
        _nmDirty.Add(below.ProviderChannelId);
        NmSort();
    }

    private void NmSort()
    {
        _nmChannels.Sort((a, b) =>
        {
            if (a.ChannelNumber is null && b.ChannelNumber is null)
                return string.Compare(a.DisplayName, b.DisplayName, StringComparison.Ordinal);
            if (a.ChannelNumber is null) return 1;
            if (b.ChannelNumber is null) return -1;
            var cmp = a.ChannelNumber.Value.CompareTo(b.ChannelNumber.Value);
            return cmp != 0 ? cmp : string.Compare(a.DisplayName, b.DisplayName, StringComparison.Ordinal);
        });
        // Force re-render by replacing the list reference
        _nmChannels = [.. _nmChannels];
    }

    private async Task NmApplyAllAsync()
    {
        if (_nmDirty.Count == 0) return;

        _nmSaving = true;
        try
        {
            var request = new BulkChannelNumbersRequest
            {
                Channels = _nmChannels
                    .Where(c => _nmDirty.Contains(c.ProviderChannelId))
                    .Select(c => new BulkChannelNumberItem
                    {
                        ProviderChannelId = c.ProviderChannelId,
                        ChannelNumber = c.ChannelNumber,
                    })
                    .ToList(),
            };

            if (_profileId is null) return;
            var ok = await ChannelListPageService.BulkUpdateChannelNumbersAsync(_profileId, request, CancellationToken.None);

            if (ok)
            {
                _nmDirty.Clear();
                _pendingRebuild = true;
                Snackbar.Add("Channel numbers updated. Rebuild output to apply changes.", Severity.Success);
                StateHasChanged();
            }
            else
            {
                Snackbar.Add("Failed to update channel numbers.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _nmSaving = false;
        }
    }
}
