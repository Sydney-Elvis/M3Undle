    private async Task ToggleDecisionAsync(GroupFilterDto filter, string decision)
    {
        var newDecision = string.Equals(filter.Decision, decision, StringComparison.OrdinalIgnoreCase)
            ? LineupReviewSemantics.GroupDecisionInclude
            : decision;
        await SetDecisionAsync(filter, newDecision);
    }

    private async Task SetDecisionAsync(GroupFilterDto filter, string decision)
    {
        if (_profileId is null) return;

        var filterId = filter.ProfileGroupFilterId;
        _busyFilters.Add(filterId);
        StateHasChanged();

        try
        {
            var req = new UpdateGroupFilterRequest { Decision = decision };
            var updated = await ChannelMappingPageService.UpdateGroupFilterAsync(_profileId, filterId, req, _cts.Token);
            if (!updated)
            {
                Snackbar.Add("Failed to update group.", Severity.Error);
                return;
            }

            filter.Decision = decision;
            filter.IsNew = false;
            _sessionChangedFilterIds.Add(filterId);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busyFilters.Remove(filterId);
            StateHasChanged();
        }
    }

    private async Task BulkSetDecisionForVisibleAsync(string decision)
    {
        if (_profileId is null) return;

        var groupIds = FilteredItems.SelectMany(item => item switch
        {
            GroupFilterDto f => (IEnumerable<string>)[f.ProviderGroupId],
            VirtualParent p  => p.Members.Select(m => m.ProviderGroupId),
            _                => [],
        }).Distinct().ToList();

        if (groupIds.Count == 0) return;

        _isBulkBusy = true;
        StateHasChanged();

        try
        {
            var req = new BulkGroupDecisionRequest { Decision = decision, ProviderGroupIds = groupIds };
            var updated = await ChannelMappingPageService.BulkDecideAsync(
                _profileId,
                req.Decision,
                req.ProviderGroupIds,
                _cts.Token);

            if (updated <= 0)
            {
                Snackbar.Add("Bulk update failed.", Severity.Error);
                return;
            }

            var groupIdSet = new HashSet<string>(groupIds, StringComparer.Ordinal);
            foreach (var f in _allFilters.Where(f => groupIdSet.Contains(f.ProviderGroupId)))
            {
                f.Decision = decision;
                f.IsNew = false;
                _sessionChangedFilterIds.Add(f.ProfileGroupFilterId);
            }

            RebuildDisplayOrder();
            Snackbar.Add($"{groupIds.Count} group(s) set to {decision}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isBulkBusy = false;
            StateHasChanged();
        }
    }

    private async Task SelectAllVisibleChannelsAsync()
    {
        if (_profileId is null) return;

        _isBulkBusy = true;
        StateHasChanged();

        try
        {
            var allFilterIds = FilteredItems.SelectMany(item => item switch
            {
                GroupFilterDto f when !IsExcluded(f) && IsManualMode(f) => (IEnumerable<string>)[f.ProfileGroupFilterId],
                VirtualParent p => p.Members.Where(m => !IsExcluded(m) && IsManualMode(m)).Select(m => m.ProfileGroupFilterId),
                _ => [],
            }).Distinct().ToList();

            var used = GetAssignedNumbers(exceptFilterIds: allFilterIds);
            var next = NextUnused(_defaultStartNum, used);

            foreach (var filterId in allFilterIds)
            {
                if (!_channelCache.ContainsKey(filterId))
                    await LoadChannelsAsync(filterId);

                if (!_channelCache.TryGetValue(filterId, out var channels)) continue;

                var freshSelections = new Dictionary<string, bool>();
                var freshNumbers    = new Dictionary<string, int?>();
                foreach (var ch in channels)
                {
                    freshSelections[ch.ProviderChannelId] = true;
                    freshNumbers[ch.ProviderChannelId]    = next = NextUnused(next, used);
                    next++;
                }
                _channelSelections[filterId] = freshSelections;
                _channelNumbers[filterId]    = freshNumbers;
            }

            RebuildNumberIndex();
            StateHasChanged();

            var clearedNew = false;
            foreach (var filterId in allFilterIds)
                clearedNew |= MarkChannelSelectionsDirty(filterId);

            if (clearedNew)
                StateHasChanged();

            await DebounceDirtyChannelSelectionSaveAsync();
        }
        finally
        {
            _isBulkBusy = false;
            StateHasChanged();
        }
    }

    private async Task DeselectAllVisibleChannelsAsync()
    {
        var filterIds = FilteredItems.SelectMany(item => item switch
        {
            GroupFilterDto f when !IsExcluded(f) && IsManualMode(f) => (IEnumerable<string>)[f.ProfileGroupFilterId],
            VirtualParent p => p.Members.Where(m => !IsExcluded(m) && IsManualMode(m)).Select(m => m.ProfileGroupFilterId),
            _ => [],
        }).Where(id => _channelSelections.ContainsKey(id)).Distinct().ToList();

        foreach (var filterId in filterIds)
        {
            if (_channelCache.TryGetValue(filterId, out var channels))
            {
                _channelSelections[filterId] = channels.ToDictionary(c => c.ProviderChannelId, _ => false);
                _channelNumbers[filterId] = [];
            }
        }

        RebuildNumberIndex();
        StateHasChanged();

        var clearedNew = false;
        foreach (var filterId in filterIds)
            clearedNew |= MarkChannelSelectionsDirty(filterId);

        if (clearedNew)
            StateHasChanged();

        await DebounceDirtyChannelSelectionSaveAsync();
    }

