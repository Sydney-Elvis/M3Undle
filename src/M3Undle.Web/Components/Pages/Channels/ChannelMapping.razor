    private async Task ToggleCgExpandAsync(CustomGroupDto cg)
    {
        if (!_cgExpanded.Remove(cg.CustomGroupId))
        {
            _cgExpanded.Add(cg.CustomGroupId);
            await LoadCgChannelsAsync(cg);
        }
    }

    private async Task ToggleCgLinksExpandedAsync(CustomGroupDto cg)
    {
        if (!_cgLinksExpanded.Remove(cg.CustomGroupId))
        {
            _cgLinksExpanded.Add(cg.CustomGroupId);
            await LoadCgLinksAsync(cg);
        }
    }

    private async Task LoadCgChannelsAsync(CustomGroupDto cg)
    {
        if (_profileId is null) return;
        var channels = await CustomGroupService.ListChannelsAsync(_profileId, cg.CustomGroupId, _cts.Token);
        _cgChannelCache[cg.CustomGroupId] = channels;
        StateHasChanged();
    }

    private async Task LoadCgLinksAsync(CustomGroupDto cg)
    {
        if (_profileId is null) return;
        var links = await CustomGroupService.ListProviderLinksAsync(_profileId, cg.CustomGroupId, _cts.Token);
        _cgLinksCache[cg.CustomGroupId] = links;
        StateHasChanged();
    }

    private async Task OnCgNewNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_cgNewName))
            await CommitCreateCustomGroupAsync();
        else if (e.Key == "Escape")
        {
            _cgCreating = false;
            _cgNewName = string.Empty;
        }
    }

    private async Task CommitCreateCustomGroupAsync()
    {
        if (_profileId is null || string.IsNullOrWhiteSpace(_cgNewName)) return;
        var result = await CustomGroupService.CreateAsync(_profileId, _cgNewName.Trim(), _cts.Token);
        if (result is not null)
        {
            _customGroups.Add(result);
            RebuildDisplayOrder();
            Snackbar.Add($"Custom group \"{result.Name}\" created.", Severity.Success);
        }
        _cgCreating = false;
        _cgNewName = string.Empty;
        StateHasChanged();
    }

    private void StartRenameCg(CustomGroupDto cg)
    {
        _cgEditingId = cg.CustomGroupId;
        _cgEditName = cg.Name;
    }

    private async Task CommitRenameCgAsync(CustomGroupDto cg)
    {
        if (_profileId is null || string.IsNullOrWhiteSpace(_cgEditName)) return;
        var req = new UpdateCustomGroupRequest { Name = _cgEditName.Trim() };
        var ok = await CustomGroupService.UpdateAsync(_profileId, cg.CustomGroupId, req, _cts.Token);
        if (ok)
        {
            var idx = _customGroups.FindIndex(g => g.CustomGroupId == cg.CustomGroupId);
            if (idx >= 0)
                _customGroups[idx] = _customGroups[idx] with { Name = _cgEditName.Trim() };
            RebuildDisplayOrder();
        }
        _cgEditingId = null;
        _cgEditName = string.Empty;
        StateHasChanged();
    }

    private async Task SetCgDecisionAsync(CustomGroupDto cg, string decision)
    {
        if (_profileId is null) return;
        _cgBusy.Add(cg.CustomGroupId);
        StateHasChanged();
        try
        {
            var req = new UpdateCustomGroupRequest { Decision = decision };
            var ok = await CustomGroupService.UpdateAsync(_profileId, cg.CustomGroupId, req, _cts.Token);
            if (ok)
            {
                var idx = _customGroups.FindIndex(g => g.CustomGroupId == cg.CustomGroupId);
                if (idx >= 0)
                    _customGroups[idx] = _customGroups[idx] with { Decision = decision };
            }
        }
        finally
        {
            _cgBusy.Remove(cg.CustomGroupId);
            StateHasChanged();
        }
    }

    private async Task OnCgModeChangedAsync(CustomGroupDto cg, string mode)
    {
        if (_profileId is null) return;
        var req = new UpdateCustomGroupRequest { ChannelMode = mode };
        var ok = await CustomGroupService.UpdateAsync(_profileId, cg.CustomGroupId, req, _cts.Token);
        if (ok)
        {
            var idx = _customGroups.FindIndex(g => g.CustomGroupId == cg.CustomGroupId);
            if (idx >= 0)
                _customGroups[idx] = _customGroups[idx] with { ChannelMode = mode };
        }
        StateHasChanged();
    }

