@page "/channels/mapping"
@using M3Undle.Web.Application
@using M3Undle.Web.Contracts
@using System
@using System.Text.RegularExpressions
@inject ChannelMappingPageService ChannelMappingPageService
@inject CustomGroupPageService CustomGroupService
@inject ProfilesPageService ProfilesService
@inject AppEventBus EventBus
@inject IRefreshTrigger RefreshTrigger
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>M3Undle — Channel Mapping</PageTitle>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">Channel Mapping</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Review group decisions, choose manual vs auto-update mode, and manage notification noise.</MudText>
        </MudStack>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            @if (_allProfiles.Count > 0)
            {
                <MudSelect T="string"
                           Value="_profileId"
                           ValueChanged="OnProfileChangedAsync"
                           Label="Profile"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Style="min-width:160px;"
                           AnchorOrigin="Origin.BottomLeft">
                    @foreach (var p in _allProfiles)
                    {
                        <MudSelectItem Value="@p.ProfileId">@p.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudNumericField T="int"
                             @bind-Value="_defaultStartNum"
                             Label="Start at #"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             HideSpinButtons="true"
                             Style="width:100px;"
                             DebounceInterval="600"
                             Immediate="true"
                             OnDebounceIntervalElapsed="SaveDefaultStartNumAsync" />
            <MudTooltip Text="Reload channel mapping data" Arrow="true">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="LoadAsync" Disabled="_isLoading" />
            </MudTooltip>
            <MudButton StartIcon="@Icons.Material.Filled.LiveTv"
                       Variant="Variant.Outlined"
                       Color="Color.Default"
                       Size="Size.Small"
                       Href="@($"channels{(_profileId is not null ? $"?profile={_profileId}" : "")}")">
                View Channels
            </MudButton>
            <MudButton StartIcon="@Icons.Material.Filled.Publish"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Small"
                       OnClick="BuildSnapshotAsync"
                       Disabled="@(_isRefreshing || _profileId is null)">
                @(_isRefreshing ? "Building…" : "Build Output")
            </MudButton>
        </MudStack>
    </MudStack>
</MudPaper>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_error</MudAlert>
}

@if (_isRefreshing)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="mb-4" Icon="@Icons.Material.Filled.Sync">
        A snapshot is currently being built. Groups are shown for configuration, but output will not be updated until the build completes.
    </MudAlert>
}

@if (_profileId is null && !_isLoading)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        No active profile found. Go to <MudLink Href="profiles">Profiles</MudLink> to set one active.
    </MudAlert>
}
else
{
    <!-- Search toolbar -->
    <MudPaper Elevation="2" Class="mb-2 pa-2" Style="position:sticky; top:var(--mud-appbar-height, 64px); z-index:100; background:var(--mud-palette-surface); border:1px solid var(--mud-palette-divider); border-radius:4px;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
            <MudTextField T="string"
                          Value="_searchTerm"
                          ValueChanged="OnSearchTermChanged"
                          Placeholder="Filter groups…  e.g.  CA   CA*   *CA*   ^LOCAL   !*USA*"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(!string.IsNullOrEmpty(_searchTerm) ? Icons.Material.Filled.Clear : Icons.Material.Filled.Search)"
                          OnAdornmentClick="ClearSearch"
                          Margin="Margin.Dense"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Style="min-width:300px; flex:1; max-width:520px;" />
            <MudTooltip Placement="Placement.Right" Arrow="true"
                        Text="CA=whole word | CA*=starts | *CA=ends | *CA*=contains | ^CA=str start | [CB]A=char class | !CA=negate | space=OR terms">
                <MudIconButton Icon="@Icons.Material.Filled.HelpOutline" Size="Size.Small" Color="Color.Secondary" />
            </MudTooltip>
            @if (!string.IsNullOrEmpty(_searchError))
            {
                <MudText Typo="Typo.caption" Color="Color.Error">@_searchError</MudText>
            }
            <MudDivider Vertical="true" FlexItem="true" />
            <MudTextField T="string"
                          Value="_globalChannelFilter"
                          ValueChanged="OnGlobalChannelFilterChanged"
                          Placeholder="Search channels across all groups…"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(!string.IsNullOrEmpty(_globalChannelFilter) ? Icons.Material.Filled.Clear : Icons.Material.Filled.ManageSearch)"
                          OnAdornmentClick="@(() => OnGlobalChannelFilterChanged(string.Empty))"
                          Margin="Margin.Dense"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Style="min-width:260px; flex:1; max-width:460px;" />
            @if (_globalChannelSearchBusy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            }
            @if (_globalChannelSearchResults.Count > 0)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                    @_globalChannelSearchResults.Count group@(_globalChannelSearchResults.Count != 1 ? "s" : "") matched
                </MudChip>
            }
            @if (_isBulkBusy)
            {
                <MudDivider Vertical="true" FlexItem="true" />
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                <MudText Typo="Typo.caption" Color="Color.Primary" Style="white-space:nowrap;">Updating…</MudText>
            }
            else if (!_isLoading && FilteredItems.Count > 0)
            {
                <MudDivider Vertical="true" FlexItem="true" />
                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="white-space:nowrap;">@FilteredItems.Count groups:</MudText>
                <MudTooltip Text="Select all channels in visible groups" Arrow="true" Placement="Placement.Bottom">
                    <MudLink Typo="Typo.caption" OnClick="SelectAllVisibleChannelsAsync" Style="cursor:pointer;">All</MudLink>
                </MudTooltip>
                <MudTooltip Text="Deselect all channels in visible groups" Arrow="true" Placement="Placement.Bottom">
                    <MudLink Typo="Typo.caption" OnClick="DeselectAllVisibleChannelsAsync" Style="cursor:pointer;">None</MudLink>
                </MudTooltip>
                @if (_globalChannelSearchResults.Count == 0)
                {
                    <MudTooltip Text="Exclude all visible groups from output" Arrow="true" Placement="Placement.Bottom">
                        <MudLink Typo="Typo.caption" Color="Color.Error"
                                 OnClick="@(() => BulkSetDecisionForVisibleAsync("exclude"))"
                                 Style="cursor:pointer;">Exclude</MudLink>
                    </MudTooltip>
                }
            }
        </MudStack>
    </MudPaper>

    <!-- Summary chips -->
    @if (!_isLoading && _profileId is not null)
    {
        var cgLinkedGroupIds = _customGroups
            .SelectMany(cg => cg.LinkedProviderGroupIds)
            .ToHashSet(StringComparer.Ordinal);

        var liveFilters = _allFilters
            .Where(f => f.ProviderGroupContentType == "live" && !cgLinkedGroupIds.Contains(f.ProviderGroupId))
            .ToList();

        // Standalone: no OutputName. VirtualParent members: share an OutputName.
        var standaloneFilters = liveFilters.Where(f => f.OutputName is null).ToList();
        var vpGroups = liveFilters
            .Where(f => f.OutputName is not null)
            .GroupBy(f => f.OutputName!, StringComparer.OrdinalIgnoreCase)
            .ToList();

        // Standalone counts
        var standaloneMapped   = standaloneFilters.Where(f => IsIncluded(f) && GetSelectedChannelCount(f) > 0).ToList();
        var standaloneUnmapped = standaloneFilters.Where(IsUnmappedBySelection).ToList();
        var standaloneExcluded = standaloneFilters.Where(IsExcluded).ToList();
        var standaloneNew      = standaloneFilters.Count(f => f.IsNew);
        var standaloneChSelected = standaloneMapped.Sum(GetSelectedChannelCount);

        // VirtualParent counts — each unique OutputName = 1 logical group
        var vpMapped   = vpGroups.Count(g => g.Any(f => IsIncluded(f) && GetSelectedChannelCount(f) > 0));
        var vpUnmapped = vpGroups.Count(g => g.Any(IsIncluded) && !g.Any(f => IsIncluded(f) && GetSelectedChannelCount(f) > 0));
        var vpExcluded = vpGroups.Count(g => g.All(IsExcluded));
        var vpNew      = vpGroups.Count(g => g.Any(f => f.IsNew));
        var vpChSelected = vpGroups
            .Where(g => g.Any(f => IsIncluded(f) && GetSelectedChannelCount(f) > 0))
            .Sum(g => g.Where(IsIncluded).Sum(GetSelectedChannelCount));

        // Custom group counts
        var cgMapped   = _customGroups.Count(cg => IsCgIncluded(cg) && cg.SelectedChannelCount > 0);
        var cgUnmapped = _customGroups.Count(cg => IsCgIncluded(cg) && cg.SelectedChannelCount == 0);
        var cgExcluded = _customGroups.Count(IsCgExcluded);
        var cgChSelected = _customGroups
            .Where(cg => IsCgIncluded(cg) && cg.SelectedChannelCount > 0)
            .Sum(cg => cg.SelectedChannelCount);

        // Removed = included groups no longer present in the provider feed
        var standaloneRemoved = standaloneFilters.Count(f => IsIncluded(f) && !f.ProviderGroupActive);
        var vpRemoved = vpGroups.Count(g => g.Any(f => IsIncluded(f) && !f.ProviderGroupActive));
        var removedCount = standaloneRemoved + vpRemoved;

        var totalMapped     = standaloneMapped.Count + vpMapped + cgMapped;
        var totalUnmapped   = standaloneUnmapped.Count + vpUnmapped + cgUnmapped;
        var totalExcluded   = standaloneExcluded.Count + vpExcluded + cgExcluded;
        var newCount        = standaloneNew + vpNew;
        var totalChSelected = standaloneChSelected + vpChSelected + cgChSelected;

        <MudStack Row="true" Spacing="1" Class="mb-2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
            <ChipFilterToggle Label="@($"{totalMapped} mapped · {totalChSelected:N0} ch used")"
                              Color="Color.Success"
                              IsActive="@_decisionFilterStates.Contains("used")"
                              TooltipText="Included groups with selected channels. Click to toggle this filter."
                              OnClick="@((_) => ToggleDecisionFilterState("used"))" />
            <ChipFilterToggle Label="@($"{totalUnmapped} unmapped")"
                              Color="Color.Warning"
                              IsActive="@_decisionFilterStates.Contains("unmapped")"
                              TooltipText="Included groups with zero selected channels. Click to filter them."
                              OnClick="@((_) => ToggleDecisionFilterState("unmapped"))" />
            <ChipFilterToggle Label="@($"{totalExcluded} excluded")"
                              Color="Color.Default"
                              IsActive="@_decisionFilterStates.Contains("exclude")"
                              TooltipText="Excluded groups. Click to toggle this filter."
                              OnClick="@((_) => ToggleDecisionFilterState("exclude"))" />
            @if (newCount > 0)
            {
                <MudDivider Vertical="true" FlexItem="true" />
                <ChipFilterToggle Label="@($"{newCount} new")"
                                  Color="Color.Info"
                                  IsActive="@_decisionFilterStates.Contains("new")"
                                  TooltipText="Groups added since last sync. Click to toggle this filter."
                                  OnClick="@((_) => ToggleDecisionFilterState("new"))" />
                <MudTooltip Text="Dismiss all new flags" Arrow="true">
                    <MudIconButton Icon="@Icons.Material.Filled.DoneAll"
                                   Size="Size.Small"
                                   Color="Color.Info"
                                   OnClick="DismissAllNewAsync"
                                   Disabled="@(_isBulkBusy || _busyFilters.Count > 0)" />
                </MudTooltip>
            }
            @if (removedCount > 0)
            {
                @if (newCount == 0) { <MudDivider Vertical="true" FlexItem="true" /> }
                <ChipFilterToggle Label="@($"{removedCount} removed")"
                                  Color="Color.Error"
                                  IsActive="@_decisionFilterStates.Contains("removed")"
                                  TooltipText="Included groups no longer present in the provider feed. Click to toggle this filter."
                                  OnClick="@((_) => ToggleDecisionFilterState("removed"))" />
            }
        </MudStack>
    }

    <!-- Custom group creation -->
    @if (_profileId is not null)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.FolderSpecial" Size="Size.Small" Color="Color.Secondary" />
            <MudText Typo="Typo.caption" Color="Color.Secondary">Custom Groups</MudText>
            <MudSpacer />
            @if (_cgCreating)
            {
                <MudTextField T="string"
                              @bind-Value="_cgNewName"
                              Placeholder="Group name…"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Style="min-width:160px; max-width:240px;"
                              @onkeydown="OnCgNewNameKeyDown" />
                <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success"
                               OnClick="CommitCreateCustomGroupAsync" Disabled="@(string.IsNullOrWhiteSpace(_cgNewName))" />
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                               OnClick="@(() => { _cgCreating = false; _cgNewName = string.Empty; })" />
            }
            else
            {
                <MudTooltip Text="Create custom group" Arrow="true">
                    <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline" Size="Size.Small"
                                   OnClick="@(() => _cgCreating = true)" Disabled="@(_profileId is null)" />
                </MudTooltip>
            }
        </MudStack>
    }

    @if (_isLoading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_allFilters.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            <MudText Typo="Typo.body2" Class="mb-1">No groups found for this profile. To get started:</MudText>
            <ol style="margin:0; padding-left:20px;">
                <li>Go to <MudLink Href="providers">Providers</MudLink> and edit a provider to associate this profile (if not already linked).</li>
                <li>Click <strong>Refresh Lineup</strong> in the sidebar to fetch provider data and populate groups.</li>
            </ol>
        </MudAlert>
    }
    else if (FilteredItems.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No groups match your filter.</MudAlert>
    }
    else
    {
        @foreach (var item in FilteredItems)
        {
            @if (item is GroupFilterDto filter)
            {
                <!-- Standalone group row -->
                var filterId   = filter.ProfileGroupFilterId;
                var isExcluded = IsExcluded(filter);
                var isAutoMode = IsAutoMode(filter);
                var trackingPolicy = LineupReviewSemantics.NormalizeTrackingPolicy(filter.TrackingPolicy);
                var isAutoAddMatchingPolicy = string.Equals(
                    trackingPolicy,
                    LineupReviewSemantics.TrackingPolicyAutoAddMatching,
                    StringComparison.OrdinalIgnoreCase);
                var isAutoAddPopulatedPolicy = string.Equals(
                    trackingPolicy,
                    LineupReviewSemantics.TrackingPolicyAutoAddPopulated,
                    StringComparison.OrdinalIgnoreCase);
                var isAdvancedOpen = _advancedPanelOpen.Contains(filterId);
                var isExpanded = _expandedGroups.Contains(filterId);
                var chLoading  = _loadingChannels.Contains(filterId);
                var isEditing  = _editingFilterId == filterId;
                var rowStyle   = isExcluded ? "opacity:0.55;" : string.Empty;
                var displayName = filter.OutputName ?? filter.ProviderGroupRawName;

                <MudPaper Elevation="1" Class="mb-1 pa-2" Style="@rowStyle">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">

                        <!-- Group name: display or edit mode -->
                        @if (isEditing)
                        {
                            <div style="display:inline-flex; align-items:center; gap:4px;">
                                <MudAutocomplete T="string"
                                    Value="@_editNameText"
                                    ValueChanged="@(v => _editNameText = v ?? string.Empty)"
                                    SearchFunc="SearchOutputNamesAsync"
                                    CoerceValue="true"
                                    Clearable="true"
                                    ResetValueOnEmptyText="true"
                                    Variant="Variant.Outlined"
                                    Margin="Margin.Dense"
                                    Dense="true"
                                    Immediate="true"
                                    Style="min-width:140px; max-width:240px;"
                                    Placeholder="Output name…" />
                                <MudTooltip Text="Confirm" Arrow="true">
                                    <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success"
                                                   OnClick="@(() => CommitEditAsync(filter))" />
                                </MudTooltip>
                                <MudTooltip Text="Cancel" Arrow="true">
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                   OnClick="CancelEdit" />
                                </MudTooltip>
                            </div>
                            <MudSpacer />
                        }
                        else
                        {
                            <!-- Name, edit button, and badges — flex:1 so Start # aligns with other row types -->
                            <div style="flex:1; min-width:0; display:flex; align-items:center; gap:4px; flex-wrap:wrap;">
                                <div style="display:inline-flex; align-items:center; gap:2px;">
                                    <MudStack Spacing="0" Style="min-width:120px; cursor:pointer;" @onclick="@(() => ToggleExpandAsync(filter))">
                                        <MudText Typo="Typo.body1" Style="@($"font-weight:{(!isExcluded ? "600" : "400")};")">
                                            @displayName
                                        </MudText>
                                        @if (filter.OutputName is not null)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Tertiary">
                                                @filter.ProviderGroupRawName · @filter.ProviderName
                                            </MudText>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @filter.ProviderName
                                            </MudText>
                                        }
                                    </MudStack>

                                    <!-- Rename / merge button -->
                                    <MudTooltip Text="@(filter.OutputName is not null ? "Rename or merge into another group" : "Rename or merge into a group")" Arrow="true">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                       Size="Size.Small"
                                                       Color="@(filter.OutputName is not null ? Color.Primary : Color.Default)"
                                                       OnClick="@(() => BeginEdit(filterId, filter.OutputName ?? string.Empty))" />
                                    </MudTooltip>
                                </div>

                                @if (!filter.ProviderGroupActive)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">missing</MudChip>
                                }
                                @if (filter.IsNew)
                                {
                                    <MudTooltip Text="New since last sync — click to dismiss" Arrow="true">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
                                                 Style="cursor:pointer;"
                                                 OnClick="@(() => DismissNewAsync(filter))">new</MudChip>
                                    </MudTooltip>
                                }
                            </div>
                        }

                        @if (!isEditing)
                        {
                        <!-- Start # -->
                        <MudNumericField T="int?"
                                         Value="@filter.AutoNumStart"
                                         ValueChanged="@(v => OnAutoNumStartChanged(filter, v))"
                                         Label="Start #"
                                         Placeholder="—"
                                         Margin="Margin.Dense"
                                         Variant="Variant.Outlined"
                                         Disabled="@isExcluded"
                                         HideSpinButtons="true"
                                         Style="width:72px;"
                                         DebounceInterval="800"
                                         Immediate="true" />
                        <!-- Channel count (always n/n), to the right of Start # -->
                        <MudTooltip Text="@GetChannelCountTooltipText(filter, filterId)" Arrow="true" Placement="Placement.Top">
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="min-width:64px; text-align:right; cursor:default;">
                                @GetChannelCountText(filter, filterId)
                            </MudText>
                        </MudTooltip>

                        <!-- Exclude button -->
                        <MudTooltip Text="@(isExcluded ? "Remove exclusion" : "Exclude group")" Arrow="true">
                            <MudIconButton Icon="@(isExcluded ? Icons.Material.Filled.Block : Icons.Material.Outlined.Block)"
                                           Size="Size.Small"
                                           Color="@(isExcluded ? Color.Error : Color.Default)"
                                           OnClick="@(() => ToggleDecisionAsync(filter, "exclude"))"
                                           Disabled="_busyFilters.Contains(filterId)" />
                        </MudTooltip>

                        <!-- Settings drawer button -->
                        <MudTooltip Text="Group settings" Arrow="true">
                            <MudIconButton Icon="@Icons.Material.Filled.Tune"
                                           Size="Size.Small"
                                           Color="@GetSettingsButtonColor(filter.TrackingPolicy, filter.TrackingKeywords, filterId)"
                                           OnClick="@(() => OpenSettingsDrawer(filterId, SettingsTargetKind.Standalone))" />
                        </MudTooltip>
                        }

                        <!-- Expand button -->
                        <MudIconButton Icon="@(isExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                       Size="Size.Small"
                                       OnClick="@(() => ToggleExpandAsync(filter))" />

                    </MudStack>

                    <!-- Inline channel panel -->
                    @if (isExpanded)
                    {
                        <MudDivider Class="mt-2 mb-2" />

                        @if (chLoading)
                        {
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mt-1" />
                        }
                        else if (_channelCache.TryGetValue(filterId, out var channels))
                        {
                            var globalActive = _globalChannelSearchResults.Count > 0;
                            var filterText   = globalActive ? string.Empty : _groupChannelFilter.GetValueOrDefault(filterId, string.Empty);
                            var filtered     = GetFilteredGroupChannels(filterId, channels, globalActive, filterText);
                            var selections   = _channelSelections.GetValueOrDefault(filterId) ?? [];

                            @if (!globalActive)
                            {
                            <!-- Filter bar -->
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2" Wrap="Wrap.Wrap">
                                <MudTextField T="string"
                                              Value="@filterText"
                                              ValueChanged="@(v => { _groupChannelFilter[filterId] = v; StateHasChanged(); })"
                                              Placeholder="Filter channels…"
                                              Adornment="Adornment.End"
                                              AdornmentIcon="@(string.IsNullOrEmpty(filterText) ? Icons.Material.Filled.FilterList : Icons.Material.Filled.Clear)"
                                              OnAdornmentClick="@(() => { _groupChannelFilter[filterId] = string.Empty; StateHasChanged(); })"
                                              Margin="Margin.Dense"
                                              Variant="Variant.Outlined"
                                              Immediate="true"
                                              Style="min-width:180px;" />

                                @if (_savedChannelFilters.Count > 0)
                                {
                                    <MudSelect T="string"
                                               Value="@filterText"
                                               ValueChanged="@(v => { _groupChannelFilter[filterId] = v; StateHasChanged(); })"
                                               Placeholder="Saved presets"
                                               Margin="Margin.Dense"
                                               Variant="Variant.Outlined"
                                               Dense="true"
                                               Style="min-width:140px;">
                                        @foreach (var preset in _savedChannelFilters)
                                        {
                                            <MudSelectItem T="string" Value="@preset">@preset</MudSelectItem>
                                        }
                                    </MudSelect>
                                }

                                @if (!string.IsNullOrWhiteSpace(filterText) && !_savedChannelFilters.Contains(filterText, StringComparer.OrdinalIgnoreCase))
                                {
                                    <MudTooltip Text="Save this filter as a preset" Arrow="true">
                                        <MudIconButton Icon="@Icons.Material.Filled.Save"
                                                       Size="Size.Small"
                                                       Color="Color.Primary"
                                                       OnClick="@(() => SaveChannelFilterPresetAsync(filterText))" />
                                    </MudTooltip>
                                }

                                @if (!isExcluded && !isAutoMode)
                                {
                                    <MudDivider Vertical="true" FlexItem="true" />
                                    <MudLink Typo="Typo.caption" OnClick="@(() => SelectAllChannelsAsync(filter))" Style="cursor:pointer;">All</MudLink>
                                    <MudLink Typo="Typo.caption" OnClick="@(() => DeselectAllChannelsAsync(filterId))" Style="cursor:pointer;">None</MudLink>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @GetSelectedChannelCount(filter) of @channels.Count selected
                                    </MudText>
                                }
                                else if (!isExcluded && isAutoMode)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Auto-update mode</MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@channels.Count channels</MudText>
                                }
                            </MudStack>
                            }
                            @if (globalActive && !isExcluded && !isAutoMode)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2" Wrap="Wrap.Wrap">
                                    <MudLink Typo="Typo.caption" OnClick="@(() => SelectAllChannelsAsync(filter))" Style="cursor:pointer;">All</MudLink>
                                    <MudLink Typo="Typo.caption" OnClick="@(() => DeselectAllChannelsAsync(filterId))" Style="cursor:pointer;">None</MudLink>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @GetSelectedChannelCount(filter) of @channels.Count selected
                                    </MudText>
                                </MudStack>
                            }

                            <!-- Channel list -->
                            @if (channels.Count == 0)
                            {
                                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                                    No channel data yet — trigger a refresh to populate.
                                </MudAlert>
                            }
                            else
                            {
                                <div style="max-height:400px; overflow-y:auto;">
                                    <Virtualize Items="@filtered" Context="ch" ItemSize="36" OverscanCount="3">
                                        @{
                                        var isSelected  = selections.GetValueOrDefault(ch.ProviderChannelId);
                                        var numEntry    = _channelNumbers.GetValueOrDefault(filterId)?.GetValueOrDefault(ch.ProviderChannelId);
                                        var conflictMsg = isSelected && numEntry.HasValue &&
                                            _numberIndex.TryGetValue(numEntry.Value, out var usedBy) &&
                                            (usedBy.FilterId != filterId || usedBy.ChannelId != ch.ProviderChannelId)
                                                ? $"#{numEntry.Value} already used by {usedBy.Description}" : null;
                                        }

                                        <div style="display:flex; align-items:center; gap:8px; border-bottom:1px solid var(--mud-palette-divider); padding:2px 0;">
                                            @if (!isExcluded && !isAutoMode)
                                            {
                                                <MudCheckBox T="bool"
                                                             Value="@isSelected"
                                                             ValueChanged="@(v => OnChannelChecked(filter, ch.ProviderChannelId, v))"
                                                             Size="Size.Small"
                                                             Dense="true" />
                                            }
                                            <MudText Typo="Typo.body2" Style="flex:1;">@ch.DisplayName</MudText>
                                            @if (!ch.Active)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">gone</MudChip>
                                            }
                                            @if (!isExcluded && !isAutoMode && isSelected)
                                            {
                                                <MudNumericField T="int?"
                                                                 Value="@numEntry"
                                                                 ValueChanged="@(v => OnChannelNumberChanged(filterId, ch.ProviderChannelId, v))"
                                                                 Placeholder="—"
                                                                 Margin="Margin.Dense"
                                                                 Variant="Variant.Outlined"
                                                                 HideSpinButtons="true"
                                                                 Style="@($"width:72px;{(conflictMsg is not null ? " border-color:var(--mud-palette-error);" : "")}")"
                                                                 DebounceInterval="800"
                                                                 Immediate="true" />
                                                @if (conflictMsg is not null)
                                                {
                                                    <MudTooltip Text="@conflictMsg" Arrow="true" Placement="Placement.Left">
                                                        <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Small" />
                                                    </MudTooltip>
                                                }
                                            }
                                        </div>
                                    </Virtualize>
                                </div>
                            }
                        }
                    }
                </MudPaper>
            }
            else if (item is VirtualParent parent)
            {
                <!-- Virtual parent row -->
                var isParentExpanded = _expandedParents.Contains(parent.OutputName);
                var isEditorShown    = _showParentEditor.Contains(parent.OutputName);
                var allExcluded  = parent.Members.All(IsExcluded);
                var anyActive    = parent.Members.Any(m => !IsExcluded(m));
                var anySelectable = parent.Members.Any(m => !IsExcluded(m) && IsManualMode(m));
                var totalChannels = parent.Members.Sum(m => m.ChannelCount ?? 0);
                var allMembersLoaded = parent.Members.All(m => _channelSelections.ContainsKey(m.ProfileGroupFilterId));
                var selectedChannels = allMembersLoaded
                    ? parent.Members.Sum(GetSelectedChannelCount)
                    : -1;
                var pendingCount = parent.Members.Count(m => m.IsNew);
                var parentStyle  = allExcluded ? "opacity:0.55;" : string.Empty;
                var providerNames = string.Join(", ", parent.Members.Select(m => m.ProviderName).Distinct());
                var isBusy = parent.Members.Any(m => _busyFilters.Contains(m.ProfileGroupFilterId));
                var pFirstActive = parent.Members.FirstOrDefault(m => !IsExcluded(m)) ?? parent.Members.FirstOrDefault();

                <MudPaper Elevation="1" Class="mb-1 pa-2" Style="@parentStyle">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">

                        @if (_editingParentOutputName == parent.OutputName)
                        {
                            <!-- Inline rename mode -->
                            <div style="flex:1; min-width:0; display:inline-flex; align-items:center; gap:4px;">
                                <MudTextField T="string"
                                              @bind-Value="_editParentNameText"
                                              Placeholder="Group name…"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Immediate="true"
                                              Style="min-width:140px; max-width:240px;" />
                                <MudTooltip Text="Confirm" Arrow="true">
                                    <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success"
                                                   OnClick="@(() => CommitParentRenameAsync(parent))"
                                                   Disabled="@(string.IsNullOrWhiteSpace(_editParentNameText))" />
                                </MudTooltip>
                                <MudTooltip Text="Cancel" Arrow="true">
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                   OnClick="CancelEditParent" />
                                </MudTooltip>
                            </div>
                        }
                        else
                        {
                            <!-- Name + member summary + rename button — flex:1 so Start # aligns -->
                            <div style="flex:1; min-width:0; display:flex; align-items:center; gap:2px;">
                                <MudStack Spacing="0" Style="min-width:120px; cursor:pointer;" @onclick="@(() => ToggleParentExpandAsync(parent))">
                                    <MudText Typo="Typo.body1" Style="@($"font-weight:{(anyActive ? "600" : "400")};")">
                                        @parent.OutputName
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @parent.Members.Count group@(parent.Members.Count != 1 ? "s" : "") · @providerNames
                                    </MudText>
                                </MudStack>
                                <MudTooltip Text="Rename group" Arrow="true">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Size="Size.Small"
                                                   OnClick="@(() => BeginEditParent(parent))" />
                                </MudTooltip>
                            </div>

                            <!-- Start # -->
                            <MudNumericField T="int?"
                                             Value="@((int?)GetParentStartNum(parent.OutputName))"
                                             ValueChanged="@(v => OnParentStartNumChanged(parent.OutputName, v))"
                                             Label="Start #"
                                             Placeholder="—"
                                             Margin="Margin.Dense"
                                             Variant="Variant.Outlined"
                                             Disabled="@allExcluded"
                                             HideSpinButtons="true"
                                             Style="width:72px;"
                                             Immediate="true" />

                            <!-- Channel count (selected/total or total only when not loaded) -->
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="min-width:64px; text-align:right;">
                                @(selectedChannels < 0 ? $"0/{totalChannels:N0} ch" : $"{selectedChannels:N0}/{totalChannels:N0} ch")
                            </MudText>

                            @if (pendingCount > 0)
                            {
                                <MudTooltip Text="@($"{pendingCount} newly discovered member group{(pendingCount != 1 ? "s" : "")}.")" Arrow="true">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text" Icon="@Icons.Material.Filled.FiberNew">
                                        @pendingCount new
                                    </MudChip>
                                </MudTooltip>
                            }

                            <!-- Exclude button (bulk) -->
                            <MudTooltip Text="@(allExcluded ? "Remove exclusion" : "Exclude all member groups")" Arrow="true">
                                <MudIconButton Icon="@(allExcluded ? Icons.Material.Filled.Block : Icons.Material.Outlined.Block)"
                                               Size="Size.Small"
                                               Color="@(allExcluded ? Color.Error : Color.Default)"
                                               OnClick="@(() => ToggleParentDecisionAsync(parent, "exclude"))"
                                               Disabled="@isBusy" />
                            </MudTooltip>

                            <!-- Manage member groups button -->
                            <MudTooltip Text="Manage member groups" Arrow="true">
                                <MudIconButton Icon="@Icons.Material.Filled.AccountTree"
                                               Size="Size.Small"
                                               Color="@(isEditorShown ? Color.Primary : Color.Default)"
                                               OnClick="@(() => ToggleParentEditor(parent.OutputName))" />
                            </MudTooltip>

                            <!-- Settings drawer button -->
                            <MudTooltip Text="Group settings" Arrow="true">
                                <MudIconButton Icon="@Icons.Material.Filled.Tune"
                                               Size="Size.Small"
                                               Color="@GetSettingsButtonColor(pFirstActive?.TrackingPolicy, pFirstActive?.TrackingKeywords, $"parent:{parent.OutputName}")"
                                               OnClick="@(() => OpenSettingsDrawer(parent.OutputName, SettingsTargetKind.Parent))" />
                            </MudTooltip>

                            <!-- Expand channels button -->
                            <MudIconButton Icon="@(isParentExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                           Size="Size.Small"
                                           OnClick="@(() => ToggleParentExpandAsync(parent))" />
                        }
                    </MudStack>

                    <!-- Member management panel -->
                    @if (isEditorShown)
                    {
                        <MudDivider Class="mt-2 mb-2" />
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Member Groups</MudText>
                        <MudStack Wrap="Wrap.Wrap" Row="true" Spacing="1" Class="mt-1">
                            @foreach (var member in parent.Members)
                            {
                                var mfid     = member.ProfileGroupFilterId;
                                var mEditing = _editingFilterId == mfid;

                                <MudPaper Elevation="0" Class="pa-1"
                                          Style="border:1px solid var(--mud-palette-divider); border-radius:4px; display:inline-flex; align-items:center; gap:2px;">
                                    @if (mEditing)
                                    {
                                        <MudAutocomplete T="string"
                                            Value="@_editNameText"
                                            ValueChanged="@(v => _editNameText = v ?? string.Empty)"
                                            SearchFunc="SearchOutputNamesAsync"
                                            CoerceValue="true"
                                            Clearable="true"
                                            ResetValueOnEmptyText="true"
                                            Variant="Variant.Outlined"
                                            Margin="Margin.Dense"
                                            Dense="true"
                                            Immediate="true"
                                            Style="min-width:120px; max-width:200px;"
                                            Placeholder="Output name…" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success"
                                                       OnClick="@(() => CommitEditAsync(member))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                       OnClick="CancelEdit" />
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2" Class="px-1">@member.ProviderGroupRawName</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">(@member.ProviderName)</MudText>
                                        <MudTooltip Text="Move to different group" Arrow="true">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                           OnClick="@(() => BeginEdit(mfid, member.OutputName ?? string.Empty))" />
                                        </MudTooltip>
                                        <MudTooltip Text="Remove from this group" Arrow="true">
                                            <MudIconButton Icon="@Icons.Material.Filled.LinkOff" Size="Size.Small" Color="Color.Warning"
                                                           OnClick="@(() => UnmergeAsync(member))" />
                                        </MudTooltip>
                                    }
                                </MudPaper>
                            }
                        </MudStack>
                    }

                    <!-- Unified channel list -->
                    @if (isParentExpanded)
                    {
                        var parentFilterKey   = parent.OutputName;
                        var globalActive      = _globalChannelSearchResults.Count > 0;
                        var parentFilterText  = globalActive ? string.Empty : _parentChannelFilter.GetValueOrDefault(parentFilterKey, string.Empty);
                        var showSelectedOnly  = _parentShowSelectedOnly.Contains(parentFilterKey);
                        var hiddenMembers     = _hiddenParentMembers.GetValueOrDefault(parentFilterKey) ?? new HashSet<string>();
                        var allParentChs      = GetAllParentChannels(parent);
                        var filteredParentChs = GetFilteredParentChannelsForDisplay(parent, allParentChs, globalActive, parentFilterText, hiddenMembers, showSelectedOnly);
                        var totalSelected     = parent.Members
                            .Where(m => !IsExcluded(m) && IsManualMode(m))
                            .Sum(GetSelectedChannelCount);
                        var selectableCount   = allParentChs.Count(e => !IsExcluded(e.Filter) && IsManualMode(e.Filter));
                        var isAnyLoading = parent.Members.Any(m => _loadingChannels.Contains(m.ProfileGroupFilterId));

                        <MudDivider Class="mt-2 mb-2" />

                        @if (!globalActive)
                        {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2" Wrap="Wrap.Wrap">
                            <MudTextField T="string"
                                          Value="@parentFilterText"
                                          ValueChanged="@(v => { _parentChannelFilter[parentFilterKey] = v; StateHasChanged(); })"
                                          Placeholder="Filter channels…"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@(string.IsNullOrEmpty(parentFilterText) ? Icons.Material.Filled.FilterList : Icons.Material.Filled.Clear)"
                                          OnAdornmentClick="@(() => { _parentChannelFilter[parentFilterKey] = string.Empty; StateHasChanged(); })"
                                          Margin="Margin.Dense"
                                          Variant="Variant.Outlined"
                                          Immediate="true"
                                          Style="min-width:180px;" />
                            @if (anySelectable && totalSelected > 0)
                            {
                                <MudTooltip Text="@(showSelectedOnly ? "Show all channels" : "Show selected channels only")" Arrow="true">
                                    <MudIconButton Icon="@(showSelectedOnly ? Icons.Material.Filled.CheckBox : Icons.Material.Outlined.CheckBox)"
                                                   Size="Size.Small"
                                                   Color="@(showSelectedOnly ? Color.Primary : Color.Default)"
                                                   OnClick="@(() => { if (showSelectedOnly) _parentShowSelectedOnly.Remove(parentFilterKey); else _parentShowSelectedOnly.Add(parentFilterKey); StateHasChanged(); })" />
                                </MudTooltip>
                            }
                            @if (anySelectable)
                            {
                                <MudDivider Vertical="true" FlexItem="true" />
                                <MudLink Typo="Typo.caption" OnClick="@(() => SelectVisibleParentChannelsAsync(parent, filteredParentChs))" Style="cursor:pointer;">All</MudLink>
                                <MudLink Typo="Typo.caption" OnClick="@(() => DeselectAllParentChannelsAsync(parent))" Style="cursor:pointer;">None</MudLink>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@totalSelected of @selectableCount selected</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@allParentChs.Count channels</MudText>
                            }
                        </MudStack>
                        }
                        @if (globalActive && anySelectable)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2" Wrap="Wrap.Wrap">
                                <MudLink Typo="Typo.caption" OnClick="@(() => SelectVisibleParentChannelsAsync(parent, filteredParentChs))" Style="cursor:pointer;">All</MudLink>
                                <MudLink Typo="Typo.caption" OnClick="@(() => DeselectAllParentChannelsAsync(parent))" Style="cursor:pointer;">None</MudLink>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@totalSelected of @selectableCount selected</MudText>
                            </MudStack>
                        }

                        @if (parent.Members.Count > 1)
                        {
                            <MudStack Row="true" Spacing="1" Class="mb-2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                                @foreach (var pm in parent.Members)
                                {
                                    var pmId    = pm.ProfileGroupFilterId;
                                    var pmVis   = !hiddenMembers.Contains(pmId);
                                    var pmCount = globalActive
                                        ? (_globalChannelSearchResults.TryGetValue(pmId, out var pmSearchChs) ? pmSearchChs.Count : 0)
                                        : (_channelCache.TryGetValue(pmId, out var pmChs) ? pmChs.Count : (pm.ChannelCount ?? 0));
                                    <MudChip T="string"
                                             Color="@(pmVis ? Color.Primary : Color.Default)"
                                             Variant="@(pmVis ? Variant.Filled : Variant.Outlined)"
                                             Size="Size.Small"
                                             Style="cursor:pointer;"
                                             OnClick="@(() => SetParentMemberVisible(parent.OutputName, pmId, !pmVis))">
                                        @pm.ProviderGroupRawName (@pmCount)
                                    </MudChip>
                                }
                            </MudStack>
                        }

                        @if (isAnyLoading)
                        {
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mt-1" />
                        }
                        else if (allParentChs.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                                No channel data yet - trigger a refresh to populate.
                            </MudAlert>
                        }
                        else
                        {
                            <div style="max-height:500px; overflow-y:auto;">
                                <Virtualize Items="@filteredParentChs" Context="entry" ItemSize="36" OverscanCount="3">
                                    @{
                                    var memberFilter = entry.Filter;
                                    var ch           = entry.Channel;
                                    var mfid         = memberFilter.ProfileGroupFilterId;
                                    var isSelected   = _channelSelections.GetValueOrDefault(mfid)?.GetValueOrDefault(ch.ProviderChannelId) ?? false;
                                    var canSelect    = !IsExcluded(memberFilter) && IsManualMode(memberFilter);
                                    var numEntry     = _channelNumbers.GetValueOrDefault(mfid)?.GetValueOrDefault(ch.ProviderChannelId);
                                    var conflictMsg  = canSelect && isSelected && numEntry.HasValue &&
                                        _numberIndex.TryGetValue(numEntry.Value, out var usedByP) &&
                                        (usedByP.FilterId != mfid || usedByP.ChannelId != ch.ProviderChannelId)
                                            ? $"#{numEntry.Value} already used by {usedByP.Description}" : null;
                                    }

                                    <div style="display:flex; align-items:center; gap:8px; border-bottom:1px solid var(--mud-palette-divider); padding:2px 0;">
                                        @if (canSelect)
                                        {
                                            <MudCheckBox T="bool"
                                                         Value="@isSelected"
                                                         ValueChanged="@(v => OnChannelChecked(memberFilter, ch.ProviderChannelId, v))"
                                                         Size="Size.Small"
                                                         Dense="true" />
                                        }
                                        <MudText Typo="Typo.caption" Color="Color.Secondary"
                                                 Style="min-width:80px; max-width:160px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; flex-shrink:0;"
                                                 title="@($"{memberFilter.ProviderGroupRawName} ({memberFilter.ProviderName})")">
                                            @memberFilter.ProviderGroupRawName (@memberFilter.ProviderName)
                                        </MudText>
                                        <MudText Typo="Typo.body2" Style="flex:1;">@ch.DisplayName</MudText>
                                        @if (!ch.Active)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">gone</MudChip>
                                        }
                                        @if (canSelect && isSelected)
                                        {
                                            <MudNumericField T="int?"
                                                             Value="@numEntry"
                                                             ValueChanged="@(v => OnChannelNumberChanged(mfid, ch.ProviderChannelId, v))"
                                                             Placeholder="—"
                                                             Margin="Margin.Dense"
                                                             Variant="Variant.Outlined"
                                                             HideSpinButtons="true"
                                                             Style="@($"width:72px;{(conflictMsg is not null ? " border-color:var(--mud-palette-error);" : "")}")"
                                                             DebounceInterval="800"
                                                             Immediate="true" />
                                            @if (conflictMsg is not null)
                                            {
                                                <MudTooltip Text="@conflictMsg" Arrow="true" Placement="Placement.Left">
                                                    <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Small" />
                                                </MudTooltip>
                                            }
                                        }
                                    </div>
                                </Virtualize>
                            </div>
                        }
                    }
                </MudPaper>
            }
            else if (item is CustomGroupDto cg)
            {
                var cgExpanded = _cgExpanded.Contains(cg.CustomGroupId);
                var cgLinksExpanded = _cgLinksExpanded.Contains(cg.CustomGroupId);
                var cgBusy = _cgBusy.Contains(cg.CustomGroupId);
                var cgIsExcluded = IsCgExcluded(cg);
                var cgRowStyle = cgIsExcluded ? "opacity:0.55;" : string.Empty;
                var cgChannels = _cgChannelCache.GetValueOrDefault(cg.CustomGroupId) ?? [];
                var cgLinks = _cgLinksCache.GetValueOrDefault(cg.CustomGroupId) ?? [];

                <MudPaper Elevation="1" Class="mb-1 pa-2" Style="@cgRowStyle">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">

                        @if (_cgEditingId == cg.CustomGroupId)
                        {
                            <MudTextField T="string"
                                          Value="@_cgEditName"
                                          ValueChanged="@(v => _cgEditName = v ?? string.Empty)"
                                          Placeholder="Group name…"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          Style="min-width:140px; max-width:240px;" />
                            <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success"
                                           OnClick="@(() => CommitRenameCgAsync(cg))"
                                           Disabled="@(string.IsNullOrWhiteSpace(_cgEditName))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                           OnClick="@(() => { _cgEditingId = null; _cgEditName = string.Empty; })" />
                        }
                        else
                        {
                            <!-- Name + rename button — flex:1 so Start # aligns with other row types -->
                            <div style="flex:1; min-width:0; display:flex; align-items:center; gap:2px;">
                                <MudStack Spacing="0" Style="min-width:120px; cursor:pointer;"
                                          @onclick="@(() => ToggleCgExpandAsync(cg))">
                                    <MudText Typo="Typo.body1" Style="@($"font-weight:{(!cgIsExcluded ? "600" : "400")};")">
                                        @cg.Name
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        custom · @cg.ProviderLinkCount link@(cg.ProviderLinkCount != 1 ? "s" : "")
                                    </MudText>
                                </MudStack>
                                <MudTooltip Text="Rename" Arrow="true">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                   OnClick="@(() => StartRenameCg(cg))" />
                                </MudTooltip>
                            </div>
                        }

                        <MudNumericField T="int?"
                                         Value="@cg.AutoNumStart"
                                         ValueChanged="@(v => OnCgAutoNumStartChangedAsync(cg, v))"
                                         Label="Start #"
                                         Placeholder="—"
                                         Margin="Margin.Dense"
                                         Variant="Variant.Outlined"
                                         Disabled="@cgIsExcluded"
                                         HideSpinButtons="true"
                                         Style="width:72px;" />

                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="min-width:64px; text-align:right;">
                            @cg.SelectedChannelCount/@cg.ChannelCount ch
                        </MudText>

                        <MudTooltip Text="@(cgIsExcluded ? "Remove exclusion" : "Exclude group")" Arrow="true">
                            <MudIconButton Icon="@(cgIsExcluded ? Icons.Material.Filled.Block : Icons.Material.Outlined.Block)"
                                           Size="Size.Small"
                                           Color="@(cgIsExcluded ? Color.Error : Color.Default)"
                                           OnClick="@(() => SetCgDecisionAsync(cg, cgIsExcluded ? "include" : "exclude"))"
                                           Disabled="@cgBusy" />
                        </MudTooltip>

                        <MudTooltip Text="Source provider groups" Arrow="true">
                            <MudIconButton Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small"
                                           Color="@(cgLinksExpanded ? Color.Primary : Color.Default)"
                                           OnClick="@(() => ToggleCgLinksExpandedAsync(cg))" />
                        </MudTooltip>

                        <MudTooltip Text="Group settings" Arrow="true">
                            <MudIconButton Icon="@Icons.Material.Filled.Tune"
                                           Size="Size.Small"
                                           Color="@GetSettingsButtonColor(cg.TrackingPolicy, cg.TrackingKeywords, cg.CustomGroupId)"
                                           OnClick="@(() => OpenSettingsDrawer(cg.CustomGroupId, SettingsTargetKind.Custom))" />
                        </MudTooltip>

                        <MudTooltip Text="Delete custom group" Arrow="true">
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => DeleteCustomGroupAsync(cg))" Disabled="@cgBusy" />
                        </MudTooltip>

                        <MudIconButton Icon="@(cgExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                       Size="Size.Small"
                                       OnClick="@(() => ToggleCgExpandAsync(cg))" />
                    </MudStack>

                    @if (cgLinksExpanded)
                    {
                        <MudDivider Class="my-2" />
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Source groups (auto-sync channels from these provider groups)</MudText>
                            <MudSpacer />
                        </MudStack>
                        @foreach (var link in cgLinks)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Class="mr-1 mb-1"
                                     OnClose="@(() => RemoveCgProviderLinkAsync(cg, link.ProviderGroupId))">
                                @link.ProviderGroupRawName <MudText Typo="Typo.caption" Color="Color.Secondary"> · @link.ProviderName</MudText>
                            </MudChip>
                        }
                        @if (cgLinks.Count == 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">No source groups linked. Use the group list below to link provider groups to this custom group.</MudText>
                        }
                    }

                    @if (cgExpanded)
                    {
                        <MudDivider Class="my-2" />
                        @if (cgChannels.Count == 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                No channels yet. Link source groups (above) to auto-populate, or search for channels in the list below and add them here.
                            </MudText>
                        }
                        else
                        {
                            @foreach (var ch in cgChannels)
                            {
                                var chIncluded = string.Equals(ch.State, "included", StringComparison.OrdinalIgnoreCase);
                                var chPending  = string.Equals(ch.State, "pending",  StringComparison.OrdinalIgnoreCase);
                                var chStyle    = chIncluded ? string.Empty : "opacity:0.6;";

                                <div style="@($"display:flex; align-items:center; gap:6px; padding:2px 0; {chStyle}")">
                                    <MudTooltip Text="@ch.DisplayName" Arrow="true" Placement="Placement.Top">
                                        <MudText Typo="Typo.body2" Style="flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                            @(ch.DisplayNameOverride ?? ch.DisplayName)
                                        </MudText>
                                    </MudTooltip>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="white-space:nowrap;">@ch.GroupTitle</MudText>
                                    @if (chPending)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">pending</MudChip>
                                        <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success"
                                                       OnClick="@(() => SetCgChannelStateAsync(cg, ch, "included"))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" Color="Color.Error"
                                                       OnClick="@(() => SetCgChannelStateAsync(cg, ch, "excluded"))" />
                                    }
                                    else if (chIncluded)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline" Size="Size.Small" Color="Color.Error"
                                                       OnClick="@(() => SetCgChannelStateAsync(cg, ch, "excluded"))" />
                                    }
                                    else
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline" Size="Size.Small" Color="Color.Success"
                                                       OnClick="@(() => SetCgChannelStateAsync(cg, ch, "included"))" />
                                    }
                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" Color="Color.Default"
                                                   OnClick="@(() => RemoveCgChannelAsync(cg, ch))" />
                                </div>
                            }
                        }
                    }
                </MudPaper>
            }
        }
    }
}

@* ── Settings drawer ── *@
@if (_settingsDrawerOpen && _drawerTargetId is not null)
{
    <MudOverlay Visible="true" OnClick="CloseSettingsDrawer" DarkBackground="true" ZIndex="1200" />
    <MudPaper Style="position:fixed; top:0; right:0; width:380px; height:100vh; z-index:1300; overflow-y:auto;"
              Elevation="8" Class="pa-4">
        <MudStack Spacing="3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.h6">Group Settings</MudText>
                <MudTooltip Text="Close group settings" Arrow="true">
                    <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseSettingsDrawer" Size="Size.Small" />
                </MudTooltip>
            </MudStack>
            <MudDivider />

            @if (_drawerTargetKind == SettingsTargetKind.Standalone)
            {
                var df = _allFilters.FirstOrDefault(f => f.ProfileGroupFilterId == _drawerTargetId);
                if (df is not null)
                {
                    var dfExcluded = IsExcluded(df);
                    var dfPolicy = LineupReviewSemantics.NormalizeTrackingPolicy(df.TrackingPolicy);
                    var dfIsAutoMatch = string.Equals(dfPolicy, LineupReviewSemantics.TrackingPolicyAutoAddMatching, StringComparison.OrdinalIgnoreCase);
                    var dfIsAutoMode = IsAutoMode(df);

                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@(df.OutputName ?? df.ProviderGroupRawName)</MudText>

                    <MudSelect T="string"
                               Value="@LineupReviewSemantics.NormalizeGroupMode(df.ChannelMode)"
                               ValueChanged="@(v => OnChannelModeChanged(df, v))"
                               Label="Mode"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Disabled="@dfExcluded">
                        <MudSelectItem Value="@LineupReviewSemantics.GroupModeManualReview">Manual review</MudSelectItem>
                        <MudSelectItem Value="@LineupReviewSemantics.GroupModeAutoUpdate">Auto-update</MudSelectItem>
                    </MudSelect>

                    <MudSelect T="string"
                               Value="@dfPolicy"
                               ValueChanged="@(v => OnTrackingPolicyChanged(df, v))"
                               Label="Event tracking"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Disabled="@dfExcluded">
                        <MudSelectItem Value="@LineupReviewSemantics.TrackingPolicyReview">Review queue</MudSelectItem>
                        <MudSelectItem Value="@LineupReviewSemantics.TrackingPolicyNotify">Notify only</MudSelectItem>
                        <MudSelectItem Value="@LineupReviewSemantics.TrackingPolicyAutoAddAll">Auto-add all events</MudSelectItem>
                        <MudSelectItem Value="@LineupReviewSemantics.TrackingPolicyAutoAddPopulated">Auto-add populated events</MudSelectItem>
                        <MudSelectItem Value="@LineupReviewSemantics.TrackingPolicyAutoAddMatching">Auto-add matching events</MudSelectItem>
                    </MudSelect>

                    <MudSwitch T="bool"
                               Value="@df.TrackNewChannels"
                               ValueChanged="@(v => OnTrackNewChannelsChanged(df, v))"
                               Size="Size.Small"
                               Color="Color.Primary"
                               Disabled="@dfExcluded"
                               Label="Track new channels" />

                    @if (dfIsAutoMatch)
                    {
                        <div style="position:relative;">
                            <MudTextField T="string"
                                          Value="@(df.TrackingKeywords ?? string.Empty)"
                                          ValueChanged="@(v => OnTrackingKeywordsChangedWithPreview(df, v))"
                                          Label="Match terms"
                                          Placeholder="teams / leagues / fighters (comma, |, or newline)"
                                          Variant="Variant.Outlined"
                                          Immediate="true"
                                          HelperText="@GetKeywordHelperText(df)"
                                          HelperTextOnFocus="false"
                                          Error="@(string.IsNullOrWhiteSpace(df.TrackingKeywords))"
                                          ErrorText="No match terms — no events will auto-add." />
                            @{
                                if (_keywordPreviewResults.TryGetValue(df.ProfileGroupFilterId, out var dpItems) && dpItems.Count > 0)
                                {
                                    <MudPaper Elevation="4" Class="pa-2 mt-1"
                                              Style="position:absolute; z-index:10; max-height:200px; overflow-y:auto; width:100%; background:var(--mud-palette-surface);">
                                        <MudText Typo="Typo.caption" Color="Color.Success" Class="mb-1">
                                            @dpItems.Count matching channel@(dpItems.Count != 1 ? "s" : ""):
                                        </MudText>
                                        @foreach (var prev in dpItems.Take(20))
                                        {
                                            <MudText Typo="Typo.body2">@prev</MudText>
                                        }
                                        @if (dpItems.Count > 20)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">…and @(dpItems.Count - 20) more</MudText>
                                        }
                                    </MudPaper>
                                }
                            }
                        </div>
                        @if (!dfIsAutoMode)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Set mode to Auto-update to auto-add matching events.
                            </MudText>
                        }
                    }
                }
            }
            else if (_drawerTargetKind == SettingsTargetKind.Parent)
            {
                var pMembers = _allFilters.Where(f => string.Equals(f.OutputName, _drawerTargetId, StringComparison.OrdinalIgnoreCase)).ToList();
                var pFirst = pMembers.FirstOrDefault(m => !IsExcluded(m)) ?? pMembers.FirstOrDefault();
                if (pFirst is not null)
                {
                    var pAllExcluded = pMembers.All(IsExcluded);
                    var pMode = LineupReviewSemantics.NormalizeGroupMode(pFirst.ChannelMode);
                    var pPolicy = LineupReviewSemantics.NormalizeTrackingPolicy(pFirst.TrackingPolicy);
                    var pIsAutoMatch = string.Equals(pPolicy, LineupReviewSemantics.TrackingPolicyAutoAddMatching, StringComparison.OrdinalIgnoreCase);
                    var pIsAutoMode = string.Equals(pMode, LineupReviewSemantics.GroupModeAutoUpdate, StringComparison.OrdinalIgnoreCase);
                    var pParent = new VirtualParent(_drawerTargetId!, pMembers);

                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@_drawerTargetId</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Applies to all @pMembers.Count member groups</MudText>

                    <MudSelect T="string"
                               Value="@pMode"
                               ValueChanged="@(v => SetParentChannelModeAsync(pParent, v))"
                               Label="Mode"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Disabled="@pAllExcluded">
                        <MudSelectItem Value="@LineupReviewSemantics.GroupModeManualReview">Manual review</MudSelectItem>
                        <MudSelectItem Value="@LineupReviewSemantics.GroupModeAutoUpdate">Auto-update</MudSelectItem>
                    </MudSelect>

                    <MudSelect T="string"
                               Value="@pPolicy"
                               ValueChanged="@(v => SetParentTrackingPolicyAsync(pParent, v))"
                               Label="Event tracking"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Disabled="@pAllExcluded">
                        <MudSelectItem Value="@LineupReviewSemantics.TrackingPolicyReview">Review queue</MudSelectItem>
                        <MudSelectItem Value="@LineupReviewSemantics.TrackingPolicyNotify">Notify only</MudSelectItem>
                        <MudSelectItem Value="@LineupReviewSemantics.TrackingPolicyAutoAddAll">Auto-add all events</MudSelectItem>
                        <MudSelectItem Value="@LineupReviewSemantics.TrackingPolicyAutoAddPopulated">Auto-add populated events</MudSelectItem>
                        <MudSelectItem Value="@LineupReviewSemantics.TrackingPolicyAutoAddMatching">Auto-add matching events</MudSelectItem>
                    </MudSelect>

                    <MudSwitch T="bool"
                               Value="@pFirst.TrackNewChannels"
                               ValueChanged="@(v => SetParentTrackNewChannelsAsync(_drawerTargetId!, v))"
                               Size="Size.Small"
                               Color="Color.Primary"
                               Disabled="@pAllExcluded"
                               Label="Track new channels" />

                    @if (pIsAutoMatch)
                    {
                        <MudTextField T="string"
                                      Value="@(pFirst.TrackingKeywords ?? string.Empty)"
                                      ValueChanged="@(v => SetParentTrackingKeywordsAsync(_drawerTargetId!, v))"
                                      Label="Match terms"
                                      Placeholder="teams / leagues / fighters (comma, |, or newline)"
                                      Variant="Variant.Outlined"
                                      Immediate="true"
                                      Error="@(string.IsNullOrWhiteSpace(pFirst.TrackingKeywords))"
                                      ErrorText="No match terms — no events will auto-add." />
                        @if (!pIsAutoMode)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Set mode to Auto-update to auto-add matching events.
                            </MudText>
                        }
                    }
                }
            }
            else if (_drawerTargetKind == SettingsTargetKind.Custom)
            {
                var cg = _customGroups.FirstOrDefault(c => c.CustomGroupId == _drawerTargetId);
                if (cg is not null)
                {
                    var cgEx = IsCgExcluded(cg);
                    var cgPolicy = LineupReviewSemantics.NormalizeTrackingPolicy(cg.TrackingPolicy);
                    var cgAutoMatch = string.Equals(cgPolicy, LineupReviewSemantics.TrackingPolicyAutoAddMatching, StringComparison.OrdinalIgnoreCase);
                    var cgAutoMode = string.Equals(LineupReviewSemantics.NormalizeGroupMode(cg.ChannelMode), LineupReviewSemantics.GroupModeAutoUpdate, StringComparison.OrdinalIgnoreCase);

                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@cg.Name</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Custom group</MudText>

                    <MudSelect T="string"
                               Value="@LineupReviewSemantics.NormalizeGroupMode(cg.ChannelMode)"
                               ValueChanged="@(v => OnCgModeChangedAsync(cg, v))"
                               Label="Mode"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Disabled="@cgEx">
                        <MudSelectItem Value="@LineupReviewSemantics.GroupModeManualReview">Manual review</MudSelectItem>
                        <MudSelectItem Value="@LineupReviewSemantics.GroupModeAutoUpdate">Auto-update</MudSelectItem>
                    </MudSelect>

                    <MudSelect T="string"
                               Value="@cgPolicy"
                               ValueChanged="@(v => OnCgTrackingPolicyChangedAsync(cg, v))"
                               Label="Event tracking"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Disabled="@cgEx">
                        <MudSelectItem Value="@LineupReviewSemantics.TrackingPolicyReview">Review queue</MudSelectItem>
                        <MudSelectItem Value="@LineupReviewSemantics.TrackingPolicyNotify">Notify only</MudSelectItem>
                        <MudSelectItem Value="@LineupReviewSemantics.TrackingPolicyAutoAddAll">Auto-add all events</MudSelectItem>
                        <MudSelectItem Value="@LineupReviewSemantics.TrackingPolicyAutoAddPopulated">Auto-add populated events</MudSelectItem>
                        <MudSelectItem Value="@LineupReviewSemantics.TrackingPolicyAutoAddMatching">Auto-add matching events</MudSelectItem>
                    </MudSelect>

                    <MudSwitch T="bool"
                               Value="@cg.TrackNewChannels"
                               ValueChanged="@(v => OnCgTrackNewChangedAsync(cg, v))"
                               Size="Size.Small"
                               Color="Color.Primary"
                               Disabled="@cgEx"
                               Label="Track new channels" />

                    @if (cgAutoMatch)
                    {
                        <MudTextField T="string"
                                      Value="@(cg.TrackingKeywords ?? string.Empty)"
                                      ValueChanged="@(v => OnCgKeywordsChangedAsync(cg, v))"
                                      Label="Match terms"
                                      Placeholder="teams / leagues / fighters (comma, |, or newline)"
                                      Variant="Variant.Outlined"
                                      Immediate="true"
                                      Error="@(string.IsNullOrWhiteSpace(cg.TrackingKeywords))"
                                      ErrorText="No match terms — no events will auto-add." />
                        @if (!cgAutoMode)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Set mode to Auto-update to auto-add matching events.
                            </MudText>
                        }
                    }
                }
            }
        </MudStack>
    </MudPaper>
}

@code {
    [SupplyParameterFromQuery(Name = "profile")]
    public string? InitialProfile { get; set; }

    private string? _profileId;
    private List<ProfileStubDto> _allProfiles = [];
    private List<GroupFilterDto> _allFilters = [];
    private bool _isLoading = true;
    private bool _isRefreshing;
    private string? _error;

    private HashSet<string> _busyFilters = [];
    private HashSet<string> _sessionChangedFilterIds = [];
    private HashSet<string> _expandedGroups = [];
    private HashSet<string> _expandedParents = [];
    private Dictionary<string, List<ProviderChannelSelectDto>> _channelCache = [];
    private Dictionary<string, Dictionary<string, bool>> _channelSelections = [];
    private Dictionary<string, Dictionary<string, int?>> _channelNumbers = [];
    private HashSet<string> _loadingChannels = [];
    private HashSet<string> _showParentEditor = [];
    private Dictionary<string, string> _groupChannelFilter = [];
    private Dictionary<string, string> _parentChannelFilter = [];
    private HashSet<string> _parentShowSelectedOnly = [];
    private Dictionary<string, HashSet<string>> _hiddenParentMembers = [];
    private Dictionary<string, int> _parentStartNum = [];
    private HashSet<string> _dirtyChannelSelectionFilterIds = [];
    private CancellationTokenSource? _channelSaveDebounceCts;

    private record NumberEntry(string FilterId, string ChannelId, string Description);
    private Dictionary<int, NumberEntry> _numberIndex = [];
    private List<object>? _filteredItemsCache;
    private Dictionary<string, int>? _selectedCountForRender;

    private int _defaultStartNum = 100;
    private string? _startNumProfileId;
    private List<string> _savedChannelFilters = [];
    private bool _jsReady;

    private string _searchTerm = string.Empty;
    private string? _searchError;
    private Func<string, bool>? _searchPredicate;
    private HashSet<string> _decisionFilterStates = ["used", "unmapped"];
    private List<string> _displayOrderIds = [];

    private string _globalChannelFilter = string.Empty;
    private bool _globalChannelSearchBusy;
    private Dictionary<string, List<ChannelSearchItemDto>> _globalChannelSearchResults = [];
    private Dictionary<string, HashSet<string>> _globalChannelSearchHitIds = [];
    private CancellationTokenSource? _globalSearchDebounceCts;
    private HashSet<string> _searchAutoExpandedGroups = [];
    private HashSet<string> _searchAutoExpandedParents = [];

    private string? _editingFilterId;
    private string _editNameText = string.Empty;
    private bool _isBulkBusy;

    // -------------------------------------------------------------------------
    // Custom groups state
    // -------------------------------------------------------------------------
    private List<CustomGroupDto> _customGroups = [];
    private HashSet<string> _cgExpanded = [];
    private HashSet<string> _cgLinksExpanded = [];
    private HashSet<string> _cgBusy = [];
    private HashSet<string> _advancedPanelOpen = [];
    private Dictionary<string, List<CustomGroupChannelDto>> _cgChannelCache = [];
    private Dictionary<string, List<CustomGroupProviderLinkDto>> _cgLinksCache = [];
    private bool _cgCreating;
    private string _cgNewName = string.Empty;
    private string? _cgEditingId;
    private string _cgEditName = string.Empty;
    private string? _editingParentOutputName;
    private string _editParentNameText = string.Empty;

    // -------------------------------------------------------------------------
    // Settings drawer state
    // -------------------------------------------------------------------------
    private bool _settingsDrawerOpen;
    private string? _drawerTargetId;
    private enum SettingsTargetKind { Standalone, Parent, Custom }
    private SettingsTargetKind _drawerTargetKind;

    private void ToggleDecisionFilterState(string state)
    {
        if (!_decisionFilterStates.Remove(state))
            _decisionFilterStates.Add(state);
    }

    private static bool IsExcluded(GroupFilterDto filter) =>
        string.Equals(filter.Decision, LineupReviewSemantics.GroupDecisionExclude, StringComparison.OrdinalIgnoreCase);

    private static bool IsIncluded(GroupFilterDto filter) =>
        !IsExcluded(filter);

    private static bool MatchesNew(GroupFilterDto filter, bool showNew) =>
        showNew && IsIncluded(filter) && filter.IsNew;

    private int GetSelectedChannelCount(GroupFilterDto filter)
    {
        _selectedCountForRender ??= [];
        if (_selectedCountForRender.TryGetValue(filter.ProfileGroupFilterId, out var cached))
            return cached;
        var count = _channelSelections.TryGetValue(filter.ProfileGroupFilterId, out var sel)
            ? sel.Count(s => s.Value)
            : filter.SelectedChannelCount;
        _selectedCountForRender[filter.ProfileGroupFilterId] = count;
        return count;
    }

    private bool IsUnmappedBySelection(GroupFilterDto filter) =>
        IsIncluded(filter)
        && GetSelectedChannelCount(filter) == 0;

    private int GetAvailableChannelCount(GroupFilterDto filter, string filterId) =>
        _channelCache.TryGetValue(filterId, out var cachedChs)
            ? cachedChs.Count
            : (filter.ChannelCount ?? 0);

    private string GetChannelCountTooltipText(GroupFilterDto filter, string filterId)
    {
        var available = GetAvailableChannelCount(filter, filterId);
        var firstSeen = $"First seen: {filter.ProviderGroupFirstSeen:yyyy-MM-dd}";

        if (IsExcluded(filter))
            return available > 0
                ? $"Excluded from output. {available:N0} channels available. {firstSeen}"
                : $"Excluded from output. {firstSeen}";

        if (IsAutoMode(filter))
            return available > 0
                ? $"Auto-update mode manages this group without manual channel picks. {available:N0} channels available. {firstSeen}"
                : $"Auto-update mode manages this group without manual channel picks. {firstSeen}";

        var selected = GetSelectedChannelCount(filter);
        if (selected == 0 && available > 0)
            return $"No channels are selected for output in this group yet. Expand the row to choose channels. {firstSeen}";

        return $"{selected:N0}/{available:N0} channels selected for output. {firstSeen}";
    }

    private static bool IsAutoMode(GroupFilterDto filter) =>
        string.Equals(
            LineupReviewSemantics.NormalizeGroupMode(filter.ChannelMode),
            LineupReviewSemantics.GroupModeAutoUpdate,
            StringComparison.OrdinalIgnoreCase);

    private static bool IsManualMode(GroupFilterDto filter) => !IsAutoMode(filter);

    private sealed record VirtualParent(string OutputName, List<GroupFilterDto> Members);
    private sealed record ParentChannelEntry(GroupFilterDto Filter, ProviderChannelSelectDto Channel);

    private List<object> FilteredItems => _filteredItemsCache ??= BuildFilteredItems();

    private List<object> BuildFilteredItems()
    {
        var allLive = _allFilters.Where(f => f.ProviderGroupContentType == "live").ToList();

            var standaloneDict = allLive
                .Where(f => f.OutputName is null)
                .ToDictionary(f => f.ProfileGroupFilterId, f => (object)f);

            var parentDict = allLive
                .Where(f => f.OutputName is not null)
                .GroupBy(f => f.OutputName!, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(
                    g => $"parent:{g.Key}",
                    g => (object)new VirtualParent(g.Key, g.ToList()),
                    StringComparer.OrdinalIgnoreCase);

            var cgDict = _customGroups.ToDictionary(
                cg => $"cg:{cg.CustomGroupId}",
                cg => (object)cg,
                StringComparer.OrdinalIgnoreCase);

            var allItems = new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase);
            foreach (var (k, v) in standaloneDict) allItems[k] = v;
            foreach (var (k, v) in parentDict)     allItems[k] = v;
            foreach (var (k, v) in cgDict)         allItems[k] = v;

            var showUsed     = _decisionFilterStates.Contains("used");
            var showUnmapped = _decisionFilterStates.Contains("unmapped");
            var showExclude  = _decisionFilterStates.Contains("exclude");
            var showNew      = _decisionFilterStates.Contains("new");
            var showRemoved  = _decisionFilterStates.Contains("removed");
            var showAll      = showUsed && showUnmapped && showExclude;

            bool FilterMatchesGroup(GroupFilterDto f) =>
                IsExcluded(f) ? showExclude :
                showAll ||
                (showUsed     && IsIncluded(f) && GetSelectedChannelCount(f) > 0) ||
                (showUnmapped && IsUnmappedBySelection(f)) ||
                MatchesNew(f, showNew) ||
                (showRemoved  && IsIncluded(f) && !f.ProviderGroupActive);

            bool CgMatchesFilter(CustomGroupDto cg) =>
                IsCgExcluded(cg) ? showExclude :
                showAll ||
                (showUsed     && IsCgIncluded(cg) && cg.SelectedChannelCount > 0) ||
                (showUnmapped && IsCgIncluded(cg) && cg.SelectedChannelCount == 0);

            Func<object, bool> decisionMatch = o => o switch
            {
                GroupFilterDto f  => FilterMatchesGroup(f),
                VirtualParent p   => p.Members.Any(FilterMatchesGroup),
                CustomGroupDto cg => CgMatchesFilter(cg),
                _ => false,
            };

            if (!showAll && _sessionChangedFilterIds.Count > 0)
            {
                var baseMatch = decisionMatch;
                decisionMatch = o =>
                {
                    if (baseMatch(o)) return true;
                    return o switch
                    {
                        GroupFilterDto f => _sessionChangedFilterIds.Contains(f.ProfileGroupFilterId)
                                            && ((showUsed && IsIncluded(f) && GetSelectedChannelCount(f) > 0)
                                                || (showUnmapped && IsUnmappedBySelection(f))
                                                || (showExclude && IsExcluded(f))
                                                || MatchesNew(f, showNew)
                                                || (showRemoved && IsIncluded(f) && !f.ProviderGroupActive)),
                        VirtualParent p  => p.Members.Any(m => _sessionChangedFilterIds.Contains(m.ProfileGroupFilterId)
                                                                && ((showUsed && IsIncluded(m) && GetSelectedChannelCount(m) > 0)
                                                                    || (showUnmapped && IsUnmappedBySelection(m))
                                                                    || (showExclude && IsExcluded(m))
                                                                    || MatchesNew(m, showNew)
                                                                    || (showRemoved && IsIncluded(m) && !m.ProviderGroupActive))),
                        _ => false,
                    };
                };
            }

            Func<object, bool> searchMatch = _searchPredicate is null
                ? _ => true
                : o => o switch
                {
                    GroupFilterDto f  => _searchPredicate(f.ProviderGroupRawName),
                    VirtualParent p   => _searchPredicate(p.OutputName),
                    CustomGroupDto cg => _searchPredicate(cg.Name),
                    _                 => false,
                };

            Func<object, bool> channelSearchMatch = _globalChannelSearchResults.Count == 0
                ? _ => true
                : o => o switch
                {
                    GroupFilterDto f => _globalChannelSearchResults.ContainsKey(f.ProfileGroupFilterId),
                    VirtualParent p  => p.Members.Any(m => _globalChannelSearchResults.ContainsKey(m.ProfileGroupFilterId)),
                    CustomGroupDto _ => true,
                    _                => false,
                };

            return _displayOrderIds
                .Where(id => allItems.ContainsKey(id))
                .Select(id => allItems[id])
                .Where(decisionMatch)
                .Where(searchMatch)
                .Where(channelSearchMatch)
                .ToList();
    }

    private void RebuildDisplayOrder()
    {
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var entries = new List<(string Key, string SortName, bool IsNew)>();

        foreach (var f in _allFilters.Where(f => f.ProviderGroupContentType == "live"))
        {
            var key = f.OutputName is not null ? $"parent:{f.OutputName}" : f.ProfileGroupFilterId;
            var sortName = f.OutputName ?? f.ProviderGroupRawName;
            if (seen.Add(key))
                entries.Add((key, sortName, f.IsNew));
        }

        foreach (var cg in _customGroups)
            entries.Add(($"cg:{cg.CustomGroupId}", cg.Name, false));

        _displayOrderIds = entries
            .OrderBy(e => e.SortName, StringComparer.OrdinalIgnoreCase)
            .Select(e => e.Key)
            .ToList();
    }

    // Updates _displayOrderIds in-place when a rename or unmerge happens, so the item
    // stays at roughly the same scroll position instead of jumping to a sorted position.
    private void UpdateDisplayOrderForRename(GroupFilterDto filter, string? oldOutputName, string? newOutputName)
    {
        var oldKey = oldOutputName is not null ? $"parent:{oldOutputName}" : filter.ProfileGroupFilterId;
        var newKey = newOutputName is not null ? $"parent:{newOutputName}" : filter.ProfileGroupFilterId;

        if (string.Equals(oldKey, newKey, StringComparison.OrdinalIgnoreCase))
            return;

        var idx = _displayOrderIds.FindIndex(id => string.Equals(id, oldKey, StringComparison.OrdinalIgnoreCase));

        // Does the old parent key still have other members after this rename?
        var oldKeyStillNeeded = oldOutputName is not null &&
            _allFilters.Any(f => f.ProfileGroupFilterId != filter.ProfileGroupFilterId &&
                                 string.Equals(f.OutputName, oldOutputName, StringComparison.OrdinalIgnoreCase));

        // Does the target key already have a position in the list?
        var newKeyAlreadyExists = _displayOrderIds.Any(id => string.Equals(id, newKey, StringComparison.OrdinalIgnoreCase));

        if (newKeyAlreadyExists)
        {
            // Merging into an existing parent — just remove the old slot if it's no longer needed
            if (!oldKeyStillNeeded && idx >= 0)
                _displayOrderIds.RemoveAt(idx);
        }
        else
        {
            if (idx >= 0)
            {
                if (oldKeyStillNeeded)
                    _displayOrderIds.Insert(idx + 1, newKey); // sibling stays beside the old parent
                else
                    _displayOrderIds[idx] = newKey;           // rename in place
            }
            else
            {
                _displayOrderIds.Add(newKey);
            }
        }
    }

    private readonly CancellationTokenSource _cts = new();
    private IDisposable? _eventSubscription;

    protected override bool ShouldRender()
    {
        _filteredItemsCache = null;
        _selectedCountForRender = null;
        return true;
    }

    protected override Task OnInitializedAsync()
    {
        _ = InitializeAsync();
        return Task.CompletedTask;
    }

    private async Task InitializeAsync()
    {
        _allProfiles = await ProfilesService.GetProfileStubsAsync(_cts.Token);
        if (!string.IsNullOrEmpty(InitialProfile) && _allProfiles.Any(p => p.ProfileId == InitialProfile))
            _profileId = InitialProfile;
        _isRefreshing = RefreshTrigger.IsRefreshing;
        var reader = EventBus.Subscribe(out _eventSubscription);
        _ = ListenForEventsAsync(reader, _cts.Token);
        await LoadAsync();
    }

    private async Task OnProfileChangedAsync(string newProfileId)
    {
        _profileId = newProfileId;
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jsReady) return;
        _jsReady = true;

        try
        {
            var startKey = _profileId is not null ? $"m3undle:default-start-num:{_profileId}" : "m3undle:default-start-num";
            var startStr = await JS.InvokeAsync<string?>("localStorage.getItem", startKey);
            if (int.TryParse(startStr, out var n) && n > 0)
                _defaultStartNum = n;
            _startNumProfileId = _profileId;

            var presetsJson = await JS.InvokeAsync<string?>("localStorage.getItem", "m3undle:channel-filter-presets");
            if (!string.IsNullOrWhiteSpace(presetsJson))
                _savedChannelFilters = System.Text.Json.JsonSerializer.Deserialize<List<string>>(presetsJson) ?? [];
        }
        catch { }

        StateHasChanged();
    }

    private async Task SaveDefaultStartNumAsync()
    {
        if (_profileId is null) return;
        try { await JS.InvokeVoidAsync("localStorage.setItem", $"m3undle:default-start-num:{_profileId}", _defaultStartNum.ToString()); }
        catch { }
    }

    private void RebuildNumberIndex()
    {
        _numberIndex = [];
        foreach (var (fid, numDict) in _channelNumbers)
        {
            var group    = _allFilters.FirstOrDefault(f => f.ProfileGroupFilterId == fid);
            var channels = _channelCache.GetValueOrDefault(fid) ?? [];
            foreach (var (cid, num) in numDict)
            {
                if (num.HasValue)
                {
                    var ch = channels.FirstOrDefault(c => c.ProviderChannelId == cid);
                    _numberIndex.TryAdd(num.Value,
                        new NumberEntry(fid, cid, $"{group?.ProviderGroupRawName ?? "?"}: {ch?.DisplayName ?? "?"}"));
                }
            }
        }
    }

    private void UpdateNumberIndexEntry(string filterId, string channelId, int? newNumber, int? oldNumber = null)
    {
        if (oldNumber.HasValue)
            _numberIndex.Remove(oldNumber.Value);

        if (newNumber.HasValue)
        {
            var group    = _allFilters.FirstOrDefault(f => f.ProfileGroupFilterId == filterId);
            var channels = _channelCache.GetValueOrDefault(filterId) ?? [];
            var ch       = channels.FirstOrDefault(c => c.ProviderChannelId == channelId);
            _numberIndex[newNumber.Value] = new NumberEntry(filterId, channelId, $"{group?.ProviderGroupRawName ?? "?"}: {ch?.DisplayName ?? "?"}");
        }
    }

    private void RemoveNumberIndexEntry(int? number)
    {
        if (number.HasValue)
            _numberIndex.Remove(number.Value);
    }

    private HashSet<int> GetAssignedNumbers((string FilterId, string ChannelId)? except = null, IEnumerable<string>? exceptFilterIds = null)
    {
        var used = new HashSet<int>();
        var skipFilters = exceptFilterIds is null ? null : new HashSet<string>(exceptFilterIds);

        foreach (var (fid, numDict) in _channelNumbers)
        {
            if (skipFilters is not null && skipFilters.Contains(fid))
                continue;

            foreach (var (cid, num) in numDict)
            {
                if (!num.HasValue) continue;
                if (except.HasValue && except.Value.FilterId == fid && except.Value.ChannelId == cid)
                    continue;
                used.Add(num.Value);
            }
        }

        return used;
    }

    private static int NextUnused(int start, HashSet<int> used)
    {
        var n = start;
        while (used.Contains(n)) n++;
        used.Add(n);
        return n;
    }

    private int GetGlobalNextAvailableNumber()
    {
        var used = GetAssignedNumbers();

        if (used.Count == 0)
            return _defaultStartNum;

        var baseline = Math.Max(_defaultStartNum, used.Max() + 1);
        return NextUnused(baseline, used);
    }

    private int GetNextNumberForGroup(GroupFilterDto filter, Dictionary<string, int?> numbers, HashSet<int> used)
    {
        var baseStart = filter.OutputName is not null && _parentStartNum.TryGetValue(filter.OutputName, out var parentStart)
            ? parentStart
            : (filter.AutoNumStart ?? _defaultStartNum);
        var currentMax = numbers.Values
            .Where(v => v.HasValue)
            .Select(v => v!.Value)
            .DefaultIfEmpty(baseStart - 1)
            .Max();

        var candidate = currentMax + 1;
        return NextUnused(candidate, used);
    }

    private async Task ListenForEventsAsync(System.Threading.Channels.ChannelReader<AppEvent> reader, CancellationToken ct)
    {
        try
        {
            await foreach (var evt in reader.ReadAllAsync(ct))
            {
                if (evt.Kind == AppEventKind.RefreshStarted)
                {
                    await InvokeAsync(() => { _isRefreshing = true; StateHasChanged(); });
                }
                else if (evt.Kind == AppEventKind.RefreshCompleted && !_isLoading)
                {
                    await InvokeAsync(async () =>
                    {
                        _isRefreshing = false;
                        await LoadCoreAsync(showSpinner: false);
                    });
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        _eventSubscription?.Dispose();
        _channelSaveDebounceCts?.Cancel();
        _channelSaveDebounceCts?.Dispose();
        _globalSearchDebounceCts?.Cancel();
        _globalSearchDebounceCts?.Dispose();
    }

    private Task LoadAsync() => LoadCoreAsync(showSpinner: true);

    private async Task LoadCoreAsync(bool showSpinner)
    {
        if (showSpinner)
        {
            _isLoading = true;
            _error = null;
            StateHasChanged();
        }

        try
        {
            string? newProfileId;
            if (_profileId is not null)
            {
                newProfileId = _profileId;
            }
            else
            {
                var profile = await ChannelMappingPageService.GetActiveProfileAsync(_cts.Token);
                if (profile is null)
                {
                    _profileId = null;
                    return;
                }
                newProfileId = profile.ProfileId;
            }

            if (_startNumProfileId is not null && _startNumProfileId != newProfileId)
            {
                _defaultStartNum = 100;
                if (_jsReady)
                {
                    try
                    {
                        var startStr = await JS.InvokeAsync<string?>("localStorage.getItem", $"m3undle:default-start-num:{newProfileId}");
                        if (int.TryParse(startStr, out var n) && n > 0)
                            _defaultStartNum = n;
                    }
                    catch { }
                }
                _startNumProfileId = newProfileId;
            }

            _profileId = newProfileId;

            _allFilters = await ChannelMappingPageService.ListGroupFiltersAsync(_profileId, _cts.Token);
            _customGroups = await CustomGroupService.ListAsync(_profileId, _cts.Token);

            _sessionChangedFilterIds.Clear();
            RebuildDisplayOrder();
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            if (showSpinner)
                _error = $"Failed to load group filters: {ex.Message}";
        }
        finally
        {
            if (showSpinner)
                _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task BuildSnapshotAsync()
    {
        if (_isRefreshing) return;
        _isRefreshing = true;
        StateHasChanged();

        try
        {
            var triggered = ChannelMappingPageService.TriggerBuildOnly();
            if (!triggered)
            {
                Snackbar.Add("A build is already in progress.", Severity.Warning);
                _isRefreshing = false;
            }
            else
            {
                Snackbar.Add("Building output — page will refresh when done.", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            _isRefreshing = false;
        }
    }

