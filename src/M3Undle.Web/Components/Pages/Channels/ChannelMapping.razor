    private async Task OnGlobalChannelFilterChanged(string value)
    {
        _globalChannelFilter = value;
        _globalSearchDebounceCts?.Cancel();

        if (string.IsNullOrWhiteSpace(value) || value.Trim().Length < 2)
        {
            _globalChannelSearchResults.Clear();
            _globalChannelSearchHitIds.Clear();
            _globalChannelSearchBusy = false;
            foreach (var id in _searchAutoExpandedGroups)
                _expandedGroups.Remove(id);
            foreach (var name in _searchAutoExpandedParents)
                _expandedParents.Remove(name);
            _searchAutoExpandedGroups.Clear();
            _searchAutoExpandedParents.Clear();
            StateHasChanged();
            return;
        }

        _globalChannelSearchBusy = true;
        StateHasChanged();

        _globalSearchDebounceCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(400, _globalSearchDebounceCts.Token);
            await ExecuteGlobalChannelSearchAsync(value.Trim());
        }
        catch (OperationCanceledException) { }
    }

    private async Task ExecuteGlobalChannelSearchAsync(string term)
    {
        if (_profileId is null) return;

        try
        {
            var results = await ChannelMappingPageService.SearchChannelsAsync(_profileId, term, _cts.Token);
            _globalChannelSearchResults = results.ToDictionary(r => r.FilterId, r => r.Channels);
            _globalChannelSearchHitIds = results.ToDictionary(
                r => r.FilterId,
                r => r.Channels.Select(c => c.ProviderChannelId).ToHashSet(StringComparer.Ordinal),
                StringComparer.Ordinal);

            var channelLoadTasks = new List<Task>();
            var expandedParentNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

            foreach (var result in results)
            {
                var filter = _allFilters.FirstOrDefault(f => f.ProfileGroupFilterId == result.FilterId);
                if (filter is null) continue;

                if (filter.OutputName is null)
                {
                    if (!_expandedGroups.Contains(result.FilterId))
                    {
                        _expandedGroups.Add(result.FilterId);
                        _searchAutoExpandedGroups.Add(result.FilterId);
                        if (!_channelCache.ContainsKey(result.FilterId))
                            channelLoadTasks.Add(LoadChannelsAsync(result.FilterId));
                    }
                }
                else
                {
                    if (expandedParentNames.Add(filter.OutputName) && !_expandedParents.Contains(filter.OutputName))
                    {
                        _expandedParents.Add(filter.OutputName);
                        _searchAutoExpandedParents.Add(filter.OutputName);
                        foreach (var member in _allFilters.Where(f => string.Equals(f.OutputName, filter.OutputName, StringComparison.OrdinalIgnoreCase)))
                        {
                            if (!_channelCache.ContainsKey(member.ProfileGroupFilterId))
                                channelLoadTasks.Add(LoadChannelsAsync(member.ProfileGroupFilterId));
                        }
                    }
                }
            }

            if (channelLoadTasks.Count > 0)
                await Task.WhenAll(channelLoadTasks);
        }
        catch (OperationCanceledException) { }
        finally
        {
            _globalChannelSearchBusy = false;
            StateHasChanged();
        }
    }

    private async Task SelectVisibleParentChannelsAsync(VirtualParent parent, IEnumerable<ParentChannelEntry> visible)
    {
        var visibleEntries = visible.Where(e => !IsExcluded(e.Filter) && IsManualMode(e.Filter)).ToList();
        if (visibleEntries.Count == 0) return;

        var visibleFilterIds = visibleEntries.Select(e => e.Filter.ProfileGroupFilterId).Distinct().ToList();
        var used = GetAssignedNumbers(exceptFilterIds: visibleFilterIds);
        var next = NextUnused(GetParentStartNum(parent.OutputName), used);

        foreach (var grp in visibleEntries.GroupBy(e => e.Filter.ProfileGroupFilterId))
        {
            var filterId   = grp.Key;
            var selections = _channelSelections.TryGetValue(filterId, out var s) ? new Dictionary<string, bool>(s) : [];
            var numbers    = _channelNumbers.TryGetValue(filterId, out var n) ? new Dictionary<string, int?>(n) : [];

            foreach (var entry in grp)
            {
                selections[entry.Channel.ProviderChannelId] = true;
                numbers[entry.Channel.ProviderChannelId]    = next = NextUnused(next, used);
                next++;
            }

            _channelSelections[filterId] = selections;
            _channelNumbers[filterId]    = numbers;
        }

        RebuildNumberIndex();
        StateHasChanged();

        var clearedNew = false;
        foreach (var filterId in visibleFilterIds)
            clearedNew |= MarkChannelSelectionsDirty(filterId);

        if (clearedNew)
            StateHasChanged();

        await DebounceDirtyChannelSelectionSaveAsync();
    }

    private async Task SelectAllParentChannelsAsync(VirtualParent parent)
    {
        var includedMembers = parent.Members.Where(m => !IsExcluded(m) && IsManualMode(m)).ToList();
        if (includedMembers.Count == 0) return;

        var filterIds = includedMembers.Select(m => m.ProfileGroupFilterId).ToList();
        var used      = GetAssignedNumbers(exceptFilterIds: filterIds);
        int next      = NextUnused(GetParentStartNum(parent.OutputName), used);

        foreach (var member in includedMembers)
        {
            var filterId = member.ProfileGroupFilterId;
            if (!_channelCache.ContainsKey(filterId))
                await LoadChannelsAsync(filterId);

            if (!_channelCache.TryGetValue(filterId, out var channels)) continue;

            var freshSelections = new Dictionary<string, bool>();
            var freshNumbers    = new Dictionary<string, int?>();
            foreach (var ch in channels)
            {
                freshSelections[ch.ProviderChannelId] = true;
                freshNumbers[ch.ProviderChannelId]    = next = NextUnused(next, used);
                next++; // advance baseline
            }
            _channelSelections[filterId] = freshSelections;
            _channelNumbers[filterId]    = freshNumbers;
        }

        RebuildNumberIndex();
        StateHasChanged();

        var clearedNew = false;
        foreach (var member in includedMembers)
            clearedNew |= MarkChannelSelectionsDirty(member.ProfileGroupFilterId);

        if (clearedNew)
            StateHasChanged();

        await DebounceDirtyChannelSelectionSaveAsync();
    }

    private async Task DeselectAllParentChannelsAsync(VirtualParent parent)
    {
        var includedMembers = parent.Members.Where(m => !IsExcluded(m) && IsManualMode(m)).ToList();

        foreach (var member in includedMembers)
        {
            var filterId = member.ProfileGroupFilterId;
            if (_channelCache.TryGetValue(filterId, out var channels))
            {
                _channelSelections[filterId] = channels.ToDictionary(c => c.ProviderChannelId, _ => false);
                _channelNumbers[filterId]    = [];
            }
        }

        RebuildNumberIndex();
        StateHasChanged();

        var clearedNew = false;
        foreach (var member in includedMembers)
            clearedNew |= MarkChannelSelectionsDirty(member.ProfileGroupFilterId);

        if (clearedNew)
            StateHasChanged();

        await DebounceDirtyChannelSelectionSaveAsync();
    }

    private async Task LoadChannelsAsync(string filterId)
    {
        _loadingChannels.Add(filterId);
        StateHasChanged();

        try
        {
            if (_profileId is null)
                return;

            var sel = await ChannelMappingPageService.GetChannelSelectionsAsync(_profileId, filterId, _cts.Token);

            if (sel is not null)
            {
                _channelCache[filterId] = sel.Channels;

                _channelSelections[filterId] = sel.Channels.ToDictionary(
                    c => c.ProviderChannelId,
                    c => c.IsSelected);

                _channelNumbers[filterId] = sel.Channels
                    .Where(c => c.ChannelNumber.HasValue)
                    .ToDictionary(c => c.ProviderChannelId, c => c.ChannelNumber);

                RebuildNumberIndex();
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load channels: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingChannels.Remove(filterId);
            StateHasChanged();
        }
    }

    private async Task SelectAllChannelsAsync(GroupFilterDto filter)
    {
        var filterId = filter.ProfileGroupFilterId;
        if (!_channelCache.ContainsKey(filterId))
            await LoadChannelsAsync(filterId);

        if (!_channelCache.TryGetValue(filterId, out var channels)) return;

        var freshSelections = new Dictionary<string, bool>();
        var freshNumbers    = new Dictionary<string, int?>();
        var used            = GetAssignedNumbers(exceptFilterIds: new[] { filterId });
        int nextCandidate   = filter.AutoNumStart ?? _defaultStartNum;

        foreach (var ch in channels)
        {
            freshSelections[ch.ProviderChannelId] = true;
            var num = NextUnused(nextCandidate, used);
            freshNumbers[ch.ProviderChannelId] = num;
            nextCandidate = num + 1;
        }

        _channelSelections[filterId] = freshSelections;
        _channelNumbers[filterId]    = freshNumbers;

        RebuildNumberIndex();
        StateHasChanged();
        await ScheduleSaveChannelSelectionsAsync(filterId);
    }

    private async Task DeselectAllChannelsAsync(string filterId)
    {
        if (!_channelCache.TryGetValue(filterId, out var channels)) return;

        _channelSelections[filterId] = channels.ToDictionary(c => c.ProviderChannelId, _ => false);
        _channelNumbers[filterId]    = [];

        RebuildNumberIndex();
        StateHasChanged();
        await ScheduleSaveChannelSelectionsAsync(filterId);
    }

    private async Task OnChannelChecked(GroupFilterDto filter, string channelId, bool isChecked)
    {
        var filterId   = filter.ProfileGroupFilterId;
        var selections = _channelSelections.GetValueOrDefault(filterId) ?? [];
        var numbers    = _channelNumbers.GetValueOrDefault(filterId) ?? [];

        selections[channelId] = isChecked;

        if (isChecked && (!numbers.ContainsKey(channelId) || numbers[channelId] is null))
        {
            var used = GetAssignedNumbers(except: (filterId, channelId), exceptFilterIds: new[] { filterId });
            var next = GetNextNumberForGroup(filter, numbers, used);
            numbers[channelId] = next;
            UpdateNumberIndexEntry(filterId, channelId, next);
        }
        else if (!isChecked)
        {
            var oldNumber = numbers.GetValueOrDefault(channelId);
            numbers.Remove(channelId);
            RemoveNumberIndexEntry(oldNumber);
        }

        _channelSelections[filterId] = selections;
        _channelNumbers[filterId]    = numbers;

        StateHasChanged();
        await ScheduleSaveChannelSelectionsAsync(filterId);
    }

    private async Task OnChannelNumberChanged(string filterId, string channelId, int? value)
    {
        var numbers = _channelNumbers.GetValueOrDefault(filterId) ?? [];
        var oldNumber = numbers.GetValueOrDefault(channelId);

        if (value.HasValue)
        {
            var used = GetAssignedNumbers(except: (filterId, channelId));
            var unique = used.Contains(value.Value)
                ? NextUnused(value.Value, used)
                : value.Value;
            numbers[channelId] = unique;
            UpdateNumberIndexEntry(filterId, channelId, unique, oldNumber);
        }
        else
        {
            numbers.Remove(channelId);
            RemoveNumberIndexEntry(oldNumber);
        }
        _channelNumbers[filterId] = numbers;

        StateHasChanged();
        await ScheduleSaveChannelSelectionsAsync(filterId);
    }

    private async Task ScheduleSaveChannelSelectionsAsync(string filterId)
    {
        if (MarkChannelSelectionsDirty(filterId))
            StateHasChanged();

        await DebounceDirtyChannelSelectionSaveAsync();
    }

    private bool MarkChannelSelectionsDirty(string filterId)
    {
        var filter = _allFilters.FirstOrDefault(f => f.ProfileGroupFilterId == filterId);
        var clearedNew = filter is not null && filter.IsNew;
        if (clearedNew)
            filter!.IsNew = false;

        _dirtyChannelSelectionFilterIds.Add(filterId);
        return clearedNew;
    }

    private async Task DebounceDirtyChannelSelectionSaveAsync()
    {

        _channelSaveDebounceCts?.Cancel();
        _channelSaveDebounceCts?.Dispose();

        var cts = new CancellationTokenSource();
        _channelSaveDebounceCts = cts;

        try
        {
            await Task.Delay(800, cts.Token);
            await SaveDirtyChannelSelectionsNowAsync();
        }
        catch (OperationCanceledException) { }
    }

    private async Task SaveDirtyChannelSelectionsNowAsync()
    {
        if (_dirtyChannelSelectionFilterIds.Count == 0)
            return;

        var dirtyFilterIds = _dirtyChannelSelectionFilterIds.ToList();
        _dirtyChannelSelectionFilterIds.Clear();

        foreach (var filterId in dirtyFilterIds)
            await SaveChannelSelectionsNowAsync(filterId);

        if (_dirtyChannelSelectionFilterIds.Count > 0)
            await DebounceDirtyChannelSelectionSaveAsync();
    }

    private async Task SaveChannelSelectionsNowAsync(string filterId)
    {
        if (_profileId is null || !_channelCache.TryGetValue(filterId, out var channels)) return;
        var filter = _allFilters.FirstOrDefault(f => f.ProfileGroupFilterId == filterId);
        if (filter is null) return;

        var channelMode = LineupReviewSemantics.NormalizeGroupMode(filter.ChannelMode);
        if (channelMode == LineupReviewSemantics.GroupModeAutoUpdate)
            return;

        var selections = _channelSelections.GetValueOrDefault(filterId) ?? [];
        var numbers    = _channelNumbers.GetValueOrDefault(filterId) ?? [];

        var items = channels
            .Where(c => selections.GetValueOrDefault(c.ProviderChannelId))
            .Select(c => new ChannelSelectionItem
            {
                ProviderChannelId = c.ProviderChannelId,
                ChannelNumber     = numbers.GetValueOrDefault(c.ProviderChannelId),
            })
            .ToList();

        try
        {
            var updated = await ChannelMappingPageService.UpdateChannelSelectionsAsync(
                _profileId,
                filterId,
                new UpdateChannelSelectionsRequest { ChannelMode = channelMode, Channels = items },
                _cts.Token);

            if (!updated)
            {
                Snackbar.Add("Channel save failed.", Severity.Error);
                return;
            }

            filter.IsNew = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving channels: {ex.Message}", Severity.Error);
        }
    }

