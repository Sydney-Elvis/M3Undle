    private async Task OnTrackingPolicyChanged(GroupFilterDto filter, string policy)
    {
        if (_profileId is null)
            return;

        var normalizedPolicy = LineupReviewSemantics.NormalizeTrackingPolicy(policy);
        var currentPolicy = LineupReviewSemantics.NormalizeTrackingPolicy(filter.TrackingPolicy);
        if (string.Equals(currentPolicy, normalizedPolicy, StringComparison.OrdinalIgnoreCase))
            return;

        var req = new UpdateGroupFilterRequest { TrackingPolicy = normalizedPolicy };
        await PatchFilterAsync(filter, req, f => { f.TrackingPolicy = normalizedPolicy; });
    }

    private async Task OnTrackingKeywordsChanged(GroupFilterDto filter, string? keywords)
    {
        if (_profileId is null)
            return;

        var normalizedIncoming = string.IsNullOrWhiteSpace(keywords) ? null : keywords.Trim();
        var normalizedCurrent = string.IsNullOrWhiteSpace(filter.TrackingKeywords) ? null : filter.TrackingKeywords.Trim();
        if (string.Equals(normalizedCurrent, normalizedIncoming, StringComparison.Ordinal))
            return;

        var req = normalizedIncoming is null
            ? new UpdateGroupFilterRequest { ClearTrackingKeywords = true }
            : new UpdateGroupFilterRequest { TrackingKeywords = normalizedIncoming };

        await PatchFilterAsync(filter, req, f => { f.TrackingKeywords = normalizedIncoming; });
    }

    private CancellationTokenSource? _keywordPreviewCts;
    private readonly Dictionary<string, List<string>> _keywordPreviewResults = new(StringComparer.Ordinal);

    private async Task OnTrackingKeywordsChangedWithPreview(GroupFilterDto filter, string? keywords)
    {
        filter.TrackingKeywords = keywords;
        StateHasChanged();

        _keywordPreviewCts?.Cancel();
        _keywordPreviewCts = new CancellationTokenSource();
        var ct = _keywordPreviewCts.Token;

        var terms = LineupReviewSemantics.ParseTrackingKeywords(keywords);
        var filterId = filter.ProfileGroupFilterId;

        if (terms.Count == 0)
        {
            _keywordPreviewResults.Remove(filterId);
            StateHasChanged();
            await OnTrackingKeywordsChanged(filter, keywords);
            return;
        }

        try
        {
            await Task.Delay(400, ct);
        }
        catch (OperationCanceledException) { return; }

        if (_channelCache.TryGetValue(filterId, out var channels) && channels.Count > 0)
        {
            var matched = channels
                .Where(ch => LineupReviewSemantics.MatchesTrackingKeywords(keywords, ch.DisplayName, ch.GroupTitle, ch.EventContentKey))
                .Select(ch => ch.DisplayName)
                .ToList();
            _keywordPreviewResults[filterId] = matched;
        }
        else
        {
            _keywordPreviewResults.Remove(filterId);
        }

        StateHasChanged();
        await OnTrackingKeywordsChanged(filter, keywords);
    }

    private string GetKeywordHelperText(GroupFilterDto filter)
    {
        var terms = LineupReviewSemantics.ParseTrackingKeywords(filter.TrackingKeywords);
        if (terms.Count == 0)
            return string.Empty;

        var filterId = filter.ProfileGroupFilterId;
        if (_keywordPreviewResults.TryGetValue(filterId, out var matches))
            return $"{terms.Count} term(s) → {matches.Count} match(es)";
        return $"{terms.Count} term(s)";
    }

    private async Task OnTrackNewChannelsChanged(GroupFilterDto filter, bool value)
    {
        if (_profileId is null || value == filter.TrackNewChannels) return;
        var req = new UpdateGroupFilterRequest { TrackNewChannels = value };
        await PatchFilterAsync(filter, req, f => { f.TrackNewChannels = value; });
    }

    private async Task PatchFilterAsync(GroupFilterDto filter, UpdateGroupFilterRequest req, Action<GroupFilterDto> mutate)
    {
        if (_profileId is null) return;
        try
        {
            var updated = await ChannelMappingPageService.UpdateGroupFilterAsync(
                _profileId,
                filter.ProfileGroupFilterId,
                req,
                _cts.Token);
            if (!updated)
            {
                Snackbar.Add("Save failed.", Severity.Error);
                return;
            }
            mutate(filter);
            if (ShouldClearNewOnInteraction(req))
                filter.IsNew = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

