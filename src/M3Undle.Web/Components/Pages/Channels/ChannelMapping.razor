    private async Task OnCgKeywordsChangedAsync(CustomGroupDto cg, string? value)
    {
        if (_profileId is null) return;
        UpdateCustomGroupRequest req;
        if (string.IsNullOrWhiteSpace(value))
            req = new UpdateCustomGroupRequest { ClearTrackingKeywords = true };
        else
            req = new UpdateCustomGroupRequest { TrackingKeywords = value };
        var ok = await CustomGroupService.UpdateAsync(_profileId, cg.CustomGroupId, req, _cts.Token);
        if (ok)
        {
            var idx = _customGroups.FindIndex(g => g.CustomGroupId == cg.CustomGroupId);
            if (idx >= 0)
                _customGroups[idx] = _customGroups[idx] with { TrackingKeywords = string.IsNullOrWhiteSpace(value) ? null : value };
        }
    }

    private async Task OnCgTrackNewChangedAsync(CustomGroupDto cg, bool value)
    {
        if (_profileId is null || value == cg.TrackNewChannels) return;
        var req = new UpdateCustomGroupRequest { TrackNewChannels = value };
        var ok = await CustomGroupService.UpdateAsync(_profileId, cg.CustomGroupId, req, _cts.Token);
        if (ok)
        {
            var idx = _customGroups.FindIndex(g => g.CustomGroupId == cg.CustomGroupId);
            if (idx >= 0)
                _customGroups[idx] = _customGroups[idx] with { TrackNewChannels = value };
        }
        StateHasChanged();
    }

    private async Task DeleteCustomGroupAsync(CustomGroupDto cg)
    {
        if (_profileId is null) return;
        _cgBusy.Add(cg.CustomGroupId);
        StateHasChanged();
        try
        {
            var ok = await CustomGroupService.DeleteAsync(_profileId, cg.CustomGroupId, _cts.Token);
            if (ok)
            {
                _customGroups.RemoveAll(g => g.CustomGroupId == cg.CustomGroupId);
                _cgExpanded.Remove(cg.CustomGroupId);
                _cgLinksExpanded.Remove(cg.CustomGroupId);
                _cgChannelCache.Remove(cg.CustomGroupId);
                _cgLinksCache.Remove(cg.CustomGroupId);
                _displayOrderIds.RemoveAll(id => string.Equals(id, $"cg:{cg.CustomGroupId}", StringComparison.OrdinalIgnoreCase));
                Snackbar.Add($"Custom group \"{cg.Name}\" deleted.", Severity.Success);
            }
        }
        finally
        {
            _cgBusy.Remove(cg.CustomGroupId);
            StateHasChanged();
        }
    }

    private async Task SetCgChannelStateAsync(CustomGroupDto cg, CustomGroupChannelDto ch, string state)
    {
        if (_profileId is null) return;
        var req = new UpdateCustomGroupChannelRequest { State = state };
        var ok = await CustomGroupService.UpdateChannelAsync(_profileId, cg.CustomGroupId, ch.ProviderChannelId, req, _cts.Token);
        if (ok && _cgChannelCache.TryGetValue(cg.CustomGroupId, out var list))
        {
            var idx = list.FindIndex(c => c.ProviderChannelId == ch.ProviderChannelId);
            if (idx >= 0)
                list[idx] = list[idx] with { State = state };

            // Update counts on dto
            var gIdx = _customGroups.FindIndex(g => g.CustomGroupId == cg.CustomGroupId);
            if (gIdx >= 0)
            {
                var included = list.Count(c => string.Equals(c.State, "included", StringComparison.OrdinalIgnoreCase));
                _customGroups[gIdx] = _customGroups[gIdx] with { SelectedChannelCount = included };
            }
        }
        StateHasChanged();
    }

    private async Task RemoveCgChannelAsync(CustomGroupDto cg, CustomGroupChannelDto ch)
    {
        if (_profileId is null) return;
        var ok = await CustomGroupService.RemoveChannelAsync(_profileId, cg.CustomGroupId, ch.ProviderChannelId, _cts.Token);
        if (ok && _cgChannelCache.TryGetValue(cg.CustomGroupId, out var list))
        {
            list.RemoveAll(c => c.ProviderChannelId == ch.ProviderChannelId);
            var gIdx = _customGroups.FindIndex(g => g.CustomGroupId == cg.CustomGroupId);
            if (gIdx >= 0)
            {
                var included = list.Count(c => string.Equals(c.State, "included", StringComparison.OrdinalIgnoreCase));
                _customGroups[gIdx] = _customGroups[gIdx] with
                {
                    ChannelCount = list.Count,
                    SelectedChannelCount = included,
                };
            }
        }
        StateHasChanged();
    }

    private async Task RemoveCgProviderLinkAsync(CustomGroupDto cg, string providerGroupId)
    {
        if (_profileId is null) return;
        var ok = await CustomGroupService.RemoveProviderLinkAsync(_profileId, cg.CustomGroupId, providerGroupId, _cts.Token);
        if (ok && _cgLinksCache.TryGetValue(cg.CustomGroupId, out var list))
        {
            list.RemoveAll(l => l.ProviderGroupId == providerGroupId);
            var gIdx = _customGroups.FindIndex(g => g.CustomGroupId == cg.CustomGroupId);
            if (gIdx >= 0)
                _customGroups[gIdx] = _customGroups[gIdx] with { ProviderLinkCount = list.Count };
        }
        StateHasChanged();
    }

    // -------------------------------------------------------------------------
    // Settings drawer
    // -------------------------------------------------------------------------

    private void OpenSettingsDrawer(string targetId, SettingsTargetKind kind)
    {
        if (_settingsDrawerOpen && _drawerTargetId == targetId && _drawerTargetKind == kind)
        {
            CloseSettingsDrawer();
            return;
        }
        _drawerTargetId = targetId;
        _drawerTargetKind = kind;
        _settingsDrawerOpen = true;
        StateHasChanged();
    }

    private void CloseSettingsDrawer()
    {
        _settingsDrawerOpen = false;
        _drawerTargetId = null;
        StateHasChanged();
    }

    private async Task SetParentTrackNewChannelsAsync(string outputName, bool value)
    {
        var members = _allFilters.Where(f => string.Equals(f.OutputName, outputName, StringComparison.OrdinalIgnoreCase)).ToList();
        await Task.WhenAll(members.Select(m => OnTrackNewChannelsChanged(m, value)));
    }

    private async Task SetParentTrackingKeywordsAsync(string outputName, string? keywords)
    {
        var members = _allFilters.Where(f => string.Equals(f.OutputName, outputName, StringComparison.OrdinalIgnoreCase)).ToList();
        foreach (var m in members)
            await OnTrackingKeywordsChanged(m, keywords);
    }

    private static bool IsCgExcluded(CustomGroupDto cg) =>
        string.Equals(cg.Decision, "exclude", StringComparison.OrdinalIgnoreCase);

    private static bool IsCgIncluded(CustomGroupDto cg) =>
        !IsCgExcluded(cg);

    private Color GetSettingsButtonColor(string? trackingPolicy, string? trackingKeywords, string targetId)
    {
        if (_settingsDrawerOpen && _drawerTargetId == targetId)
            return Color.Primary;
        var isAutoMatch = string.Equals(
            LineupReviewSemantics.NormalizeTrackingPolicy(trackingPolicy),
            LineupReviewSemantics.TrackingPolicyAutoAddMatching,
            StringComparison.OrdinalIgnoreCase);
        return isAutoMatch && string.IsNullOrWhiteSpace(trackingKeywords) ? Color.Warning : Color.Default;
    }
}
