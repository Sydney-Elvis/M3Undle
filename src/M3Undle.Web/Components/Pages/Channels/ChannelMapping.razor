    private List<ParentChannelEntry> GetAllParentChannels(VirtualParent parent)
    {
        var result = new List<ParentChannelEntry>();
        foreach (var m in parent.Members)
        {
            if (_channelCache.TryGetValue(m.ProfileGroupFilterId, out var chs))
                foreach (var ch in chs)
                    result.Add(new ParentChannelEntry(m, ch));
        }
        return result;
    }

    private static List<ParentChannelEntry> GetFilteredParentChannels(List<ParentChannelEntry> all, string filterText)
    {
        if (string.IsNullOrWhiteSpace(filterText)) return all;
        return all.Where(x =>
            x.Channel.DisplayName.Contains(filterText, StringComparison.OrdinalIgnoreCase) ||
            x.Filter.ProviderGroupRawName.Contains(filterText, StringComparison.OrdinalIgnoreCase) ||
            x.Filter.ProviderName.Contains(filterText, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private List<ParentChannelEntry> GetFilteredParentChannelsForDisplay(
        VirtualParent parent,
        List<ParentChannelEntry> all,
        bool globalActive,
        string filterText,
        HashSet<string> hiddenMembers,
        bool showSelectedOnly = false)
    {
        IEnumerable<ParentChannelEntry> result;

        if (globalActive)
        {
            result = all.Where(e =>
                _globalChannelSearchHitIds.TryGetValue(e.Filter.ProfileGroupFilterId, out var hitIds) &&
                hitIds.Contains(e.Channel.ProviderChannelId));
        }
        else
        {
            result = GetFilteredParentChannels(all, filterText);
        }

        if (showSelectedOnly)
            result = result.Where(e =>
                _channelSelections.TryGetValue(e.Filter.ProfileGroupFilterId, out var sel) &&
                sel.TryGetValue(e.Channel.ProviderChannelId, out var isSelected) &&
                isSelected);

        if (hiddenMembers.Count > 0)
            result = result.Where(e => !hiddenMembers.Contains(e.Filter.ProfileGroupFilterId));

        return result.ToList();
    }

    private List<ProviderChannelSelectDto> GetFilteredGroupChannels(
        string filterId,
        List<ProviderChannelSelectDto> channels,
        bool globalActive,
        string filterText)
    {
        if (globalActive)
        {
            if (!_globalChannelSearchHitIds.TryGetValue(filterId, out var hitIds))
                return [];
            return channels.Where(c => hitIds.Contains(c.ProviderChannelId)).ToList();
        }

        if (string.IsNullOrWhiteSpace(filterText))
            return channels;

        return channels.Where(c => c.DisplayName.Contains(filterText, StringComparison.OrdinalIgnoreCase)).ToList();
    }

